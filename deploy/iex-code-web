#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly CONFIG_FILE=/etc/iex-code-web/install.conf

die() {
  printf 'iex-code-web: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "run this command as root"
}

load_config() {
  [[ -r "$CONFIG_FILE" ]] || die "missing $CONFIG_FILE; run the installer first"
  # The installer creates this root-owned file from validated scalar values.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  : "${IEX_CODE_SOURCE_DIR:?missing source directory}"
  : "${IEX_CODE_APP_ENV_FILE:?missing app environment file}"
  : "${IEX_CODE_STATE_DIR:?missing state directory}"
  : "${IEX_CODE_WORKSPACE_DIR:?missing workspace directory}"
  : "${IEX_CODE_PUBLIC_PORT:?missing public port}"
  IEX_CODE_PUBLIC_IP=${IEX_CODE_PUBLIC_IP:-}
  IEX_CODE_PUBLIC_BIND=${IEX_CODE_PUBLIC_BIND:-0.0.0.0}
  IEX_CODE_PUBLIC_HOST=${IEX_CODE_PUBLIC_HOST:-$IEX_CODE_PUBLIC_IP}
  IEX_CODE_CADDYFILE=${IEX_CODE_CADDYFILE:-$IEX_CODE_SOURCE_DIR/deploy/Caddyfile.ip}
  IEX_CODE_BEHIND_PROXY=${IEX_CODE_BEHIND_PROXY:-false}
  IEX_CODE_BACKUP_DIR=${IEX_CODE_BACKUP_DIR:-/var/backups/iex-code-web}
  IEX_CODE_APP_UID=${IEX_CODE_APP_UID:-10001}
  IEX_CODE_APP_GID=${IEX_CODE_APP_GID:-10001}
  IEX_CODE_MEMORY_LIMIT_MIB=${IEX_CODE_MEMORY_LIMIT_MIB:-2048}
  IEX_CODE_MEMORY_RESERVATION_MIB=${IEX_CODE_MEMORY_RESERVATION_MIB:-512}
  IEX_CODE_NOFILE_LIMIT=${IEX_CODE_NOFILE_LIMIT:-65536}
  IEX_CODE_PIDS_LIMIT=${IEX_CODE_PIDS_LIMIT:-1024}
  IEX_CODE_RESOURCE_PROFILE=${IEX_CODE_RESOURCE_PROFILE:-}
  local inferred_profile
  inferred_profile=$(infer_resource_profile)
  if [[ -z $IEX_CODE_RESOURCE_PROFILE ]]; then
    IEX_CODE_RESOURCE_PROFILE=$inferred_profile
  elif [[ $IEX_CODE_RESOURCE_PROFILE != custom && \
          $IEX_CODE_RESOURCE_PROFILE != "$inferred_profile" ]]; then
    IEX_CODE_RESOURCE_PROFILE=custom
  fi
}

infer_resource_profile() {
  if [[ $IEX_CODE_MEMORY_RESERVATION_MIB == 512 && $IEX_CODE_NOFILE_LIMIT == 65536 && \
        $IEX_CODE_PIDS_LIMIT == 1024 ]]; then
    case "$IEX_CODE_MEMORY_LIMIT_MIB" in
      1024) printf 'compact\n'; return ;;
      2048) printf 'balanced\n'; return ;;
      2560) printf 'throughput\n'; return ;;
    esac
  fi
  printf 'custom\n'
}

detect_compose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
  else
    die "Docker Compose is not installed"
  fi
}

compose() {
  local -a topology=()
  if [[ $IEX_CODE_BEHIND_PROXY == true ]]; then
    topology=(-f "$IEX_CODE_SOURCE_DIR/deploy/compose.behind-proxy.yaml")
  elif [[ -n ${IEX_CODE_PUBLIC_DOMAIN:-} ]]; then
    topology=(-f "$IEX_CODE_SOURCE_DIR/deploy/compose.caddy-domain.yaml" --profile caddy)
  else
    topology=(-f "$IEX_CODE_SOURCE_DIR/deploy/compose.caddy-ip.yaml" --profile caddy)
  fi
  IEX_CODE_APP_ENV_FILE="$IEX_CODE_APP_ENV_FILE" \
  IEX_CODE_STATE_DIR="$IEX_CODE_STATE_DIR" \
  IEX_CODE_WORKSPACE_DIR="$IEX_CODE_WORKSPACE_DIR" \
  IEX_CODE_PUBLIC_IP="$IEX_CODE_PUBLIC_IP" \
  IEX_CODE_PUBLIC_HOST="$IEX_CODE_PUBLIC_HOST" \
  IEX_CODE_CADDYFILE="$IEX_CODE_CADDYFILE" \
  IEX_CODE_PUBLIC_BIND="$IEX_CODE_PUBLIC_BIND" \
  IEX_CODE_PUBLIC_PORT="$IEX_CODE_PUBLIC_PORT" \
  IEX_CODE_APP_UID="$IEX_CODE_APP_UID" \
  IEX_CODE_APP_GID="$IEX_CODE_APP_GID" \
  IEX_CODE_RESOURCE_PROFILE="$IEX_CODE_RESOURCE_PROFILE" \
  IEX_CODE_MEMORY_LIMIT_MIB="$IEX_CODE_MEMORY_LIMIT_MIB" \
  IEX_CODE_MEMORY_RESERVATION_MIB="$IEX_CODE_MEMORY_RESERVATION_MIB" \
  IEX_CODE_NOFILE_LIMIT="$IEX_CODE_NOFILE_LIMIT" \
  IEX_CODE_PIDS_LIMIT="$IEX_CODE_PIDS_LIMIT" \
    "${COMPOSE[@]}" --project-directory "$IEX_CODE_SOURCE_DIR" \
      -f "$IEX_CODE_SOURCE_DIR/compose.yaml" "${topology[@]}" "$@"
}

running_app() {
  [[ -n "$(compose ps -q app 2>/dev/null || true)" ]]
}

deployment_status() {
  compose ps || return $?

  if running_app; then
    local runtime_output
    if runtime_output=$(compose exec -T app /opt/iex-code/bin/iex_code rpc \
        'IexCode.Observability.RuntimeStatus.print_cli()' 2>/dev/null); then
      [[ -z $runtime_output ]] || printf '%s\n' "$runtime_output"
    else
      printf '%s\n' \
        'iex-code-web: warning: runtime status unavailable; service status is shown above' >&2
    fi
  fi
}

backup() (
  local requested_destination=${1:-}
  mkdir -p -m 0700 "$IEX_CODE_BACKUP_DIR"
  chmod 0700 "$IEX_CODE_BACKUP_DIR"

  local timestamp archive container_staging backup_partial=""
  local backup_staging backup_app_was_running=false
  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  backup_staging=$(mktemp -d "$IEX_CODE_STATE_DIR/.backup-${timestamp}.XXXXXX")

  finish_backup() {
    local status=$?
    local cleanup_failed=false
    rm -rf -- "$1" || cleanup_failed=true
    [[ -z $3 ]] || rm -f -- "$3" || cleanup_failed=true

    if [[ $2 == true ]] && ! compose start app >/dev/null; then
      printf '%s\n' 'iex-code-web: failed to restart the application after backup' >&2
      ((status != 0)) || status=1
    fi
    if [[ $cleanup_failed == true ]]; then
      printf '%s\n' 'iex-code-web: failed to remove temporary backup data' >&2
      ((status != 0)) || status=1
    fi

    trap - EXIT
    exit "$status"
  }

  set_backup_trap() {
    local cleanup
    printf -v cleanup 'finish_backup %q %q %q' \
      "$backup_staging" "$backup_app_was_running" "$backup_partial"
    trap "$cleanup" EXIT
  }

  set_backup_trap
  if running_app; then
    backup_app_was_running=true
    set_backup_trap
    # File-backed research and command artifacts must be frozen at the same
    # boundary as their SQLite metadata. A short app-only stop avoids producing
    # an archive with rows that reference half-written or concurrently expired
    # files; the proxy remains up and reports temporary unavailability.
    compose stop app >/dev/null
  fi
  archive="$IEX_CODE_BACKUP_DIR/iex-code-web-${timestamp}.tar.gz"
  if [[ -n "$requested_destination" ]]; then
    if [[ -d "$requested_destination" ]]; then
      archive="$requested_destination/iex-code-web-${timestamp}.tar.gz"
    else
      archive=$requested_destination
    fi
    mkdir -p -m 0700 "$(dirname -- "$archive")"
  fi
  container_staging="/var/lib/iex-code/$(basename -- "$backup_staging")"
  chown "$IEX_CODE_APP_UID:$IEX_CODE_APP_GID" "$backup_staging"
  chmod 0700 "$backup_staging"

  if [[ -e "$IEX_CODE_STATE_DIR/iex_code.db" || -L "$IEX_CODE_STATE_DIR/iex_code.db" ]] && \
      [[ ! -f "$IEX_CODE_STATE_DIR/iex_code.db" || -L "$IEX_CODE_STATE_DIR/iex_code.db" ]]; then
    die "database path is not a regular file"
  fi
  if [[ -f "$IEX_CODE_STATE_DIR/iex_code.db" ]]; then
    compose run --rm --no-deps app sqlite3 /var/lib/iex-code/iex_code.db \
      ".backup '$container_staging/iex_code.db'" >/dev/null
  fi

  # Research and output writers create regular directory trees without
  # symbolic links. Refuse unexpected roots or links rather than omitting data
  # referenced by the database or following a link outside persistent state.
  local tree
  for tree in research outputs; do
    if [[ -e "$IEX_CODE_STATE_DIR/$tree" || -L "$IEX_CODE_STATE_DIR/$tree" ]] && \
        [[ ! -d "$IEX_CODE_STATE_DIR/$tree" || -L "$IEX_CODE_STATE_DIR/$tree" ]]; then
      die "$tree data root is not a regular directory"
    fi
    if [[ -d "$IEX_CODE_STATE_DIR/$tree" ]] && \
        find "$IEX_CODE_STATE_DIR/$tree" -type l -print -quit | grep -q .; then
      die "$tree data contains a symbolic link and cannot be backed up safely"
    fi
  done

  local -a members=()
  [[ -f "$backup_staging/iex_code.db" ]] && members+=(iex_code.db)
  [[ -d "$IEX_CODE_STATE_DIR/research" ]] && members+=(research)
  [[ -d "$IEX_CODE_STATE_DIR/outputs" ]] && members+=(outputs)
  ((${#members[@]} > 0)) || die "there is no database, research data, or output data to back up"

  local temp_archive="$archive.partial"
  backup_partial=$temp_archive
  set_backup_trap
  rm -f -- "$temp_archive"
  python3 - "$temp_archive" "$backup_staging" "$IEX_CODE_STATE_DIR" <<'PY'
import pathlib
import sys
import tarfile

archive, staging, state = sys.argv[1:]
staging = pathlib.Path(staging)
state = pathlib.Path(state)

def safe_member(member):
    if member.islnk():
        # Hard links are an internal tar optimization. The source tree is
        # already link-free, so archive a second regular-file payload instead
        # of emitting a link record that points at another member.
        member.type = tarfile.REGTYPE
        member.linkname = ""
    if member.issym() or not (member.isfile() or member.isdir()):
        raise ValueError("unexpected file type in manager-owned data")
    return member


with tarfile.open(archive, "w:gz", dereference=False) as bundle:
    if (staging / "iex_code.db").is_file():
        bundle.add(
            staging / "iex_code.db",
            arcname="iex_code.db",
            recursive=False,
            filter=safe_member,
        )
    for name in ("research", "outputs"):
        root = state / name
        if root.is_dir() and not root.is_symlink():
            bundle.add(root, arcname=name, recursive=True, filter=safe_member)
PY
  mv -f -- "$temp_archive" "$archive"
  sha256sum -- "$archive" >"$archive.sha256"
  chmod 0600 "$archive" "$archive.sha256"
  printf '%s\n' "$archive"
)

extract_archive() {
  local archive=$1 destination=$2
  # Validate and extract through one tar reader instead of validating once and
  # then handing the path to a second extractor. Only regular files and
  # directories below the three manager-owned roots are accepted; links,
  # devices, duplicate/colliding paths, and traversal spellings are rejected.
  python3 - "$archive" "$destination" <<'PY'
import os
import pathlib
import shutil
import sys
import tarfile
import tempfile

archive = sys.argv[1]
destination = pathlib.Path(sys.argv[2])
allowed_trees = {"research", "outputs"}
seen = {}
members = []
max_members = 500_000
max_path_bytes = 4096

try:
    with tarfile.open(archive, "r:gz") as bundle:
        for member in bundle.getmembers():
            path = pathlib.PurePosixPath(member.name)
            parts = path.parts
            canonical_name = member.name[:-1] if member.isdir() and member.name.endswith("/") else member.name

            if (
                not parts
                or path.is_absolute()
                or len(member.name.encode("utf-8")) > max_path_bytes
                or any(part in {"", ".", ".."} for part in parts)
                or pathlib.PurePosixPath(*parts).as_posix() != canonical_name
            ):
                raise ValueError("non-canonical archive path")

            allowed = parts == ("iex_code.db",) or parts[0] in allowed_trees
            if not allowed or not (member.isfile() or member.isdir() or member.islnk()):
                raise ValueError("unsafe archive member")
            if parts == ("iex_code.db",) and not member.isfile():
                raise ValueError("database member is not a regular file")
            if len(parts) == 1 and parts[0] in allowed_trees and not member.isdir():
                raise ValueError("artifact root is not a directory")
            if parts in seen:
                raise ValueError("duplicate archive member")

            source_member = member
            if member.islnk():
                # Accept hard-link records only for compatibility with older
                # manager archives. New backups store independent regular
                # files, which keeps restore streaming and order-independent.
                link = pathlib.PurePosixPath(member.linkname)
                link_parts = link.parts
                if (
                    not link_parts
                    or link.is_absolute()
                    or any(part in {"", ".", ".."} for part in link_parts)
                    or pathlib.PurePosixPath(*link_parts).as_posix() != member.linkname
                    or link_parts[0] != parts[0]
                ):
                    raise ValueError("unsafe hard-link target")
                prior = seen.get(link_parts)
                if prior is None or prior[0] != "file":
                    raise ValueError("hard-link target is not a prior regular file")
                source_member = prior[1]

            kind = "directory" if member.isdir() else "file"
            seen[parts] = (kind, source_member)
            members.append((parts, member.isdir(), source_member))
            if len(members) > max_members:
                raise ValueError("archive contains too many members")

        if not members:
            raise ValueError("empty archive")

        for parts in seen:
            for length in range(1, len(parts)):
                parent = seen.get(parts[:length])
                if parent is not None and parent[0] != "directory":
                    raise ValueError("archive path collision")

        declared_size = sum(source.size for _parts, is_directory, source in members if not is_directory)
        if any(source.size < 0 for _parts, is_directory, source in members if not is_directory):
            raise ValueError("negative archive member size")
        if declared_size > shutil.disk_usage(destination.parent).free:
            raise ValueError("archive does not fit on the state filesystem")

        destination.mkdir(mode=0o700, parents=True, exist_ok=False)

        # Directories may be implicit in a tar stream, so create every parent
        # ourselves with private permissions. File contents are copied without
        # restoring archive ownership, modes, timestamps, or extended attrs.
        for parts, is_directory, source_member in members:
            target = destination.joinpath(*parts)
            if is_directory:
                target.mkdir(mode=0o700, parents=True, exist_ok=True)
                os.chmod(target, 0o700)
                continue

            target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            source = bundle.extractfile(source_member)
            if source is None:
                raise ValueError("archive file has no contents")
            expected_size = source_member.size
            fd, temporary = tempfile.mkstemp(prefix=".restore-", dir=target.parent)
            try:
                with os.fdopen(fd, "wb") as output:
                    remaining = expected_size
                    while remaining:
                        chunk = source.read(min(remaining, 1024 * 1024))
                        if not chunk:
                            raise ValueError("archive file is shorter than declared")
                        output.write(chunk)
                        remaining -= len(chunk)
                    if source.read(1):
                        raise ValueError("archive file is longer than declared")
                    output.flush()
                    os.fsync(output.fileno())
                os.chmod(temporary, 0o600)
                os.replace(temporary, target)
            finally:
                source.close()
                try:
                    os.unlink(temporary)
                except FileNotFoundError:
                    pass
except (OSError, tarfile.TarError, ValueError):
    raise SystemExit(1)
PY
}

restore() (
  local archive=${1:-}
  [[ -n "$archive" && -f "$archive" ]] || die "restore requires an existing .tar.gz backup"
  local restore_app_was_running=false restore_app_stopped=false
  local restore_replacement_started=false restore_replacement_committed=false
  local restore_staging restore_incoming restore_rollback
  local -a restore_moved_names=() restore_installed_names=()
  restore_staging=$(mktemp -d "$IEX_CODE_STATE_DIR/.restore.XXXXXX")
  restore_incoming="$restore_staging/incoming"
  restore_rollback="$restore_staging/rollback"

  rollback_restore() {
    local name rollback_failed=false
    for name in "${restore_installed_names[@]}"; do
      rm -rf -- "$IEX_CODE_STATE_DIR/$name" || rollback_failed=true
    done
    for name in "${restore_moved_names[@]}"; do
      mv -- "$restore_rollback/$name" "$IEX_CODE_STATE_DIR/$name" || rollback_failed=true
    done
    [[ $rollback_failed == false ]]
  }

  finish_restore() {
    local status=$?

    if [[ $restore_replacement_started == true && \
          $restore_replacement_committed == false ]] && \
        ! rollback_restore; then
      printf '%s\n' 'iex-code-web: failed to roll back the interrupted restore' >&2
      ((status != 0)) || status=1
    fi

    if [[ $restore_app_was_running == true && $restore_app_stopped == true ]] && \
        ! compose start app >/dev/null; then
      printf '%s\n' 'iex-code-web: failed to restart the application after restore' >&2
      ((status != 0)) || status=1
    fi

    rm -rf -- "$restore_staging"
    trap - EXIT
    exit "$status"
  }

  trap finish_restore EXIT
  extract_archive "$archive" "$restore_incoming" || \
    die "backup contains an unsafe or unexpected path"

  if [[ -f "$restore_incoming/iex_code.db" ]]; then
    chown "$IEX_CODE_APP_UID:$IEX_CODE_APP_GID" "$restore_incoming/iex_code.db"
    chmod 0600 "$restore_incoming/iex_code.db"
  fi
  local tree
  for tree in research outputs; do
    if [[ -d "$restore_incoming/$tree" ]]; then
      chown -R "$IEX_CODE_APP_UID:$IEX_CODE_APP_GID" "$restore_incoming/$tree"
      find "$restore_incoming/$tree" -type d -exec chmod 0700 {} +
      find "$restore_incoming/$tree" -type f -exec chmod 0600 {} +
    fi
  done

  if running_app; then
    restore_app_was_running=true
    restore_app_stopped=true
    compose stop app >/dev/null
  fi

  # Take the safety copy after freezing the writer. If it fails, the EXIT trap
  # starts an originally running application without touching current state.
  if [[ -f "$IEX_CODE_STATE_DIR/iex_code.db" || -d "$IEX_CODE_STATE_DIR/research" || \
        -d "$IEX_CODE_STATE_DIR/outputs" ]]; then
    printf 'Creating a safety backup before restore...\n' >&2
    backup >/dev/null
  fi

  mkdir -m 0700 "$restore_rollback"
  restore_replacement_started=true
  local name
  for name in iex_code.db iex_code.db-wal iex_code.db-shm research outputs; do
    if [[ -e "$IEX_CODE_STATE_DIR/$name" || -L "$IEX_CODE_STATE_DIR/$name" ]]; then
      mv -- "$IEX_CODE_STATE_DIR/$name" "$restore_rollback/$name"
      restore_moved_names+=("$name")
    fi
  done

  if [[ -f "$restore_incoming/iex_code.db" ]]; then
    mv -- "$restore_incoming/iex_code.db" "$IEX_CODE_STATE_DIR/iex_code.db"
    restore_installed_names+=(iex_code.db)
  fi
  if [[ -d "$restore_incoming/research" ]]; then
    mv -- "$restore_incoming/research" "$IEX_CODE_STATE_DIR/research"
    restore_installed_names+=(research)
  fi
  if [[ -d "$restore_incoming/outputs" ]]; then
    mv -- "$restore_incoming/outputs" "$IEX_CODE_STATE_DIR/outputs"
    restore_installed_names+=(outputs)
  fi
  restore_replacement_committed=true

  if [[ $restore_app_was_running == true ]]; then
    compose start app >/dev/null
    restore_app_stopped=false
  fi
  printf 'Restore complete. Use `iex-code-web status` to check readiness.\n'
)

usage() {
  cat <<'EOF'
Usage: iex-code-web COMMAND [OPTIONS]

Commands:
  start                  Start the deployment
  stop                   Stop the deployment without removing it
  status                 Show service status
  logs [SERVICE]         Follow logs (app or proxy; all services by default)
  restart                Restart the deployment
  update [OPTIONS]       Back up, update source, rebuild, and restart
  backup [DEST]          Create a backup, optionally at DEST or in DEST directory
  restore FILE.tar.gz    Restore a backup after taking a safety backup
  reset-token            Rotate the one-time admin token and revoke sessions
  token                  Alias for reset-token
  config                 Print non-secret deployment configuration
  uninstall [--purge]    Remove services; preserve data unless --purge is explicit
EOF
}

main() {
  require_root
  load_config
  detect_compose

  local command=${1:-}
  shift || true
  case "$command" in
    start) compose up -d ;;
    stop) compose stop ;;
    status) deployment_status ;;
    logs)
      if (($#)); then compose logs --tail=200 -f "$1"; else compose logs --tail=200 -f; fi
      ;;
    restart) compose restart ;;
    update) exec "$IEX_CODE_SOURCE_DIR/install.sh" --update-only "$@" ;;
    backup) backup "${1:-}" ;;
    restore) restore "${1:-}" ;;
    token|reset-token) exec "$IEX_CODE_SOURCE_DIR/install.sh" --update-only --rotate-token ;;
    config)
      if [[ $IEX_CODE_BEHIND_PROXY == true || -n ${IEX_CODE_PUBLIC_DOMAIN:-} ]]; then
        printf 'URL=https://%s\n' "$IEX_CODE_PUBLIC_HOST"
      else
        printf 'URL=https://%s:%s\n' "$IEX_CODE_PUBLIC_HOST" "$IEX_CODE_PUBLIC_PORT"
      fi
      printf 'SOURCE_DIR=%s\nSTATE_DIR=%s\nWORKSPACE_DIR=%s\nBACKUP_DIR=%s\n' \
        "$IEX_CODE_SOURCE_DIR" "$IEX_CODE_STATE_DIR" "$IEX_CODE_WORKSPACE_DIR" \
        "$IEX_CODE_BACKUP_DIR"
      printf 'RESOURCE_PROFILE=%s\nMEMORY_LIMIT_MIB=%s\nMEMORY_RESERVATION_MIB=%s\nNOFILE_LIMIT=%s\nPIDS_LIMIT=%s\n' \
        "$IEX_CODE_RESOURCE_PROFILE" \
        "$IEX_CODE_MEMORY_LIMIT_MIB" "$IEX_CODE_MEMORY_RESERVATION_MIB" \
        "$IEX_CODE_NOFILE_LIMIT" "$IEX_CODE_PIDS_LIMIT"
      ;;
    uninstall)
      if [[ ${1:-} == --purge ]]; then
        compose down --remove-orphans --volumes
      else
        compose down --remove-orphans
      fi
      rm -rf -- "$IEX_CODE_SOURCE_DIR"
      rm -f -- /usr/local/bin/iex-code-web
      if [[ ${1:-} == --purge ]]; then
        rm -rf -- "$IEX_CODE_STATE_DIR" "$IEX_CODE_WORKSPACE_DIR" \
          "$IEX_CODE_BACKUP_DIR" /etc/iex-code-web
        printf 'Services, configuration, workspaces, backups, and state were purged.\n'
      else
        printf 'Services removed. State, workspaces, backups, and configuration were preserved.\n'
      fi
      ;;
    help|-h|--help|'') usage ;;
    *) die "unknown command: $command" ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
