<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main
    id="settings-page"
    class="settings-page min-h-dvh overflow-x-hidden bg-[#0a0d12] text-gray-100"
  >
    <header class="border-b border-[#252c35] bg-[#0d1117]">
      <div class="mx-auto flex max-w-[90rem] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <div class="flex items-center justify-between gap-4">
          <.link
            id="settings-return-workspace"
            navigate={@return_path}
            data-settings-navigation
            data-unsaved-confirm={
              @settings_status in [:dirty, :error] &&
                "Discard your unsaved settings and return to the workspace?"
            }
            class="inline-flex min-h-11 w-fit items-center gap-2 rounded-lg px-2 text-sm font-medium text-gray-400 transition-colors hover:bg-[#161b22] hover:text-white active:translate-y-px focus-visible:ring-2 focus-visible:ring-[#ff8a68]/70"
          >
            <.icon name="hero-arrow-left" class="h-4 w-4" /> Return to workspace
          </.link>
          <Layouts.logout_button id="settings-logout-form" />
        </div>

        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#ff8a68]">
              Local application control
            </p>
            <h1 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-white sm:text-4xl">
              Settings
            </h1>
            <p class="mt-3 max-w-[68ch] text-sm leading-6 text-gray-400">
              These global defaults seed run setup when a workspace loads and apply to newly
              launched work. Existing sessions retain only their session-level provider, model,
              and temperature overrides.
            </p>
          </div>

          <section
            id="settings-scope-summary"
            aria-labelledby="settings-scope-title"
            class="w-full border border-[#303844] bg-[#11161d] p-4 lg:max-w-md"
          >
            <div class="flex items-start gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 bg-[#ff8a68]"></span>
              <div class="min-w-0">
                <h2 id="settings-scope-title" class="text-sm font-semibold text-white">
                  Global defaults
                </h2>
                <p class="mt-1 text-sm leading-5 text-gray-400">
                  Stored in local SQLite and shared by every workspace on this machine.
                </p>
                <div
                  :if={@context_session}
                  id="settings-session-context"
                  class="mt-3 border-t border-[#252c35] pt-3"
                >
                  <p class="font-mono text-[11px] uppercase tracking-wider text-gray-500">
                    Current session context
                  </p>
                  <p class="mt-1 truncate text-sm font-medium text-gray-200">
                    {@context_session.title}
                  </p>
                  <p class="mt-1 truncate font-mono text-xs text-gray-500">
                    {@context_session.model_provider} · {@context_session.model_name}
                  </p>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </header>

    <div class="settings-mobile-nav border-b border-[#252c35] bg-[#0d1117] lg:hidden">
      <nav
        id="settings-mobile-section-nav"
        aria-label="Settings sections"
        class="flex gap-1 overflow-x-auto px-4 py-2"
      >
        <a
          :for={{id, label} <- settings_sections()}
          href={"##{id}"}
          class="settings-mobile-nav-link"
        >
          {label}
        </a>
      </nav>
    </div>

    <div class="mx-auto grid max-w-[90rem] grid-cols-1 gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:px-8 lg:py-10 xl:gap-12">
      <aside class="hidden lg:block">
        <nav
          id="settings-section-nav"
          aria-label="Settings sections"
          class="settings-section-rail"
        >
          <p class="px-3 pb-2 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-gray-600">
            Sections
          </p>
          <a
            :for={{id, label} <- settings_sections()}
            id={"settings-nav-#{id}"}
            href={"##{id}"}
            class="settings-section-link"
          >
            <span>{label}</span><.icon name="hero-chevron-right" class="h-3.5 w-3.5" />
          </a>
        </nav>
      </aside>

      <div class="min-w-0 max-w-5xl">
        <div
          :if={@invalid_session_context?}
          id="settings-session-context-error"
          role="status"
          class="mb-6 flex items-start gap-3 border border-amber-400/30 bg-amber-400/[0.06] p-4 text-sm text-amber-100"
        >
          <.icon name="hero-information-circle" class="mt-0.5 h-5 w-5 shrink-0" />
          <span>The requested session is unavailable. Showing safe global settings instead.</span>
        </div>

        <div
          :if={@external_update?}
          id="settings-external-update"
          role="alert"
          class="mb-6 flex flex-col gap-3 border border-amber-400/30 bg-amber-400/[0.06] p-4 text-sm text-amber-100 sm:flex-row sm:items-center sm:justify-between"
        >
          <span>Settings changed elsewhere while you were editing. Discard to load the newer version.</span>
          <button
            type="button"
            phx-click="discard_settings"
            class="settings-text-action text-amber-200"
          >
            Load saved version
          </button>
        </div>

        <div
          :if={@settings_status == :error}
          id="settings-error-summary"
          role="alert"
          tabindex="-1"
          class="mb-6 border border-rose-400/35 bg-rose-400/[0.06] p-4"
        >
          <div class="flex items-start gap-3">
            <.icon name="hero-exclamation-triangle" class="mt-0.5 h-5 w-5 shrink-0 text-rose-300" />
            <div>
              <h2 class="text-sm font-semibold text-rose-100">Settings were not saved</h2>
              <p class="mt-1 text-sm leading-5 text-rose-200/80">{@settings_message}</p>
              <p
                :if={form_error_count(@settings_form) > 0}
                class="mt-2 font-mono text-xs text-rose-300"
              >
                {form_error_count(@settings_form)} field {if form_error_count(@settings_form) ==
                                                               1,
                                                             do: "needs",
                                                             else: "fields need"} attention.
              </p>
            </div>
          </div>
        </div>

        <.form
          for={@settings_form}
          id="settings-form"
          phx-change="validate_settings"
          phx-submit="save_settings"
          class="space-y-8 pb-28"
        >
          <input
            id="settings-provider-order"
            type="hidden"
            name="settings[search_provider_order]"
            value={Enum.join(provider_order(@settings_form, @settings), ",")}
          />
          <section
            id="models"
            aria-labelledby="models-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="models-title"
              eyebrow="Models"
              title="Model defaults and credentials"
              description="Choose the API protocol and model inherited by new sessions, then manage its local credentials. The selected provider is authoritative; model identifiers are passed through unchanged. Blank secret fields preserve the saved value."
            />

            <div class="grid gap-4 sm:grid-cols-2">
              <.input
                field={@settings_form[:default_model_provider]}
                id="settings-default-model-provider"
                type="select"
                label="Default API protocol"
                options={["OpenAI or compatible": "openai", Anthropic: "anthropic"]}
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_model]}
                id="settings-default-model"
                type="text"
                label="Default model identifier"
                maxlength="240"
                autocomplete="off"
                class="settings-control font-mono"
                error_class="settings-control-error"
              />
            </div>

            <div class="mt-5 grid gap-4 xl:grid-cols-2">
              <article id="settings-openai-card" class="settings-credential-card">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-semibold text-white">
                      OpenAI / compatible endpoint
                    </h3>
                    <p class="mt-1 text-sm text-gray-400">
                      Used whenever OpenAI or compatible is selected, including proxy-hosted models.
                    </p>
                  </div>
                  <.credential_badge configured={credential_configured?(@settings.openai_api_key)} />
                </div>
                <div class="mt-4 space-y-3">
                  <.input
                    name="settings[openai_api_key]"
                    id="settings-openai-api-key"
                    type="password"
                    value=""
                    label="API key"
                    autocomplete="new-password"
                    placeholder={credential_placeholder(@settings.openai_api_key)}
                    class="settings-control font-mono"
                  />
                  <.input
                    field={@settings_form[:openai_base_url]}
                    id="settings-openai-base-url"
                    type="url"
                    label="Base URL"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                </div>
                <button
                  :if={credential_configured?(@settings.openai_api_key)}
                  id="settings-clear-openai"
                  type="button"
                  phx-click="clear_credential"
                  phx-value-credential="openai"
                  data-confirm="Remove the saved OpenAI credential immediately? Other unsaved form edits will remain available to save."
                  class="settings-danger-action mt-2"
                >
                  Remove credential
                </button>
              </article>

              <article id="settings-anthropic-card" class="settings-credential-card">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-semibold text-white">Anthropic</h3>
                    <p class="mt-1 text-sm text-gray-400">
                      Used whenever Anthropic is explicitly selected.
                    </p>
                  </div>
                  <.credential_badge configured={
                    credential_configured?(@settings.anthropic_api_key)
                  } />
                </div>
                <div class="mt-4 space-y-3">
                  <.input
                    name="settings[anthropic_api_key]"
                    id="settings-anthropic-api-key"
                    type="password"
                    value=""
                    label="API key"
                    autocomplete="new-password"
                    placeholder={credential_placeholder(@settings.anthropic_api_key)}
                    class="settings-control font-mono"
                  />
                  <.input
                    field={@settings_form[:anthropic_base_url]}
                    id="settings-anthropic-base-url"
                    type="url"
                    label="Base URL"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                </div>
                <button
                  :if={credential_configured?(@settings.anthropic_api_key)}
                  id="settings-clear-anthropic"
                  type="button"
                  phx-click="clear_credential"
                  phx-value-credential="anthropic"
                  data-confirm="Remove the saved Anthropic credential immediately? Other unsaved form edits will remain available to save."
                  class="settings-danger-action mt-2"
                >
                  Remove credential
                </button>
              </article>
            </div>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <.input
                field={@settings_form[:temperature]}
                id="settings-temperature"
                type="number"
                label="Default temperature"
                min="0"
                max="2"
                step="0.05"
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:max_tokens]}
                id="settings-max-tokens"
                type="number"
                label="Maximum output tokens"
                min="1"
                max="128000"
                class="settings-control"
                error_class="settings-control-error"
              />
            </div>
          </section>

          <section
            id="execution"
            aria-labelledby="execution-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="execution-title"
              eyebrow="Execution"
              title="Ordinary prompts and long-running work"
              description="Set the global policy inherited by new runs. Per-run setup in the workspace can override these values."
            />
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              <.input
                field={@settings_form[:default_dispatch_mode]}
                id="settings-default-dispatch-mode"
                type="select"
                label="Prompt dispatch"
                options={["Durable background": "background", "Live interactive": "interactive"]}
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_mode]}
                id="settings-default-run-mode"
                type="select"
                label="Default mission type"
                options={[
                  "Single agent": "single",
                  Swarm: "swarm",
                  "Typed DAG": "dag",
                  Research: "research"
                ]}
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_priority]}
                id="settings-default-run-priority"
                type="select"
                label="Queue priority"
                options={[Low: "low", Normal: "normal", High: "high", Critical: "critical"]}
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_max_attempts]}
                id="settings-default-run-max-attempts"
                type="number"
                label="Manual retry ceiling"
                min="1"
                max="10"
                aria-description="Counts the initial execution; eligible terminal runs require a user-requested retry."
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_time_budget_minutes]}
                id="settings-default-run-time-budget"
                type="number"
                label="Time budget (minutes)"
                min="1"
                max="10080"
                placeholder="Not capped"
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_token_budget]}
                id="settings-default-run-token-budget"
                type="number"
                label="Token budget"
                min="1"
                placeholder="Not capped"
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:default_run_cost_budget_cents]}
                id="settings-default-run-cost-budget"
                type="number"
                label="Cost budget (cents)"
                min="1"
                placeholder="Not capped"
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:agent_max_turns]}
                id="settings-agent-max-turns"
                type="number"
                label="Agent / coder turn limit"
                min="1"
                max="20"
                aria-description="Bounds the single-agent loop and each durable swarm coder invocation, including diagnostic repair passes."
                class="settings-control"
                error_class="settings-control-error"
              />
            </div>
            <div
              id="settings-run-attempt-policy"
              class="mt-5 flex items-start gap-3 border border-[#303844] bg-[#0b0f14] p-4"
            >
              <.icon
                name="hero-information-circle"
                class="mt-0.5 h-5 w-5 shrink-0 text-[#ff9d82]"
              />
              <p class="text-sm leading-6 text-gray-400">
                The ceiling counts the initial execution. A value of
                <strong class="font-semibold text-gray-200">3</strong>
                allows the first run plus up to two user-requested retries. Eligible failed,
                cancelled, or interrupted runs are never requeued automatically. Exact deep-research
                DAGs keep their fixed one-run contract; individual DAG steps own separate bounded retries.
                The agent-turn limit separately bounds the single-agent loop and every coder
                model/tool loop in a durable swarm, including each diagnostic repair invocation.
              </p>
            </div>
            <fieldset id="settings-default-tools" class="settings-fieldset mt-5">
              <legend>Optional tools for new runs</legend>
              <p id="settings-core-tools-note" class="mt-2 text-xs leading-5 text-gray-500">
                Core workspace read, edit, terminal, and Git tools are governed separately by the
                execution engine and safety policy.
              </p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <.tool_checkbox
                  id="settings-tool-ast-search"
                  name="settings[default_tools][ast_search]"
                  label="AST search"
                  description="Search project symbols and syntax structure."
                  checked={tool_enabled?(@settings_form, @settings, "ast_search")}
                />
                <.tool_checkbox
                  id="settings-tool-web-search"
                  name="settings[default_tools][web_search]"
                  label="Web search"
                  description="Allow enabled federated research providers."
                  checked={tool_enabled?(@settings_form, @settings, "web_search")}
                />
              </div>
            </fieldset>
          </section>

          <section
            id="goals"
            aria-labelledby="goals-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="goals-title"
              eyebrow="Goals"
              title="Autonomous goal defaults"
              description="Goals inherit the execution policy above, including budgets and the manual run attempt ceiling."
            />
            <div class="settings-choice-row">
              <.input
                field={@settings_form[:goal_auto_start]}
                id="settings-goal-auto-start"
                type="checkbox"
                label="Queue new goals immediately"
                class="h-4 w-4 accent-[#ff8a68]"
              />
              <p class="text-sm leading-5 text-gray-400">
                Turn this off to save newly created goals as durable drafts for review.
              </p>
            </div>
          </section>

          <section
            id="swarm"
            aria-labelledby="swarm-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="swarm-title"
              eyebrow="Swarm"
              title="Multi-agent guardrails"
              description="Choose bounded defaults for the supervised agent fleet. Individual runs may request fewer agents."
            />
            <div class="grid gap-4 sm:grid-cols-2">
              <.input
                field={@settings_form[:swarm_agent_count]}
                id="settings-swarm-agent-count"
                type="number"
                label="Default fleet size"
                min="4"
                max="32"
                class="settings-control"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:swarm_max_retries]}
                id="settings-swarm-max-retries"
                type="number"
                label="Swarm self-healing retries"
                min="0"
                max="10"
                aria-description="Self-healing verification retries inside one run attempt."
                class="settings-control"
                error_class="settings-control-error"
              />
            </div>
            <p id="settings-swarm-retry-policy" class="settings-help-copy">
              Verification self-healing retries happen inside one run attempt; they do not add
              manual run retries. Fleet size remains constrained by durable run capacity and
              workspace locks.
            </p>
          </section>

          <section
            id="research"
            aria-labelledby="research-title"
            class="settings-section-card settings-section-card-research scroll-mt-24"
          >
            <.settings_section_header
              id="research-title"
              eyebrow="Research"
              title="Research effort and enforced caps"
              description="Every preset remains bounded. Optional caps below can tighten a preset but never expand its safety ceiling."
              tone="research"
            />
            <% {effort_name, effort_copy} =
              research_effort_value(@settings_form[:research_level].value) %>
            <div
              id="settings-research-effort-summary"
              class="mb-5 border border-violet-400/25 bg-violet-400/[0.05] p-4"
            >
              <p class="font-mono text-xs font-semibold uppercase tracking-wider text-violet-300">
                {effort_name} effort
              </p>
              <p class="mt-1 text-sm leading-5 text-gray-300">{effort_copy}</p>
              <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                <div>
                  <dt class="text-gray-500">Sources</dt><dd class="mt-1 font-mono text-gray-200">
                    up to {@settings_form[:research_max_sources].value}
                  </dd>
                </div>
                <div>
                  <dt class="text-gray-500">Fetch workers</dt><dd class="mt-1 font-mono text-gray-200">
                    {@settings_form[:research_parallelism].value}
                  </dd>
                </div>
                <div>
                  <dt class="text-gray-500">Token cap</dt><dd class="mt-1 font-mono text-gray-200">
                    {optional_limit(@settings_form[:research_max_tokens].value, "tokens")}
                  </dd>
                </div>
                <div>
                  <dt class="text-gray-500">Time cap</dt><dd class="mt-1 font-mono text-gray-200">
                    {optional_limit(
                      @settings_form[:research_time_budget_minutes].value,
                      "minutes"
                    )}
                  </dd>
                </div>
              </dl>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <.input
                field={@settings_form[:research_level]}
                id="settings-research-level"
                type="select"
                label="Research effort"
                options={[Low: "low", Medium: "medium", High: "high", Ultra: "ultra"]}
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_max_sources]}
                id="settings-research-max-sources"
                type="number"
                label="Maximum sources"
                min="1"
                max="40"
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_parallelism]}
                id="settings-research-parallelism"
                type="number"
                label="Fetch parallelism"
                min="1"
                max="16"
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_time_budget_minutes]}
                id="settings-research-time-budget"
                type="number"
                label="Time cap (minutes)"
                min="1"
                max="1440"
                placeholder="Preset ceiling"
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_max_tokens]}
                id="settings-research-max-tokens"
                type="number"
                label="Token cap"
                min="0"
                max="10000000"
                placeholder="Preset ceiling"
                aria-description="Hard admission cap. Zero blocks manifests that reserve tokens; leave blank to use the effort preset ceiling."
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_max_cost_cents]}
                id="settings-research-max-cost"
                type="number"
                label="Cost cap (cents)"
                min="0"
                max="10000000"
                placeholder="Preset ceiling"
                aria-description="Hard admission cap. Zero blocks manifests that reserve reported provider cost; leave blank to use the effort preset ceiling."
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <.input
                field={@settings_form[:research_depth]}
                id="settings-research-depth"
                type="select"
                label="Legacy workflow depth"
                options={[Quick: "quick", Standard: "standard", Deep: "deep"]}
                class="settings-control settings-control-research"
                error_class="settings-control-error"
              />
              <div class="settings-choice-row min-h-11">
                <.input
                  field={@settings_form[:research_require_conflict_audit]}
                  id="settings-research-conflict-audit"
                  type="checkbox"
                  label="Require conflict audit"
                  class="h-4 w-4 accent-violet-400"
                />
              </div>
            </div>
            <p id="settings-research-zero-cap-note" class="mt-4 text-xs leading-5 text-gray-500">
              Token and reported-cost caps are hard admission limits. Entering 0 blocks any
              research manifest that reserves that resource; leave a cap blank to use the bounded
              effort-preset ceiling.
            </p>
          </section>

          <section
            id="providers"
            aria-labelledby="providers-title"
            class="settings-section-card settings-section-card-research scroll-mt-24"
          >
            <.settings_section_header
              id="providers-title"
              eyebrow="Providers"
              title="Federated search order"
              description="Enabled providers are tried in this order. Status reflects the current form configuration, not a live connectivity test. Retired adapters stay visible for compatibility but cannot enter new automatic runs."
              tone="research"
            />
            <label for="settings-provider-filter" class="sr-only">Filter research providers</label>
            <div class="relative mb-4">
              <.icon
                name="hero-magnifying-glass"
                class="pointer-events-none absolute left-3 top-3.5 h-4 w-4 text-gray-500"
              />
              <input
                id="settings-provider-filter"
                name="provider_filter"
                type="search"
                value={@provider_filter}
                placeholder="Filter providers by name, lifecycle, or capability"
                phx-change="filter_providers"
                phx-debounce="200"
                class="settings-control w-full pl-10"
              />
            </div>

            <div id="settings-search-providers" class="space-y-2">
              <article
                :for={
                  descriptor <-
                    filtered_descriptors(@search_provider_descriptors, @provider_filter)
                }
                id={"settings-search-provider-#{provider_id(descriptor)}"}
                data-provider-lifecycle={descriptor.lifecycle}
                class="settings-provider-row"
              >
                <% provider = provider_id(descriptor) %>
                <% config = provider_config(@settings_form, @settings, provider) %>
                <% {status_label, status_tone} = provider_status(descriptor, config) %>
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                  <div class="flex min-w-0 flex-1 items-start gap-3">
                    <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center border border-[#303844] bg-[#0b0f14] font-mono text-xs font-bold text-gray-300">
                      {provider |> String.first() |> String.upcase()}
                    </div>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="text-sm font-semibold text-white">
                          {provider_name(descriptor)}
                        </h3>
                        <span
                          id={"settings-provider-status-#{provider}"}
                          data-tone={status_tone}
                          class="settings-provider-status"
                        >
                          {status_label}
                        </span>
                        <span class="font-mono text-[11px] uppercase tracking-wider text-gray-400">
                          {descriptor.lifecycle}
                        </span>
                      </div>
                      <p class="mt-1 text-sm leading-5 text-gray-400">
                        {Enum.map_join(
                          descriptor.capabilities,
                          " · ",
                          &(&1 |> Atom.to_string() |> String.replace("_", " "))
                        )}
                      </p>
                      <p
                        :if={provider_lifecycle_note(descriptor)}
                        class="mt-1 text-xs leading-5 text-gray-500"
                      >
                        {provider_lifecycle_note(descriptor)}
                      </p>
                    </div>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                    <input
                      type="hidden"
                      name={"settings[search_providers][#{provider}][enabled]"}
                      value="false"
                    />
                    <label
                      for={"settings-provider-enabled-#{provider}"}
                      class="settings-provider-toggle"
                    >
                      <input
                        id={"settings-provider-enabled-#{provider}"}
                        type="checkbox"
                        name={"settings[search_providers][#{provider}][enabled]"}
                        value="true"
                        checked={provider_enabled?(config)}
                        disabled={descriptor.lifecycle == :retired}
                        class="h-4 w-4 accent-violet-400"
                      /> Enabled
                    </label>
                    <div
                      class="flex"
                      role="group"
                      aria-label={"Move #{provider_name(descriptor)} in provider order"}
                    >
                      <button
                        id={"settings-provider-move-up-#{provider}"}
                        type="button"
                        phx-click="move_provider"
                        phx-value-provider={provider}
                        phx-value-direction="up"
                        disabled={first_provider?(@settings_form, @settings, provider)}
                        aria-label={"Move #{provider_name(descriptor)} up"}
                        class="settings-icon-action"
                      ><.icon name="hero-arrow-up" class="h-4 w-4" /></button>
                      <button
                        id={"settings-provider-move-down-#{provider}"}
                        type="button"
                        phx-click="move_provider"
                        phx-value-provider={provider}
                        phx-value-direction="down"
                        disabled={last_provider?(@settings_form, @settings, provider)}
                        aria-label={"Move #{provider_name(descriptor)} down"}
                        class="settings-icon-action -ml-px"
                      ><.icon name="hero-arrow-down" class="h-4 w-4" /></button>
                    </div>
                    <button
                      id={"settings-provider-advanced-#{provider}"}
                      type="button"
                      phx-click="toggle_provider_advanced"
                      phx-value-provider={provider}
                      aria-expanded={MapSet.member?(@expanded_providers, provider)}
                      aria-controls={"settings-provider-panel-#{provider}"}
                      aria-label={"Configure #{provider_name(descriptor)}"}
                      class="settings-secondary-action"
                    >
                      Configure <.icon name="hero-chevron-down" class="h-3.5 w-3.5" />
                    </button>
                  </div>
                </div>

                <div
                  :if={MapSet.member?(@expanded_providers, provider)}
                  id={"settings-provider-panel-#{provider}"}
                  class="mt-4 grid gap-4 border-t border-[#29313a] pt-4 sm:grid-cols-2"
                >
                  <div :if={:api_key in descriptor.config_fields}>
                    <.input
                      name={"settings[search_providers][#{provider}][api_key]"}
                      id={"settings-provider-key-#{provider}"}
                      type="password"
                      value=""
                      label={descriptor.auth_label}
                      autocomplete="new-password"
                      placeholder={credential_placeholder(config["api_key"])}
                      class="settings-control font-mono"
                    />
                    <button
                      :if={credential_configured?(config["api_key"])}
                      id={"settings-provider-clear-#{provider}"}
                      type="button"
                      phx-click="clear_credential"
                      phx-value-credential={"provider:#{provider}"}
                      data-confirm={"Remove the saved #{provider_name(descriptor)} credential immediately? Other unsaved form edits will remain available to save."}
                      class="settings-danger-action"
                    >Remove credential</button>
                  </div>
                  <.input
                    :if={:base_url in descriptor.config_fields}
                    name={"settings[search_providers][#{provider}][base_url]"}
                    id={"settings-provider-url-#{provider}"}
                    type="url"
                    label={
                      if descriptor.id == :searxng, do: "Instance URL", else: "Official endpoint"
                    }
                    value={config["base_url"] || ""}
                    readonly={descriptor.id != :searxng}
                    class="settings-control font-mono read-only:cursor-not-allowed read-only:text-gray-500"
                  />
                  <.input
                    :if={descriptor.id == :google}
                    name="settings[search_providers][google][engine_id]"
                    id="settings-provider-engine-google"
                    type="text"
                    label="Search engine ID"
                    value={config["engine_id"] || ""}
                    class="settings-control font-mono"
                  />
                  <.input
                    :if={descriptor.id == :serpapi}
                    name="settings[search_providers][serpapi][engine]"
                    id="settings-provider-engine-serpapi"
                    type="select"
                    label="Search engine"
                    value={config["engine"] || "google"}
                    options={
                      Enum.map(
                        ~w(google bing duckduckgo baidu yahoo yandex),
                        &{String.capitalize(&1), &1}
                      )
                    }
                    class="settings-control font-mono"
                  />
                </div>
              </article>

              <div
                :if={filtered_descriptors(@search_provider_descriptors, @provider_filter) == []}
                id="settings-provider-filter-empty"
                class="settings-empty-state"
              >
                No providers match this filter.
              </div>
            </div>
          </section>

          <section
            id="editor"
            aria-labelledby="editor-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="editor-title"
              eyebrow="Editor"
              title="File editing"
              description="Control how workspace file edits behave after agent or user changes."
            />
            <div class="settings-choice-row">
              <.input
                field={@settings_form[:auto_save]}
                id="settings-auto-save"
                type="checkbox"
                label="Automatically save file edits"
                class="h-4 w-4 accent-[#ff8a68]"
              />
              <p class="text-sm leading-5 text-gray-400">
                When disabled, edited buffers remain marked as unsaved until you confirm them.
              </p>
            </div>
          </section>

          <section
            id="usage"
            aria-labelledby="usage-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="usage-title"
              eyebrow="Usage"
              title={if @context_session, do: "Current session usage", else: "Global usage"}
              description="Only provider-reported token-bearing messages are counted. No estimates or fabricated credit bars."
            />
            <div :if={@usage_status == :ready} id="settings-usage-ready">
              <dl class="mb-5 grid gap-3 sm:grid-cols-2">
                <div class="settings-metric">
                  <dt>Observed tokens</dt><dd>{usage_total_value(@usage_totals)}</dd>
                </div>
                <div class="settings-metric">
                  <dt>Reported cost</dt><dd>
                    ${:erlang.float_to_binary(usage_cost_value(@usage_totals), decimals: 2)}
                  </dd>
                </div>
              </dl>
              <div
                id="settings-usage-rows"
                class="divide-y divide-[#29313a] border-y border-[#29313a]"
              >
                <article
                  :for={row <- Enum.take(@usage_rows, 20)}
                  id={"settings-usage-row-#{usage_dom_id(row)}"}
                  class="grid gap-2 py-3 text-sm sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-5"
                >
                  <div class="min-w-0">
                    <p class="truncate font-medium text-gray-200">
                      {usage_value(row, :model, "Unknown model")}
                    </p><p class="mt-0.5 font-mono text-xs text-gray-500">
                      {format_usage_date(usage_value(row, :date))}
                    </p>
                  </div>
                  <p class="font-mono text-xs text-gray-400">
                    {usage_value(row, :provider, "unknown")}
                  </p>
                  <p class="font-mono text-sm font-semibold tabular-nums text-gray-200">
                    {usage_value(row, :tokens, 0)} tokens
                  </p>
                </article>
              </div>
            </div>
            <div
              :if={@usage_status in [:empty, :unavailable]}
              id="settings-usage-empty"
              class="settings-empty-state"
            >
              <.icon name="hero-chart-bar" class="mx-auto mb-3 h-6 w-6 text-gray-600" />{@usage_message}
            </div>
            <div
              :if={@usage_status == :error}
              id="settings-usage-error"
              role="alert"
              class="settings-error-state"
            >
              <.icon name="hero-exclamation-triangle" class="h-5 w-5 shrink-0" />{@usage_message}
            </div>
          </section>

          <section
            id="runtime"
            aria-labelledby="runtime-title"
            class="settings-section-card scroll-mt-24"
          >
            <.settings_section_header
              id="runtime-title"
              eyebrow="Runtime"
              title="Operational facts"
              description="Read-only state from the local OTP runtime. Service capacity and security boundaries are not editable browser preferences."
            />
            <div class="divide-y divide-[#29313a] border-y border-[#29313a]">
              <article
                :for={fact <- @runtime_facts}
                id={"settings-runtime-#{fact.id}"}
                class="grid gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6"
              >
                <div>
                  <h3 class="text-sm font-semibold text-gray-200">{fact.label}</h3><p class="mt-1 text-sm leading-5 text-gray-500">
                    {fact.note}
                  </p>
                </div>
                <span data-tone={fact.tone} class="settings-runtime-value">{fact.value}</span>
              </article>
            </div>
            <div class="mt-4 flex items-start gap-2 text-xs leading-5 text-gray-500">
              <.icon name="hero-information-circle" class="mt-0.5 h-4 w-4 shrink-0" />
              Changes to process-level concurrency, shell adapters, or network policy require a runtime restart and remain configuration-file settings.
            </div>
          </section>

          <div id="settings-save-bar" class="settings-save-bar">
            <div id="settings-save-status" role="status" aria-live="polite" class="min-w-0">
              <div class="phx-submit-loading:hidden">
                <p class={["text-sm font-semibold", status_text_class(@settings_status)]}>
                  {status_title(@settings_status)}
                </p>
                <p class="mt-0.5 text-xs leading-5 text-gray-500">
                  {@settings_message}
                  <%= if @saved_at && @settings_status == :saved do %>
                    · {Calendar.strftime(@saved_at, "%H:%M:%S UTC")}
                  <% end %>
                </p>
              </div>
              <div class="hidden phx-submit-loading:block">
                <p class="text-sm font-semibold text-[#ff9d82]">Saving</p>
                <p class="mt-0.5 text-xs text-gray-500">
                  Writing validated defaults to local storage…
                </p>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <button
                id="settings-discard"
                type="button"
                phx-click="discard_settings"
                disabled={@settings_status not in [:dirty, :error]}
                aria-describedby="settings-save-status"
                class="settings-discard-button"
              >
                Discard
              </button>
              <button
                id="settings-save"
                type="submit"
                phx-disable-with="Saving…"
                disabled={@settings_status not in [:dirty, :error]}
                aria-describedby="settings-save-status"
                class="settings-save-button phx-submit-loading:cursor-wait"
              >
                Save settings
              </button>
            </div>
          </div>
        </.form>
      </div>
    </div>
  </main>
  <div
    id="settings-client-behaviors"
    phx-hook=".SettingsPage"
    data-dirty={if(@settings_status in [:dirty, :error], do: "true", else: "false")}
    class="hidden"
  >
  </div>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".SettingsPage">
    export default {
      mounted() {
        this.dirty = this.el.dataset.dirty === "true"
        this.guardHistoryEntry = false
        this.removingGuardEntry = false
        this.restoringGuardEntry = false

        this.beforeUnload = event => {
          if (!this.dirty) return
          event.preventDefault()
          event.returnValue = ""
        }

        this.guardNavigation = event => {
          const link = event.target.closest("[data-settings-navigation]")
          if (!this.dirty || !link) return

          const message = link.dataset.unsavedConfirm
          if (!message || !window.confirm(message)) {
            event.preventDefault()
            event.stopImmediatePropagation()
            return
          }

          this.dirty = false
        }

        this.handleHistoryBack = () => {
          if (this.restoringGuardEntry) {
            this.restoringGuardEntry = false
            return
          }

          if (this.removingGuardEntry) {
            this.removingGuardEntry = false
            this.guardHistoryEntry = false
            return
          }

          if (!this.dirty || !this.guardHistoryEntry) return

          if (window.confirm("Discard your unsaved settings and leave this page?")) {
            this.dirty = false
            this.guardHistoryEntry = false
            window.history.back()
          } else {
            this.restoringGuardEntry = true
            window.history.forward()
          }
        }

        window.addEventListener("beforeunload", this.beforeUnload)
        window.addEventListener("popstate", this.handleHistoryBack)
        document.addEventListener("click", this.guardNavigation, true)
        this.syncDirtyGuard()

        this.handleEvent("settings_clear_secrets", () => {
          document.querySelectorAll("#settings-form input[type='password']").forEach(input => {
            input.value = ""
          })
        })
      },

      updated() {
        this.dirty = this.el.dataset.dirty === "true"
        this.syncDirtyGuard()
      },

      destroyed() {
        window.removeEventListener("beforeunload", this.beforeUnload)
        window.removeEventListener("popstate", this.handleHistoryBack)
        document.removeEventListener("click", this.guardNavigation, true)
      },

      syncDirtyGuard() {
        if (this.dirty && !this.guardHistoryEntry) {
          window.history.pushState({settingsDirtyGuard: true}, "", window.location.href)
          this.guardHistoryEntry = true
        } else if (!this.dirty && this.guardHistoryEntry && !this.removingGuardEntry) {
          this.removingGuardEntry = true
          window.history.back()
        }
      }
    }
  </script>
</Layouts.app>
