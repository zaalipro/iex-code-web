<Layouts.app flash={@flash} current_scope={@current_scope}>
  <a href="#main-content" class="workspace-skip-link">Skip to workspace content</a>
  <div
    id="workspace-shell"
    phx-hook="InstrumentDeck"
    data-active-view={@active_view}
    data-project-id={@project.id}
    data-session-id={@session.id}
    class="workspace-shell flex h-dvh min-h-0 w-full bg-[#0a0d12] text-[#f0f6fc] font-sans antialiased overflow-hidden"
  >
    <main
      id="main-content"
      tabindex="-1"
      class="flex-1 flex flex-col h-full min-w-0 bg-[#0a0d12] relative overflow-hidden"
    >
      <h1 class="sr-only">IexCode workspace: {@project.name}</h1>
      <.mission_strip
        project={@project}
        session={@session}
        runtime={@runtime_status}
        active_view={@active_view}
      >
        <:primary_action>
          <%= if @active_view == "deck" do %>
            <button
              id="new-mission-button"
              type="button"
              phx-click="open_goal_modal"
              class="sf-control min-h-11 px-4 text-sm font-semibold"
            >
              New mission
            </button>
          <% else %>
            <button
              id="return-to-instrument-deck-action"
              type="button"
              phx-click="return_to_instrument_deck"
              class="sf-control min-h-11 px-4 text-sm font-semibold"
            >
              Return to instruments
            </button>
          <% end %>
        </:primary_action>
      </.mission_strip>

      <!-- View Containers -->
      <div id="workspace-views" class="relative flex-1 flex min-w-0 overflow-hidden">
        <%= if @active_view == "deck" do %>
          <%= if @resume_instrument != nil do %>
            <.link
              id="resume-instrument"
              patch={@resume_instrument.path}
              data-surface={@resume_instrument.surface}
              class="sf-focus-surface absolute right-5 top-5 z-10 rounded-full border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] px-4 py-2 text-xs font-semibold tracking-wide text-[var(--sf-text-primary)] transition-colors hover:bg-[var(--sf-raised-control)] md:right-7 md:top-7"
            >
              Resume {@resume_instrument.title}
            </.link>
          <% end %>
          <.instrument_deck summaries={@instrument_summaries} active_view={@active_view} />
        <% else %>
          <!-- TAB 1: KANBAN BOARD -->
        <%= if @active_tab == "kanban" do %>
          <div class="flex-1 flex flex-col h-full min-w-0 overflow-hidden p-3 md:p-5">
            <!-- Header & Filter Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4 shrink-0">
              <div class="flex items-center gap-3">
                <h2 class="text-lg font-semibold text-white tracking-tight flex items-center gap-2">
                  Today's tasks
                  <span class="px-2 py-0.5 rounded-full bg-[#1c2128] text-xs font-mono text-gray-400 border border-[#30363d]">
                    {length(@tasks)}
                  </span>
                </h2>
              </div>

              <!-- Filter Bar -->
              <div class="flex max-w-full items-center gap-2.5 overflow-x-auto pb-1 text-xs font-mono text-gray-400">
                <.form
                  for={to_form(@kanban_filter)}
                  id="kanban-filter-form"
                  phx-change="filter_kanban"
                  class="flex items-center gap-2"
                >
                  <div class="relative">
                    <input
                      type="text"
                      name="search"
                      value={@kanban_filter["search"]}
                      placeholder="Filter cards..."
                      class="bg-[#11151c] border border-[#21262d] rounded-xl px-3 py-1.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-gray-400 transition-smooth"
                    />
                  </div>

                  <input type="hidden" name="priority" value={@kanban_filter["priority"]} />
                  <input type="hidden" name="status" value={@kanban_filter["status"]} />
                  <input type="hidden" name="assignee" value={@kanban_filter["assignee"]} />
                </.form>

                <!-- PRIORITY Custom Dropdown -->
                <div
                  class="relative"
                  phx-click-away={@open_dropdown == "priority" && "close_dropdowns"}
                >
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="priority"
                    aria-haspopup="listbox"
                    aria-expanded={@open_dropdown == "priority"}
                    aria-controls={
                      if(@open_dropdown == "priority", do: "priority-filter-listbox", else: nil)
                    }
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["priority"] != "" &&
                        "bg-amber-500/10 text-amber-300 border-amber-500/30",
                      @kanban_filter["priority"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <div class="flex items-end gap-0.5">
                      <span class="w-1 h-1.5 rounded-xs bg-current"></span>
                      <span class="w-1 h-2.5 rounded-xs bg-current"></span>
                      <span class="w-1 h-3.5 rounded-xs bg-current"></span>
                    </div>
                    <span>
                      <%= if @kanban_filter["priority"] != "" do %>
                        {String.upcase(@kanban_filter["priority"])}
                      <% else %>
                        PRIORITY
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "priority" do %>
                    <div
                      id="priority-filter-listbox"
                      role="listbox"
                      aria-label="Filter by priority"
                      class="absolute right-0 top-full mt-2 w-48 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95"
                    >
                      <button
                        type="button"
                        role="option"
                        aria-selected={@kanban_filter["priority"] == ""}
                        phx-click="select_kanban_filter"
                        phx-value-key="priority"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Priorities</span>
                        <%= if @kanban_filter["priority"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for p <- ["critical", "high", "medium", "low"] do %>
                        <button
                          type="button"
                          role="option"
                          aria-selected={@kanban_filter["priority"] == p}
                          phx-click="select_kanban_filter"
                          phx-value-key="priority"
                          phx-value-value={p}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class={[
                              "w-2 h-2 rounded-full",
                              p == "critical" && "bg-red-400",
                              p == "high" && "bg-orange-400",
                              p == "medium" && "bg-blue-400",
                              p == "low" && "bg-gray-400"
                            ]}></span>
                            <span class="capitalize">{p}</span>
                          </div>
                          <%= if @kanban_filter["priority"] == p do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- STATUS Custom Dropdown -->
                <div
                  class="relative"
                  phx-click-away={@open_dropdown == "status" && "close_dropdowns"}
                >
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="status"
                    aria-haspopup="listbox"
                    aria-expanded={@open_dropdown == "status"}
                    aria-controls={
                      if(@open_dropdown == "status", do: "status-filter-listbox", else: nil)
                    }
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["status"] != "" &&
                        "bg-blue-500/10 text-blue-300 border-blue-500/30",
                      @kanban_filter["status"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <span class="text-xs">◌</span>
                    <span>
                      <%= if @kanban_filter["status"] != "" do %>
                        {String.upcase(@kanban_filter["status"])}
                      <% else %>
                        STATUS
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "status" do %>
                    <div
                      id="status-filter-listbox"
                      role="listbox"
                      aria-label="Filter by status"
                      class="absolute right-0 top-full mt-2 w-52 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95 max-h-72 overflow-y-auto"
                    >
                      <button
                        type="button"
                        role="option"
                        aria-selected={@kanban_filter["status"] == ""}
                        phx-click="select_kanban_filter"
                        phx-value-key="status"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Statuses</span>
                        <%= if @kanban_filter["status"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for s <- Kanban.Task.statuses() do %>
                        <button
                          type="button"
                          role="option"
                          aria-selected={@kanban_filter["status"] == s}
                          phx-click="select_kanban_filter"
                          phx-value-key="status"
                          phx-value-value={s}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class={[
                              "w-2 h-2 rounded-full",
                              s == "triage" && "bg-gray-400",
                              s == "todo" && "bg-purple-400",
                              s == "scheduled" && "bg-indigo-400",
                              s == "ready" && "bg-blue-400",
                              s == "running" &&
                                "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]",
                              s == "blocked" && "bg-red-400",
                              s == "review" && "bg-amber-400",
                              s == "done" && "bg-gray-500"
                            ]}></span>
                            <span class="uppercase tracking-wider">{s}</span>
                          </div>
                          <%= if @kanban_filter["status"] == s do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- ASSIGNEE Custom Dropdown -->
                <div
                  class="relative"
                  phx-click-away={@open_dropdown == "assignee" && "close_dropdowns"}
                >
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="assignee"
                    aria-haspopup="listbox"
                    aria-expanded={@open_dropdown == "assignee"}
                    aria-controls={
                      if(@open_dropdown == "assignee", do: "assignee-filter-listbox", else: nil)
                    }
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["assignee"] != "" &&
                        "bg-purple-500/10 text-purple-300 border-purple-500/30",
                      @kanban_filter["assignee"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <.icon name="hero-user" class="w-3.5 h-3.5 text-gray-400" />
                    <span>
                      <%= if @kanban_filter["assignee"] != "" do %>
                        {String.upcase(@kanban_filter["assignee"])}
                      <% else %>
                        ASSIGNEE
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "assignee" do %>
                    <div
                      id="assignee-filter-listbox"
                      role="listbox"
                      aria-label="Filter by assignee"
                      class="absolute right-0 top-full mt-2 w-48 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95"
                    >
                      <button
                        type="button"
                        role="option"
                        aria-selected={@kanban_filter["assignee"] == ""}
                        phx-click="select_kanban_filter"
                        phx-value-key="assignee"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Assignees</span>
                        <%= if @kanban_filter["assignee"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for a <- ["default", "planner", "coder", "verifier"] do %>
                        <button
                          type="button"
                          role="option"
                          aria-selected={@kanban_filter["assignee"] == a}
                          phx-click="select_kanban_filter"
                          phx-value-key="assignee"
                          phx-value-value={a}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class="w-4 h-4 rounded-full bg-[#21262d] text-center font-bold text-[8px] flex items-center justify-center text-white">
                              {String.first(a) |> String.upcase()}
                            </span>
                            <span class="capitalize">{a}</span>
                          </div>
                          <%= if @kanban_filter["assignee"] == a do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <% kanban_filters_active? =
              Enum.any?(@kanban_filter, fn {_key, value} -> value != "" end) %>

            <div
              :if={@tasks == [] and kanban_filters_active?}
              id="kanban-filter-empty-state"
              class="mb-4 flex flex-col items-start justify-between gap-4 rounded-2xl border border-dashed border-[#30363d] bg-[#11151c]/70 px-5 py-4 sm:flex-row sm:items-center"
            >
              <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#30363d] bg-[#161b22] text-gray-400">
                  <.icon name="hero-funnel" class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-gray-100">No tasks match these filters</p>
                  <p class="mt-1 max-w-xl text-xs leading-5 text-gray-400">
                    Your tasks are still here. Clear the active search and filters to show the full board.
                  </p>
                </div>
              </div>
              <button
                id="kanban-clear-filters"
                type="button"
                phx-click="clear_kanban_filters"
                class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-[#30363d] bg-[#161b22] px-3.5 py-2 text-xs font-semibold text-gray-200 transition-smooth hover:border-gray-500 hover:bg-[#1c2128]"
              >
                <.icon name="hero-x-mark" class="h-3.5 w-3.5" /> Clear filters
              </button>
            </div>

            <div
              :if={@tasks == [] and !kanban_filters_active?}
              id="kanban-empty-state"
              class="mb-4 flex flex-col items-start justify-between gap-4 rounded-2xl border border-dashed border-[#30363d] bg-[#11151c]/70 px-5 py-4 sm:flex-row sm:items-center"
            >
              <div class="flex items-start gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-[#30363d] bg-[#161b22] text-gray-400">
                  <.icon name="hero-rectangle-stack" class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-gray-100">Your task board is ready</p>
                  <p class="mt-1 max-w-xl text-xs leading-5 text-gray-400">
                    This workspace starts empty. Add a task when you are ready—nothing will be
                    scheduled or executed automatically.
                  </p>
                </div>
              </div>
              <button
                id="kanban-empty-create-task"
                type="button"
                phx-click="toggle_new_task_modal"
                class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-[#ff5e3a] px-3.5 py-2 text-xs font-semibold text-white shadow-lg shadow-orange-950/20 transition-smooth hover:bg-[#ff4e24]"
              >
                <.icon name="hero-plus" class="h-3.5 w-3.5" /> Create first task
              </button>
            </div>

            <!-- Kanban 8-Column Accordion Board -->
            <div
              id="kanban-board"
              role="region"
              aria-label="Task status board"
              class="flex flex-1 snap-x snap-proximity gap-3 overflow-x-auto overscroll-x-contain px-0.5 pb-3 pt-0.5"
            >
              <%= for col_status <- Kanban.Task.statuses() do %>
                <% col_tasks = Enum.filter(@tasks, &(&1.status == col_status))
                is_expanded = @expanded_column == col_status %>

                <%= if is_expanded do %>
                  <!-- Expanded Column -->
                  <div
                    id={"kanban-col-#{col_status}"}
                    data-status={col_status}
                    data-column-variant="expanded"
                    class="kanban-column kanban-column--expanded flex h-full flex-shrink-0 snap-start flex-col"
                  >
                    <!-- Column Header -->
                    <div class="kanban-column__header flex shrink-0 items-center justify-between border-b p-3.5">
                      <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-gray-300">
                        <span class={[
                          "w-2 h-2 rounded-full",
                          col_status == "running" &&
                            "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]",
                          col_status == "ready" && "bg-blue-400",
                          col_status == "scheduled" && "bg-indigo-400",
                          col_status == "todo" && "bg-purple-400",
                          col_status == "triage" && "bg-gray-400",
                          col_status == "blocked" && "bg-red-400",
                          col_status == "review" && "bg-amber-400",
                          col_status == "done" && "bg-gray-500"
                        ]}></span>
                        <span class="uppercase">{String.upcase(col_status)}</span>
                        <span
                          class="kanban-column__count rounded-full px-2 text-[10px] font-mono"
                          aria-label={"#{length(col_tasks)} tasks"}
                        >
                          {length(col_tasks)}
                        </span>
                      </div>
                      <button
                        id={"kanban-collapse-#{col_status}"}
                        type="button"
                        phx-click="toggle_column"
                        phx-value-status={col_status}
                        aria-controls={"kanban-cards-#{col_status}"}
                        aria-expanded="true"
                        aria-label={"Collapse #{col_status} column"}
                        class="kanban-column__collapse rounded-lg p-1 text-gray-500 transition-smooth active:scale-95"
                        title="Collapse Column"
                      >
                        <.icon name="hero-chevron-left" class="w-3.5 h-3.5" />
                      </button>
                    </div>

                    <!-- Column Cards List -->
                    <div
                      id={"kanban-cards-#{col_status}"}
                      phx-hook=".KanbanDrag"
                      data-status={col_status}
                      class="flex-1 overflow-y-auto p-3 space-y-2.5"
                    >
                      <%= for task <- col_tasks do %>
                        <button
                          type="button"
                          id={"task-card-#{task.id}"}
                          phx-click="open_task_drawer"
                          phx-value-id={task.id}
                          phx-hook=".KanbanCard"
                          data-task-id={task.id}
                          class={[
                            "w-full p-3.5 bg-[#161b22] border rounded-2xl transition-smooth cursor-pointer hover:border-gray-500 space-y-2.5 group shadow-sm text-left",
                            @selected_task && @selected_task.id == task.id &&
                              "border-emerald-500/60 ring-1 ring-emerald-500/20",
                            !(@selected_task && @selected_task.id == task.id) &&
                              "border-[#21262d]"
                          ]}
                        >
                          <div class="flex items-center justify-between text-[10px] font-mono text-gray-500">
                            <span class="uppercase tracking-wider">#{String.slice(task.id, 0..4)}</span>
                            <span class={[
                              "px-1.5 py-0.5 rounded font-semibold",
                              task.priority == "critical" &&
                                "bg-red-500/10 text-red-400 border border-red-500/20",
                              task.priority == "high" &&
                                "bg-orange-500/10 text-orange-400 border border-orange-500/20",
                              task.priority == "medium" &&
                                "bg-blue-500/10 text-blue-400 border border-blue-500/20",
                              task.priority == "low" &&
                                "bg-gray-500/10 text-gray-400 border border-gray-500/20"
                            ]}>
                              {String.upcase(task.priority || "MEDIUM")}
                            </span>
                          </div>

                          <h4 class="text-xs font-semibold text-white font-sans leading-snug group-hover:text-cyan-300 transition-colors">
                            {task.title}
                          </h4>

                          <%= if task.description do %>
                            <p class="text-[11px] text-gray-400 line-clamp-2 leading-relaxed">
                              {task.description}
                            </p>
                          <% end %>

                          <div class="flex items-center justify-between pt-2 border-t border-white/5 text-[10px] font-mono text-gray-400">
                            <div class="flex items-center gap-1.5">
                              <span class="w-4 h-4 rounded-full bg-[#21262d] text-center font-bold text-[8px] flex items-center justify-center text-white">
                                <%= if is_binary(task.assignee) and task.assignee != "" do %>
                                  {String.first(task.assignee) |> String.upcase()}
                                <% else %>
                                  D
                                <% end %>
                              </span>
                              <span>{task.assignee}</span>
                            </div>

                            <%= if task.worker_pid do %>
                              <span class="text-emerald-400">{task.worker_pid}</span>
                            <% end %>
                          </div>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <!-- Collapsed Vertical Ribbon -->
                  <button
                    type="button"
                    id={"kanban-col-#{col_status}"}
                    phx-click="toggle_column"
                    phx-value-status={col_status}
                    phx-hook=".KanbanDrag"
                    data-status={col_status}
                    data-column-variant="collapsed"
                    aria-label={"Expand #{col_status} column"}
                    aria-expanded="false"
                    class="kanban-column kanban-column--collapsed group flex flex-shrink-0 snap-start flex-col items-center justify-between px-2 py-4"
                    title={"Click to expand #{col_status} column"}
                  >
                    <div class="flex w-full flex-col items-center gap-3">
                      <span class={[
                        "h-2.5 w-2.5 shrink-0 rounded-full ring-4 ring-white/[0.025]",
                        col_status == "running" &&
                          "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)] motion-safe:animate-pulse",
                        col_status == "ready" && "bg-blue-400",
                        col_status == "scheduled" && "bg-indigo-400",
                        col_status == "todo" && "bg-purple-400",
                        col_status == "triage" && "bg-gray-400",
                        col_status == "blocked" && "bg-red-400",
                        col_status == "review" && "bg-amber-400",
                        col_status == "done" && "bg-gray-500"
                      ]}></span>
                      <span class="kanban-column__label block w-full text-center font-mono font-bold uppercase">
                        {String.upcase(col_status)}
                      </span>
                    </div>

                    <span class="kanban-column__count rounded-full px-2 py-1 text-[10px] font-mono">
                      {length(col_tasks)}
                    </span>
                  </button>
                <% end %>
              <% end %>
            </div>
          </div>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanDrag">
            export default {
              mounted() {
                this.el.addEventListener('dragover', (e) => {
                  e.preventDefault();
                  this.el.classList.add('bg-[#1c2128]/50');
                });
                this.el.addEventListener('dragleave', () => {
                  this.el.classList.remove('bg-[#1c2128]/50');
                });
                this.el.addEventListener('drop', (e) => {
                  e.preventDefault();
                  this.el.classList.remove('bg-[#1c2128]/50');
                  const taskId = e.dataTransfer.getData('text/plain');
                  const targetStatus = this.el.getAttribute('data-status');
                  if (taskId && targetStatus) {
                    this.pushEvent('move_task', { id: taskId, status: targetStatus });
                  }
                });
              }
            }
          </script>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanCard">
            export default {
              mounted() {
                this.el.setAttribute('draggable', 'true');
                this.el.addEventListener('dragstart', (e) => {
                  e.dataTransfer.setData('text/plain', this.el.getAttribute('data-task-id'));
                });
              }
            }
          </script>
        <% end %>

        <!-- TAB 2: COACH & SWARM VIEW -->
        <%= if @active_tab == "swarm" do %>
          <div class="flex-1 flex flex-col h-full overflow-y-auto p-5 space-y-5">
            <.run_control_plane
              runs={@run_rows}
              run_count={@run_count}
              run_counts={@run_counts}
              selected_run={@selected_run}
              steps={@run_steps}
              events={@run_event_rows}
              approvals={@run_approvals}
              artifacts={@run_artifacts}
              controls={@run_controls}
              run_manifest={@run_manifest}
              stats={@run_dispatcher_stats}
              workspace_locks={@workspace_locks}
              agents={@streams.run_agents}
              agent_count={@run_agent_count}
              fleet_summary={@run_fleet_summary}
              fleet_loading={@run_fleet_loading?}
              agent_guidance={@run_agent_guidance}
              agent_receipts={@run_agent_receipts}
              dag_projection={@dag_projection}
            />

            <!-- Swarm Coach Hero Card -->
            <div class="bg-[#11151c] border border-[#21262d] rounded-3xl p-6 shadow-2xl relative overflow-hidden">
              <div class="mb-4 flex items-start gap-3 border border-amber-500/20 bg-amber-500/[0.05] px-3 py-2.5">
                <.icon name="hero-signal" class="mt-0.5 h-4 w-4 shrink-0 text-amber-300" />
                <div>
                  <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-amber-200">
                    Interactive session plane
                  </p>
                  <p class="mt-1 text-[11px] leading-5 text-gray-500">
                    These legacy session controls do not target the durable run selected above.
                    Use Mission Control for run-scoped pause, stop, retry, and steering.
                  </p>
                </div>
              </div>
              <div class="bg-[#161b22]/70 border border-[#21262d] rounded-2xl p-5 mb-4 relative">
                <!-- Status Badge Top Right -->
                <div class="absolute top-5 right-5 flex items-center gap-1.5 text-xs font-mono font-semibold">
                  <%= cond do %>
                    <% @session.status in ["running", :running] -> %>
                      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)] animate-pulse"></span>
                      <span class="text-emerald-400">ACTIVE (RUNNING)</span>
                    <% @session.status in ["paused", :paused] -> %>
                      <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.8)]"></span>
                      <span class="text-amber-400">PAUSED</span>
                    <% @session.status in ["failed", :failed] -> %>
                      <span class="w-2 h-2 rounded-full bg-rose-400 shadow-[0_0_8px_rgba(244,63,94,0.8)]"></span>
                      <span class="text-rose-400">FAILED</span>
                    <% @session.status in ["stopped", "cancelled", :stopped] -> %>
                      <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                      <span class="text-gray-400">STOPPED</span>
                    <% @session.status in ["completed", "done", :completed] -> %>
                      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]"></span>
                      <span class="text-emerald-400">COMPLETED</span>
                    <% true -> %>
                      <span class="w-2 h-2 rounded-full bg-gray-500"></span>
                      <span class="text-gray-400">IDLE</span>
                  <% end %>
                </div>

                <div class="flex items-start gap-4">
                  <!-- Pixel Avatar Graphic -->
                  <div class="w-16 h-16 rounded-2xl bg-gradient-to-b from-[#1c2128] to-[#11151c] border border-[#30363d] flex items-center justify-center text-3xl shadow-inner shrink-0 relative overflow-hidden">
                    <span class="animate-bounce">🧙‍♂️</span>
                    <div class="absolute bottom-1 left-2 right-2 h-1 bg-indigo-500/40 rounded-full blur-[1px]">
                    </div>
                  </div>

                  <!-- Name, Role & Connected Integrations -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3">
                      <h2 class="text-2xl font-bold text-white tracking-tight">
                        Milo
                      </h2>
                      <button
                        id="new-goal-button"
                        type="button"
                        phx-click="open_goal_modal"
                        class="px-3 py-1 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-full text-xs font-mono font-bold transition-smooth flex items-center gap-1 shadow-sm"
                      >
                        <.icon name="hero-plus" class="w-3.5 h-3.5" />
                        <span>New Goal</span>
                      </button>
                    </div>
                    <div class="text-xs font-mono text-gray-400 uppercase tracking-wider mb-3">
                      EXECUTIVE CODING HARNESS ASSISTANT
                    </div>

                    <!-- Native harness capabilities -->
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <.icon name="hero-command-line" class="h-3 w-3 text-cyan-400" />
                        Native terminal
                      </span>
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <.icon name="hero-calendar-days" class="h-3 w-3 text-blue-400" />
                        Scheduler
                      </span>
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <.icon name="hero-code-bracket-square" class="h-3 w-3 text-emerald-400" />
                        Git + tests
                      </span>
                      <span class="px-2 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-400 font-semibold">
                        SQLite journal
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Current Task & Tally Tick Progress Bar -->
                <div class="mt-6 pt-5 border-t border-dashed border-[#21262d]">
                  <div class="text-[10px] font-mono text-gray-400 uppercase tracking-wider mb-2.5">
                    CURRENT TASK · ITERATION {@swarm_iteration}/{@max_retries}
                  </div>

                  <% total_ops = length(@operations)

                  completed_ops =
                    Enum.count(@operations, &(&1.status in ["completed", "success"]))

                  coach_pct =
                    cond do
                      total_ops > 0 ->
                        round(completed_ops / total_ops * 100)

                      @swarm_iteration > 0 and @max_retries > 0 ->
                        round(@swarm_iteration / @max_retries * 100)

                      true ->
                        0
                    end

                  coach_active_ticks = min(65, max(0, round(coach_pct * 0.65))) %>
                  <!-- Tally Hash Vertical Tick Bar -->
                  <div class="tally-tick-bar mb-2.5">
                    <%= for tick <- 1..65 do %>
                      <div class={[
                        "tally-tick",
                        tick <= coach_active_ticks && "tally-tick-active-orange",
                        tick > coach_active_ticks && "bg-[#21262d]"
                      ]}>
                      </div>
                    <% end %>
                  </div>

                  <div class="flex items-center justify-between font-mono text-xs">
                    <span class="font-semibold text-white tracking-wide">
                      MULTI-AGENT SWARM HARNESS ACTIVE
                    </span>
                    <span class="text-gray-400">
                      {@session_tokens} TOKENS · {@current_latency_ms}ms · PID: {@active_worker_pid}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Footer Actions Row -->
              <div class="flex items-center justify-between pt-2 text-xs font-mono text-gray-400">
                <div class="flex items-center gap-3 relative">
                  <!-- Coach Menu Trigger -->
                  <div
                    class="relative"
                    phx-click-away={@open_dropdown == "coach_menu" && "close_dropdowns"}
                  >
                    <button
                      phx-click="toggle_coach_menu"
                      aria-haspopup="menu"
                      aria-expanded={@open_dropdown == "coach_menu"}
                      aria-label="Agent configuration menu"
                      class="p-1.5 rounded-lg hover:bg-[#161b22] text-gray-400 hover:text-white transition-smooth"
                      title="Agent Configuration Menu"
                    >
                      <.icon name="hero-ellipsis-vertical" class="w-4 h-4" />
                    </button>

                    <%= if @open_dropdown == "coach_menu" do %>
                      <div class="absolute left-0 bottom-full mb-2 w-48 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95 space-y-0.5">
                        <button
                          id="coach-create-goal-button"
                          type="button"
                          phx-click="open_goal_modal"
                          class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth text-left"
                        >
                          <.icon name="hero-flag" class="w-3.5 h-3.5 text-amber-400" />
                          <span>Create Goal</span>
                        </button>
                        <button
                          type="button"
                          phx-click="switch_tab"
                          phx-value-tab="terminal"
                          class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth text-left"
                        >
                          <.icon name="hero-command-line" class="w-3.5 h-3.5 text-cyan-400" />
                          <span>Open Terminal</span>
                        </button>
                        <button
                          type="button"
                          phx-click="clear_operations"
                          data-confirm="Clear this session's operation history?"
                          class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-rose-300 transition-smooth text-left"
                        >
                          <.icon name="hero-trash" class="w-3.5 h-3.5 text-rose-400" />
                          <span>Clear Ops</span>
                        </button>
                      </div>
                    <% end %>
                  </div>

                  <!-- Jump to Terminal -->
                  <button
                    phx-click="switch_tab"
                    phx-value-tab="terminal"
                    class="p-1.5 rounded-lg hover:bg-[#161b22] text-gray-400 hover:text-white transition-smooth"
                    title="Switch to Terminal Tab"
                  >
                    <.icon name="hero-command-line" class="w-4 h-4" />
                  </button>

                  <!-- Pause / Resume Control Button -->
                  <%= if @session.status in ["running", :running] do %>
                    <button
                      phx-click="pause_session"
                      class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 transition-smooth font-semibold"
                      title="Pause active execution without losing state"
                    >
                      <.icon name="hero-pause" class="w-3.5 h-3.5" />
                      <span>PAUSE</span>
                    </button>
                  <% else %>
                    <button
                      phx-click="resume_session"
                      class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 transition-smooth font-semibold"
                      title="Resume paused execution"
                    >
                      <.icon name="hero-play" class="w-3.5 h-3.5" />
                      <span>RESUME</span>
                    </button>
                  <% end %>

                  <!-- Stop / Cancel Trigger -->
                  <button
                    phx-click="open_cancel_modal"
                    class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/30 transition-smooth"
                    title="Stop session with rollback or commit"
                  >
                    <.icon name="hero-stop" class="w-3.5 h-3.5" />
                    <span>STOP</span>
                  </button>

                  <!-- Steering Input: mid-run guidance for the active swarm -->
                  <.form
                    for={to_form(%{"steering" => @steer_text})}
                    id="steering-form"
                    phx-submit="send_steering"
                    class="flex items-center gap-1.5 ml-1"
                  >
                    <input
                      type="text"
                      name="steering"
                      value={@steer_text}
                      placeholder="Steer the swarm..."
                      aria-label="Steering guidance for the active swarm"
                      class="w-44 px-2.5 py-1.5 rounded-xl bg-[#161b22] border border-[#21262d] text-xs font-mono text-white placeholder-gray-500 focus:outline-none focus:border-amber-500 transition-smooth"
                    />
                    <button
                      type="submit"
                      phx-disable-with="Sending..."
                      aria-label="Send steering guidance"
                      class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 transition-smooth font-semibold"
                    >
                      <.icon name="hero-paper-airplane" class="w-3.5 h-3.5" />
                      <span>STEER</span>
                    </button>
                  </.form>
                </div>

                <div class="flex items-center gap-3">
                  <span class="text-gray-500 text-[11px]">SESSION-SCOPED CONTROLS</span>
                  <button
                    phx-click="switch_tab"
                    phx-value-tab="kanban"
                    class="px-4 py-1.5 rounded-full border border-white/20 hover:bg-white/10 text-white text-xs font-medium transition-smooth"
                  >
                    View details
                  </button>
                </div>
              </div>
            </div>

            <%!-- Visible error state for failed operations --%>
            <% failed_ops = Enum.filter(@operations, &(&1.status == "failed")) %>
            <%= if failed_ops != [] do %>
              <div
                role="alert"
                class="flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-xs font-mono text-rose-300"
              >
                <.icon name="hero-exclamation-triangle" class="w-4 h-4 text-rose-400 shrink-0" />
                <span class="truncate">
                  {length(failed_ops)} operation{if length(failed_ops) == 1, do: "", else: "s"} failed
                  <%= latest_error = Enum.find_value(failed_ops, & &1.error_message)
                  if latest_error do %>
                    <span class="text-rose-400">· {latest_error}</span>
                  <% end %>
                </span>
              </div>
            <% end %>

            <div id="interactive-operation-history-note" class="border-l border-[#303844] pl-3">
              <p class="text-xs font-semibold text-gray-300">Interactive operation history</p>
              <p class="mt-1 text-[10px] leading-5 text-gray-600">
                Session-scoped tool activity is kept separate from the selected run's persisted fleet.
              </p>
            </div>
            <section
              id="interactive-role-templates"
              aria-labelledby="interactive-role-templates-heading"
            >
              <div class="mb-3 flex items-start gap-2 border border-blue-500/15 bg-blue-500/[0.03] px-3 py-2.5">
                <.icon
                  name="hero-information-circle"
                  class="mt-0.5 h-3.5 w-3.5 shrink-0 text-blue-300"
                />
                <div>
                  <h3
                    id="interactive-role-templates-heading"
                    class="text-[10px] font-semibold uppercase tracking-wider text-blue-200"
                  >
                    Interactive role templates
                  </h3>
                  <p class="mt-1 text-[10px] leading-5 text-gray-600">
                    Fixed session role templates show legacy operation telemetry only. Idle cards do not represent live or persisted workers.
                  </p>
                </div>
              </div>
              <.subagent_cards
                operations={@operations}
                active_agent={@active_agent}
                active_stage={@active_stage}
                swarm_mode={@session.swarm_mode}
              />
            </section>
            <.operation_tree
              operations={@operations}
              expanded_ops={@expanded_ops}
            />
          </div>
        <% end %>

        <!-- TAB 3: SCHEDULED TASKS & CALENDAR VIEW -->
        <%= if @active_tab == "calendar" do %>
          <div class="flex-1 flex flex-col h-full overflow-y-auto p-5 space-y-5">
            <!-- Centered Dark Calendar Container -->
            <div class="bg-[#11151c] border border-[#21262d] rounded-3xl p-6 shadow-2xl max-w-4xl w-full mx-auto">
              <!-- Calendar Header Row -->
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                  <h2 class="text-xl font-bold text-white tracking-tight font-sans">
                    {month_name(@calendar_month)}, {@calendar_year}
                  </h2>
                  <% today = Date.utc_today() %>
                  <button
                    phx-click="select_calendar_day"
                    phx-value-day={today.day}
                    phx-value-date={Date.to_iso8601(today)}
                    class="px-3 py-1 rounded-full bg-[#1c2128] border border-[#30363d] text-xs font-mono text-gray-300 hover:text-white transition-smooth"
                  >
                    Today
                  </button>
                  <div class="flex items-center gap-1 text-gray-400">
                    <button
                      phx-click="calendar_prev_month"
                      aria-label="Previous month"
                      class="p-1 rounded-lg hover:bg-[#1c2128] text-gray-400 hover:text-white transition-smooth"
                    >
                      <.icon name="hero-chevron-left" class="w-4 h-4" />
                    </button>
                    <button
                      phx-click="calendar_next_month"
                      aria-label="Next month"
                      class="p-1 rounded-lg hover:bg-[#1c2128] text-gray-400 hover:text-white transition-smooth"
                    >
                      <.icon name="hero-chevron-right" class="w-4 h-4" />
                    </button>
                  </div>
                </div>

                <!-- Header Actions -->
                <div class="flex items-center gap-2">
                  <button
                    id="calendar-focus-time-btn"
                    phx-click="open_time_picker"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#1c2128] hover:bg-[#21262d] border border-[#30363d] text-xs font-mono text-gray-300 hover:text-white transition-smooth"
                    title="Set focus time and availability window"
                  >
                    <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400" />
                    <span>Set Focus Time</span>
                  </button>

                  <!-- Primary Coral Plus Trigger -->
                  <button
                    phx-click="toggle_new_task_modal"
                    aria-label="Create a task for the selected day"
                    class="w-9 h-9 rounded-full bg-[#ff5e3a] hover:bg-[#ff4e24] text-white flex items-center justify-center shadow-lg shadow-orange-500/25 transition-smooth"
                    title="Schedule New Task"
                  >
                    <.icon name="hero-plus" class="w-5 h-5" />
                  </button>
                </div>
              </div>

              <!-- Day of Week Headers -->
              <div id="calendar-weekdays" class="grid grid-cols-7 gap-2 mb-2 text-center">
                <%= for day_name <- ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] do %>
                  <div
                    id={"calendar-weekday-#{String.downcase(day_name)}"}
                    class="py-1.5 rounded-xl bg-[#1c2128]/60 text-[10px] font-mono font-semibold text-gray-400 tracking-wider"
                  >
                    {day_name}
                  </div>
                <% end %>
              </div>

              <!-- Monthly Calendar Grid -->
              <div id="calendar-grid" class="grid grid-cols-7 gap-2">
                <%= for cell <- calendar_grid_cells(@calendar_year, @calendar_month, @selected_calendar_date) do %>
                  <% day_tasks =
                    if cell.is_current_month, do: tasks_for_day(@tasks, cell), else: []

                  date_str =
                    "#{cell.year}-#{String.pad_leading("#{cell.month}", 2, "0")}-#{String.pad_leading("#{cell.day}", 2, "0")}"

                  cell_id =
                    if cell.is_current_month,
                      do: "calendar-day-#{cell.day}",
                      else: "calendar-day-pad-#{cell.year}-#{cell.month}-#{cell.day}" %>
                  <div
                    id={cell_id}
                    class={[
                      "relative min-h-[76px] rounded-2xl p-2 transition-smooth flex flex-col justify-between group select-none",
                      cell.is_today &&
                        "bg-[#1c2128] border-2 border-[#ff5e3a] shadow-lg shadow-orange-500/10",
                      cell.is_selected && !cell.is_today &&
                        "bg-[#1c2128] border border-[#ff5e3a]/60",
                      !cell.is_today && !cell.is_selected && cell.is_current_month &&
                        "bg-[#161b22] border border-[#21262d] hover:border-[#38404a] hover:bg-[#1a2029]",
                      !cell.is_current_month &&
                        "bg-[#11151c]/40 border border-[#21262d]/50 text-gray-600"
                    ]}
                  >
                    <button
                      type="button"
                      id={"#{cell_id}-select"}
                      phx-click="select_calendar_day"
                      phx-value-day={cell.day}
                      phx-value-date={date_str}
                      aria-label={"Schedule task on #{date_str}"}
                      aria-pressed={cell.is_selected}
                      class="absolute inset-0 z-0 cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ff5e3a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#11151c]"
                      title={"Click to schedule task on #{date_str}"}
                    >
                      <span class="sr-only">Schedule task on {date_str}</span>
                    </button>

                    <!-- Day Header Row -->
                    <div class="relative z-[1] flex items-center justify-between pointer-events-none">
                      <span class={[
                        "font-mono text-xs",
                        cell.is_today && "font-bold text-[#ff5e3a]",
                        cell.is_current_month && !cell.is_today &&
                          "text-gray-400 group-hover:text-white",
                        !cell.is_current_month && "text-gray-600"
                      ]}>
                        {cell.day}
                      </span>
                      <%= if cell.is_today do %>
                        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"></span>
                      <% else %>
                        <%= if day_tasks != [] do %>
                          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_4px_rgba(168,85,247,0.6)]"></span>
                        <% end %>
                      <% end %>
                    </div>

                    <!-- Tasks on this Day -->
                    <div class="relative z-10 space-y-1 my-auto">
                      <%= for task <- day_tasks do %>
                        <button
                          type="button"
                          id={"calendar-task-#{cell.day}-#{task.id}"}
                          phx-click="show_scheduled_task"
                          phx-value-id={task.id}
                          class="w-full text-left py-0.5 px-1.5 rounded-lg bg-[#21262d] hover:bg-[#2c333d] border border-white/10 text-[10px] font-mono text-gray-200 transition-smooth flex items-center justify-between shadow-xs truncate"
                          title={task.title}
                        >
                          <span class="truncate font-semibold">{task.title}</span>
                          <span class="text-orange-400 text-[9px] shrink-0 ml-1">✦</span>
                        </button>
                      <% end %>
                    </div>

                    <!-- Day Subtitle / Status -->
                    <div class="relative z-[1] text-[9px] font-mono text-gray-500 pointer-events-none">
                      <%= if cell.is_today do %>
                        <span class="text-emerald-400 font-semibold">Live</span>
                      <% else %>
                        <%= if day_tasks == [] && cell.is_current_month do %>
                          <span class="opacity-0 group-hover:opacity-100 text-gray-400 transition-smooth">+ Add</span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Calendar Footer Bar -->
              <div class="mt-6 pt-4 border-t border-[#21262d] flex items-center justify-between text-xs font-mono text-gray-400">
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span>ONE-SHOT TIMER</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>CRON RECURRING</span>
                  </div>
                </div>

                <% scheduled_count = length(@tasks)

                active_count =
                  Enum.count(@tasks, &(&1.status in ["in_progress", "running", "scheduled"]))

                monthly_runs_count = max(scheduled_count * 12 + length(@operations), 1) %>
                <div class="flex items-center gap-6">
                  <span>{scheduled_count} SCHEDULED TASKS · {active_count} ACTIVE</span>
                  <span class="text-white font-semibold">MONTHLY RUNS: {monthly_runs_count}</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- TAB 4: CHANGES & 3-TIER GIT STAGING HUB -->
        <%= if @active_tab == "changes" do %>
          <div class="flex-1 flex flex-col h-full overflow-hidden">
            <!-- Top Git Branch & Sync Toolbar -->
            <div
              id="changes-toolbar"
              class="px-3 sm:px-4 py-2 border-b border-[#21262d] bg-[#11151c] flex flex-wrap items-center justify-between gap-2 shrink-0 font-mono text-xs"
            >
              <div class="flex min-w-0 items-center gap-2 sm:gap-3 relative">
                <!-- Branch Selector Button -->
                <div
                  class="relative"
                  phx-click-away={@show_branch_menu && "close_branch_menu"}
                >
                  <button
                    type="button"
                    phx-click="toggle_branch_menu"
                    class="flex items-center gap-2 px-3 py-1.5 bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] rounded-lg text-white font-medium transition-smooth"
                  >
                    <.icon name="hero-code-bracket-square" class="w-4 h-4 text-emerald-400" />
                    <span class="max-w-28 truncate sm:max-w-48">{@current_branch}</span>
                    <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400" />
                  </button>

                  <%= if @show_branch_menu do %>
                    <div class="absolute top-full left-0 mt-1.5 w-64 bg-[#161b22] border border-[#30363d] rounded-xl shadow-2xl p-2 z-50 space-y-2">
                      <div class="text-[11px] font-bold text-gray-400 uppercase tracking-wider px-2 py-1">
                        Branches ({length(@git_branches)})
                      </div>
                      <div class="max-h-48 overflow-y-auto space-y-0.5">
                        <%= for b <- @git_branches do %>
                          <button
                            type="button"
                            phx-click="switch_git_branch"
                            phx-value-branch={b.name}
                            class={[
                              "w-full flex items-center justify-between px-2 py-1.5 rounded-lg text-left text-xs transition-smooth",
                              b.current? && "bg-[#21262d] text-emerald-400 font-bold",
                              !b.current? && "text-gray-300 hover:bg-[#21262d] hover:text-white"
                            ]}
                          >
                            <span class="truncate">{b.name}</span>
                            <%= if b.current? do %>
                              <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                            <% end %>
                          </button>
                        <% end %>
                      </div>

                      <div class="pt-2 border-t border-[#21262d]">
                        <form phx-submit="create_git_branch" class="flex gap-1.5">
                          <input
                            type="text"
                            name="name"
                            placeholder="New branch name..."
                            class="flex-1 bg-[#0d1117] border border-[#30363d] rounded-lg px-2 py-1 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 font-mono"
                          />
                          <button
                            type="submit"
                            class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold"
                          >
                            Create
                          </button>
                        </form>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- Sync Metrics & Actions -->
                <div class="hidden sm:flex items-center gap-2 text-gray-400 text-[11px]">
                  <span>Ahead:
                  <strong class="text-white">{(@git_status && @git_status.ahead) || 0}</strong></span>
                  <span>·</span>
                  <span>Behind:
                  <strong class="text-white">{(@git_status && @git_status.behind) || 0}</strong></span>
                </div>
              </div>

              <div class="flex items-center gap-1.5 sm:gap-2">
                <button
                  type="button"
                  phx-click="git_fetch"
                  class="flex items-center gap-1.5 px-2.5 py-1 bg-[#161b22] hover:bg-[#21262d] border border-[#21262d] hover:border-[#30363d] text-gray-300 hover:text-white rounded-lg transition-smooth"
                  title="Fetch latest remote commits"
                >
                  <.icon name="hero-arrow-down-tray" class="w-3.5 h-3.5 text-cyan-400" />
                  <span class="hidden sm:inline">Fetch</span>
                </button>
                <button
                  type="button"
                  phx-click="git_pull"
                  class="flex items-center gap-1.5 px-2.5 py-1 bg-[#161b22] hover:bg-[#21262d] border border-[#21262d] hover:border-[#30363d] text-gray-300 hover:text-white rounded-lg transition-smooth"
                  title="Pull remote changes into local branch"
                >
                  <.icon name="hero-arrow-path" class="w-3.5 h-3.5 text-emerald-400" />
                  <span class="hidden sm:inline">Pull</span>
                </button>
              </div>
            </div>

            <!-- Main Changes Body: 3-Tier Staging Hub + Interactive Diff Viewer -->
            <div
              id="changes-layout"
              class="flex-1 flex min-h-0 flex-col overflow-hidden md:flex-row"
            >
              <!-- Left Column: 3-Tier Staging Hub & Commit Composer -->
              <div
                id="changes-staging-panel"
                class="h-[min(46%,24rem)] w-full border-b border-[#21262d] bg-[#11151c] flex shrink-0 flex-col overflow-hidden font-mono text-xs md:h-full md:w-84 md:border-r md:border-b-0"
              >
                <!-- Staging Header -->
                <div class="p-3 border-b border-[#21262d] flex items-center justify-between text-gray-400 font-semibold">
                  <div class="flex items-center gap-1.5">
                    <.icon name="hero-code-bracket" class="w-3.5 h-3.5 text-cyan-400" />
                    <span>All Changes</span>
                  </div>
                  <span class="text-[11px] text-gray-500">{length(@parsed_diffs)} files</span>
                </div>

                <!-- Staging Lists -->
                <div class="flex-1 overflow-y-auto p-3 space-y-4">
                  <!-- Tier 1: Staged Changes -->
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-gray-300 font-semibold pb-1 border-b border-[#21262d]">
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span>Staged Changes</span>
                        <span class="text-[10px] text-gray-500 font-normal">({length(
                          @staged_diffs
                        )})</span>
                      </div>
                      <%= if @staged_diffs != [] do %>
                        <button
                          type="button"
                          phx-click="unstage_all"
                          class="text-[10px] text-gray-400 hover:text-rose-400 transition-smooth"
                        >
                          Unstage All
                        </button>
                      <% end %>
                    </div>

                    <div class="space-y-0.5">
                      <%= for file_diff <- @staged_diffs do %>
                        <% path = file_diff.path || file_diff.new_path

                        is_selected =
                          @selected_diff_file == path and @active_diff_scope == :staged %>
                        <div class={[
                          "flex items-center justify-between py-1 px-2 rounded-lg group transition-smooth",
                          is_selected &&
                            "bg-[#21262d] text-white font-medium border border-[#30363d]",
                          !is_selected && "hover:bg-[#161b22] text-gray-300"
                        ]}>
                          <button
                            type="button"
                            phx-click="select_diff_file"
                            phx-value-file={path}
                            phx-value-scope="staged"
                            class="flex-1 flex items-center gap-2 truncate text-left"
                          >
                            <.icon
                              name="hero-document-text"
                              class="w-3.5 h-3.5 text-emerald-400 shrink-0"
                            />
                            <span class="truncate">{path}</span>
                          </button>
                          <div class="flex items-center gap-1 shrink-0">
                            <button
                              type="button"
                              phx-click="unstage_file"
                              phx-value-file={path}
                              class="p-1 text-gray-500 hover:text-rose-400 hover:bg-[#21262d] rounded transition-smooth"
                              title="Unstage file"
                            >
                              <.icon name="hero-minus" class="w-3 h-3" />
                            </button>
                          </div>
                        </div>
                      <% end %>
                      <%= if @staged_diffs == [] do %>
                        <div class="text-[11px] text-gray-500 italic py-1 px-2">
                          No staged changes
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- Tier 2: Unstaged Changes -->
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-gray-300 font-semibold pb-1 border-b border-[#21262d]">
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        <span>Unstaged Changes</span>
                        <span class="text-[10px] text-gray-500 font-normal">({length(
                          @unstaged_diffs
                        )})</span>
                      </div>
                      <%= if @unstaged_diffs != [] do %>
                        <button
                          type="button"
                          phx-click="stage_all"
                          class="text-[10px] text-gray-400 hover:text-emerald-400 transition-smooth"
                        >
                          Stage All
                        </button>
                      <% end %>
                    </div>

                    <div class="space-y-0.5">
                      <%= for file_diff <- @unstaged_diffs do %>
                        <% path = file_diff.path || file_diff.new_path

                        is_selected =
                          @selected_diff_file == path and @active_diff_scope == :unstaged %>
                        <div class={[
                          "flex items-center justify-between py-1 px-2 rounded-lg group transition-smooth",
                          is_selected &&
                            "bg-[#21262d] text-white font-medium border border-[#30363d]",
                          !is_selected && "hover:bg-[#161b22] text-gray-300"
                        ]}>
                          <button
                            type="button"
                            phx-click="select_diff_file"
                            phx-value-file={path}
                            phx-value-scope="unstaged"
                            class="flex-1 flex items-center gap-2 truncate text-left"
                          >
                            <.icon
                              name="hero-document-text"
                              class="w-3.5 h-3.5 text-amber-400 shrink-0"
                            />
                            <span class="truncate">{path}</span>
                          </button>
                          <div class="flex items-center gap-1 shrink-0">
                            <button
                              type="button"
                              phx-click="stage_file"
                              phx-value-file={path}
                              class="p-1 text-gray-500 hover:text-emerald-400 hover:bg-[#21262d] rounded transition-smooth"
                              title="Stage file"
                            >
                              <.icon name="hero-plus" class="w-3 h-3" />
                            </button>
                            <button
                              type="button"
                              phx-click="revert_file"
                              phx-value-file={path}
                              data-confirm={"Revert every uncommitted change in #{path}?"}
                              aria-label={"Revert changes to #{path}"}
                              class="p-1 text-gray-500 hover:text-rose-400 hover:bg-[#21262d] rounded transition-smooth"
                              title="Revert file changes"
                            >
                              <.icon name="hero-arrow-uturn-left" class="w-3 h-3" />
                            </button>
                          </div>
                        </div>
                      <% end %>
                      <%= if @unstaged_diffs == [] do %>
                        <div class="text-[11px] text-gray-500 italic py-1 px-2">
                          No unstaged changes
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <!-- Tier 3: Untracked Files -->
                  <% untracked = (@git_status && @git_status.untracked) || [] %>
                  <div
                    :if={@git_status && @git_status.truncated?}
                    id="git-status-truncated"
                    class="border border-amber-400/25 bg-amber-400/[0.06] px-2.5 py-2 text-[10px] leading-4 text-amber-200"
                  >
                    Status preview retained {@git_status.retained_paths} paths and is truncated.
                    Narrow the area with the terminal for omitted files.
                  </div>
                  <%= if untracked != [] do %>
                    <div class="space-y-1.5">
                      <div class="flex items-center justify-between text-gray-300 font-semibold pb-1 border-b border-[#21262d]">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                          <span>Untracked Files</span>
                          <span class="text-[10px] text-gray-500 font-normal">({length(untracked)})</span>
                        </div>
                      </div>

                      <div class="space-y-0.5">
                        <%= for file <- untracked do %>
                          <div class="flex items-center justify-between py-1 px-2 rounded-lg hover:bg-[#161b22] text-gray-400 group transition-smooth">
                            <div class="flex items-center gap-2 truncate">
                              <.icon
                                name="hero-question-mark-circle"
                                class="w-3.5 h-3.5 text-gray-500 shrink-0"
                              />
                              <span class="truncate">{file}</span>
                            </div>
                            <button
                              type="button"
                              phx-click="stage_file"
                              phx-value-file={file}
                              class="p-1 text-gray-500 hover:text-emerald-400 hover:bg-[#21262d] rounded transition-smooth"
                              title="Stage untracked file"
                            >
                              <.icon name="hero-plus" class="w-3 h-3" />
                            </button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <% canvas_files =
                    cond do
                      @parsed_diffs != [] ->
                        Enum.map(
                          @parsed_diffs,
                          &(Map.get(&1, :path) || Map.get(&1, :file_path) || to_string(&1))
                        )

                      @project_files != [] ->
                        Enum.take(@project_files, 4)

                      true ->
                        []
                    end %>
                  <div class="mt-4 pt-3 border-t border-[#21262d]">
                    <div class="text-xs font-semibold text-gray-400 mb-2">
                      Canvas · {length(canvas_files)}
                    </div>
                    <div class="space-y-1 text-[11px]">
                      <%= for file <- canvas_files do %>
                        <div
                          class="p-2 bg-[#161b22] rounded text-gray-300 truncate font-mono"
                          title={file}
                        >
                          {file}
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>

                <!-- Commit Composer Card -->
                <div class="p-3 border-t border-[#21262d] bg-[#0d1117] space-y-2 shrink-0">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-300">Commit Changes</span>
                    <button
                      type="button"
                      phx-click="generate_commit_msg"
                      class="flex items-center gap-1 text-[11px] text-purple-400 hover:text-purple-300 transition-smooth font-medium"
                      title="AI Generate commit message from staged changes"
                    >
                      <.icon name="hero-sparkles" class="w-3 h-3" />
                      <span>✨ AI Generate</span>
                    </button>
                  </div>

                  <form
                    id="commit-composer-form"
                    phx-change="update_commit_message"
                    phx-submit="git_commit"
                    class="space-y-2"
                  >
                    <textarea
                      name="message"
                      rows="3"
                      placeholder="Commit message (e.g. feat(editor): add jump to symbol)..."
                      class="w-full bg-[#161b22] border border-[#21262d] rounded-lg p-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 font-mono resize-none"
                    >{@commit_message}</textarea>

                    <button
                      type="submit"
                      disabled={String.trim(@commit_message || "") == "" or @staged_diffs == []}
                      class={[
                        "w-full py-1.5 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-smooth",
                        (String.trim(@commit_message || "") != "" and @staged_diffs != []) &&
                          "bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm cursor-pointer",
                        (String.trim(@commit_message || "") == "" or @staged_diffs == []) &&
                          "bg-[#21262d] text-gray-500 cursor-not-allowed"
                      ]}
                    >
                      <.icon name="hero-check" class="w-3.5 h-3.5" />
                      <span>Commit to {@current_branch} ({length(@staged_diffs)} staged)</span>
                    </button>
                  </form>
                </div>
              </div>

              <!-- Right Interactive Diff Viewer -->
              <div
                id="changes-diff-panel"
                class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-[#0a0d12] p-2 sm:p-3"
              >
                <div
                  :if={@diff_truncated?}
                  id="diff-preview-truncated"
                  class="mb-2 flex items-center gap-2 border border-amber-400/30 bg-amber-400/[0.07] px-3 py-2 font-mono text-[10px] text-amber-200"
                >
                  <.icon name="hero-exclamation-triangle" class="h-3.5 w-3.5 shrink-0" />
                  Preview capped at 2 MiB. The repository content is unchanged; open the file or
                  use Git locally for the complete diff.
                </div>
                <.interactive_diff_viewer
                  diff_text={@diff_text}
                  diff_mode={@diff_mode}
                  file_path={@diff_file_path}
                  hunks={@diff_hunks}
                  staged={@active_diff_scope == :staged}
                />
              </div>
            </div>
          </div>
        <% end %>

        <!-- DEDICATED DEEP RESEARCH WORKSPACE -->
        <%= if @active_tab == "research" do %>
          <% level = research_level_semantics(@research_launch_level) %>
          <div id="deep-research-page" class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="mx-auto max-w-7xl space-y-5">
              <header class="flex flex-col gap-5 border-b border-[#252c35] pb-6 lg:flex-row lg:items-end lg:justify-between">
                <div class="max-w-3xl">
                  <div class="mb-2 flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-300">
                    <span class="h-1.5 w-1.5 bg-violet-400"></span> Evidence workspace
                  </div>
                  <h2 class="text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl">
                    Deep research, without hidden work.
                  </h2>
                  <p class="mt-3 max-w-[68ch] text-sm leading-6 text-gray-400">
                    Define an exact bounded investigation, attach prior research, and keep the
                    requested execution contract visible before any work begins.
                  </p>
                </div>
                <.link
                  id="research-open-settings"
                  navigate={~p"/sessions/#{@session.id}/settings#providers"}
                  class="inline-flex min-h-11 items-center justify-center gap-2 border border-[#303844] bg-[#11161d] px-4 font-mono text-[10px] font-semibold uppercase tracking-wider text-gray-300 transition-colors hover:border-violet-400/40 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-400/60"
                >
                  <.icon name="hero-adjustments-horizontal" class="h-4 w-4 text-violet-300" />
                  Provider settings
                </.link>
              </header>

              <div class="grid gap-5 xl:grid-cols-[minmax(0,1.15fr)_minmax(22rem,0.85fr)]">
                <.form
                  for={@research_form}
                  id="deep-research-form"
                  phx-change="update_research_launch"
                  phx-submit="submit_deep_research"
                  class="min-w-0 border border-[#29313a] bg-[#0d1218] p-4 sm:p-5"
                >
                  <input
                    id="deep-research-request-id"
                    type="hidden"
                    name="research[request_id]"
                    value={@research_form[:request_id].value}
                  />
                  <div class="mb-5 flex items-center justify-between gap-4">
                    <div>
                      <h3 class="text-base font-semibold text-white">Research brief</h3>
                      <p class="mt-1 text-xs leading-5 text-gray-500">
                        Queued as a durable finite DAG with exact level limits.
                      </p>
                    </div>
                    <span class="border border-violet-500/20 bg-violet-500/[0.05] px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-violet-300">
                      async · durable
                    </span>
                  </div>

                  <.input
                    field={@research_form[:objective]}
                    id="deep-research-objective"
                    type="textarea"
                    rows="5"
                    label="What should I investigate?"
                    placeholder="Compare evidence, identify disagreements, and recommend a defensible implementation…"
                    required
                    class="block min-h-32 w-full resize-y border border-[#303844] bg-[#090d12] px-3 py-2.5 text-sm leading-6 text-gray-100 outline-none transition-colors placeholder:text-gray-700 focus:border-violet-500/60 focus-visible:ring-2 focus-visible:ring-violet-400/30"
                  />

                  <fieldset id="deep-research-levels" class="mt-5">
                    <legend class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-gray-400">
                      Research level
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                      <label
                        :for={
                          {level_name, title, contract} <- [
                            {"low", "Low", "1 round · 2-way query fanout"},
                            {"medium", "Medium", "2 rounds · 3-way query fanout"},
                            {"high", "High", "3 rounds · 4-way query fanout"},
                            {"ultra", "Ultra", "4 rounds · 10-way query fanout"}
                          ]
                        }
                        class={[
                          "cursor-pointer border p-3 transition-colors focus-within:outline-none focus-within:ring-2 focus-within:ring-violet-300/70",
                          @research_launch_level == level_name &&
                            "border-violet-400/50 bg-violet-500/[0.07]",
                          @research_launch_level != level_name &&
                            "border-[#303844] bg-[#10151b] hover:border-[#46515e]"
                        ]}
                        data-level={level_name}
                        data-subagents={research_level_semantics(level_name).subagents}
                        data-rounds={research_level_semantics(level_name).rounds}
                        data-query-fanout={research_level_semantics(level_name).subagents}
                      >
                        <input
                          id={"deep-research-level-#{level_name}"}
                          type="radio"
                          name="research[level]"
                          value={level_name}
                          checked={@research_launch_level == level_name}
                          class="sr-only"
                        />
                        <span class="block text-sm font-semibold text-gray-100">{title}</span>
                        <span class="mt-1 block font-mono text-[9px] uppercase tracking-wider text-gray-500">
                          {contract}
                        </span>
                      </label>
                    </div>
                  </fieldset>

                  <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    <div class="border border-[#29313a] bg-[#10151b] px-3 py-2.5">
                      <p class="font-mono text-[9px] uppercase tracking-wider text-gray-600">
                        Requested rounds
                      </p>
                      <p class="mt-1 text-xs text-gray-300">
                        {level.rounds} sequential evidence rounds
                      </p>
                    </div>
                    <div class="border border-[#29313a] bg-[#10151b] px-3 py-2.5">
                      <p class="font-mono text-[9px] uppercase tracking-wider text-gray-600">
                        Per-search-step query fanout
                      </p>
                      <p class="mt-1 text-xs text-gray-300">
                        Up to {level.subagents} bounded asynchronous queries
                      </p>
                    </div>
                  </div>

                  <div class="mt-5 grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
                    <.input
                      field={@research_form[:max_sources]}
                      id="deep-research-max-sources"
                      type="number"
                      min="1"
                      max="40"
                      label="Maximum sources"
                      value={@research_launch_sources}
                      class="block min-h-11 w-full border border-[#303844] bg-[#090d12] px-3 py-2 text-sm text-gray-100 outline-none focus:border-violet-500/60"
                    />
                    <div>
                      <div class="flex items-center justify-between gap-3">
                        <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-gray-400">
                          Ranked providers
                        </p>
                        <span class="font-mono text-[9px] text-gray-600">
                          {length(@research_launch_providers)} selected
                        </span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-2">
                        <label
                          :for={provider <- @settings.search_provider_order || ["duckduckgo"]}
                          class={[
                            "inline-flex min-h-9 items-center gap-2 border border-[#303844] bg-[#10151b] px-2.5 font-mono text-[9px]",
                            research_provider_selectable?(@settings, provider) &&
                              "cursor-pointer text-gray-400",
                            !research_provider_selectable?(@settings, provider) &&
                              "cursor-not-allowed text-gray-700 opacity-60"
                          ]}
                          title={
                            if research_provider_selectable?(@settings, provider),
                              do: "Include #{provider}",
                              else: "Enable and configure #{provider} in Provider settings"
                          }
                        >
                          <input
                            type="hidden"
                            name={"research[providers][#{provider}]"}
                            value="false"
                          />
                          <input
                            id={"deep-research-provider-#{provider}"}
                            type="checkbox"
                            name={"research[providers][#{provider}]"}
                            value="true"
                            checked={provider in @research_launch_providers}
                            disabled={!research_provider_selectable?(@settings, provider)}
                            class="h-3.5 w-3.5 accent-violet-400"
                          />
                          {String.replace(provider, "_", " ")}
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 border border-[#29313a] bg-[#0a0f14] p-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-gray-400">
                          Prior research
                        </p>
                        <p class="mt-1 text-[11px] leading-5 text-gray-600">
                          Attach up to 12 ready results from this session by public result number.
                        </p>
                      </div>
                      <button
                        id="deep-research-attachment-picker-toggle"
                        type="button"
                        phx-click="toggle_research_attachment_picker"
                        aria-expanded={@research_attachment_picker_open?}
                        aria-controls="deep-research-attachment-picker"
                        class="inline-flex min-h-10 items-center gap-2 border border-[#303844] px-3 font-mono text-[9px] uppercase tracking-wider text-gray-300 hover:border-violet-400/40"
                      >
                        <.icon name="hero-paper-clip" class="h-3.5 w-3.5 text-violet-300" />
                        Attach ready results
                      </button>
                    </div>
                    <div
                      :if={MapSet.size(@research_attachments) > 0}
                      class="mt-3 flex flex-wrap gap-1.5"
                    >
                      <span
                        :for={
                          public_id <- @research_attachments |> MapSet.to_list() |> Enum.sort()
                        }
                        class="max-w-full truncate border border-violet-500/20 bg-violet-500/[0.05] px-2 py-1 font-mono text-[9px] text-violet-200"
                        title={"Ready research result ##{public_id}"}
                      >
                        /deep_research {public_id}
                      </span>
                      <button
                        type="button"
                        phx-click="clear_research_attachments"
                        class="px-2 py-1 font-mono text-[9px] text-gray-500 hover:text-white"
                      >
                        Clear
                      </button>
                    </div>
                    <div
                      :if={@research_attachment_picker_open?}
                      id="deep-research-attachment-picker"
                      class="mt-3 max-h-52 overflow-y-auto border-t border-[#29313a] pt-2"
                    >
                      <p
                        :if={@research_results == []}
                        class="py-5 text-center text-xs text-gray-600"
                      >
                        No ready research results in this session.
                      </p>
                      <button
                        :for={result <- Enum.take(@research_results, 200)}
                        id={"deep-research-attachment-#{research_result_public_id(result)}"}
                        type="button"
                        phx-click="toggle_research_attachment"
                        phx-value-id={research_result_public_id(result)}
                        aria-pressed={
                          MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          )
                        }
                        class={[
                          "flex min-h-9 w-full items-center gap-2 px-2 text-left font-mono text-[10px] transition-colors",
                          MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          ) &&
                            "bg-violet-500/[0.08] text-violet-200",
                          !MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          ) &&
                            "text-gray-500 hover:bg-[#151b22] hover:text-gray-200"
                        ]}
                      >
                        <.icon name="hero-document-text" class="h-3.5 w-3.5 shrink-0" />
                        <span class="shrink-0 text-violet-300">
                          #{research_result_public_id(result)}
                        </span>
                        <span class="truncate">{research_result_label(result)}</span>
                        <span class="ml-auto shrink-0 text-[9px] uppercase tracking-wider text-gray-600">
                          {Map.get(result, :level)} · {Map.get(result, :source_count, 0)} sources
                        </span>
                      </button>
                    </div>
                  </div>

                  <button
                    id="deep-research-submit"
                    type="submit"
                    phx-disable-with="Checking availability…"
                    class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 bg-violet-400 px-5 font-mono text-[11px] font-semibold uppercase tracking-wider text-[#0b0d12] transition-colors hover:bg-violet-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-300/70"
                  >
                    <.icon name="hero-arrow-up-right" class="h-4 w-4" /> Queue deep research
                  </button>
                </.form>

                <aside class="min-w-0 space-y-4">
                  <section
                    id="deep-research-semantics"
                    class="border border-[#29313a] bg-[#0d1218] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-semibold text-white">Exact execution semantics</h3>
                      <span class="border border-amber-400/25 bg-amber-400/[0.06] px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-amber-200">
                        active
                      </span>
                    </div>
                    <p class="mt-3 text-[11px] leading-5 text-gray-400">
                      Each named level creates an immutable finite research graph. Every step
                      records one logical lead; ranked and grounded search steps supervise bounded
                      asynchronous query tasks. Durable provider intents prevent ambiguous
                      paid-call replay.
                    </p>
                    <dl class="mt-4 grid grid-cols-2 gap-px border border-[#29313a] bg-[#29313a]">
                      <div class="bg-[#10151b] p-3">
                        <dt class="font-mono text-[9px] uppercase tracking-wider text-gray-600">
                          Rounds
                        </dt>
                        <dd class="mt-1 text-lg font-semibold text-gray-100">{level.rounds}</dd>
                      </div>
                      <div class="bg-[#10151b] p-3">
                        <dt class="font-mono text-[9px] uppercase tracking-wider text-gray-600">
                          Search-step query fanout
                        </dt>
                        <dd class="mt-1 text-lg font-semibold text-gray-100">
                          {level.subagents}
                        </dd>
                      </div>
                    </dl>
                    <div class="mt-4 border border-[#29313a] bg-[#0a0f14] p-3 text-[10px] leading-5 text-gray-500">
                      The composer, <code class="text-gray-300">/research</code>, and this page
                      all queue the exact finite DAG. Existing persisted legacy runs keep their
                      fixed-stage execution history without being reinterpreted.
                    </div>
                    <div class="mt-4 border-t border-[#29313a] pt-3 text-[10px] leading-5 text-amber-200/70">
                      Stage cards are observational. Pause, resume, cancel, and retry remain run-scoped
                      and generation-fenced in Mission Control. Immutable DAG runs cannot be steered.
                    </div>
                  </section>

                  <section
                    id="deep-research-run-list"
                    class="border border-[#29313a] bg-[#0d1218] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-semibold text-white">Recent investigations</h3>
                      <span class="font-mono text-[10px] text-gray-600">{length(@research_runs)}</span>
                    </div>
                    <div :if={@research_runs == []} class="py-8 text-center text-xs text-gray-600">
                      No research runs in this session.
                    </div>
                    <button
                      :for={run <- Enum.take(@research_runs, 8)}
                      id={"deep-research-run-#{run.id}"}
                      type="button"
                      phx-click="open_research_run"
                      phx-value-id={run.id}
                      class="mt-2 w-full border border-[#29313a] bg-[#10151b] p-3 text-left transition-colors hover:border-violet-400/30"
                    >
                      <div class="flex items-center justify-between gap-3">
                        <span class="font-mono text-[9px] uppercase tracking-wider text-violet-300">{run.status}</span>
                        <span class="font-mono text-[9px] tabular-nums text-gray-600">{run.progress ||
                          0}%</span>
                      </div>
                      <p class="mt-2 line-clamp-2 text-xs leading-5 text-gray-300">
                        {run.objective}
                      </p>
                    </button>
                  </section>

                  <section
                    id="deep-research-ready-results"
                    class="border border-[#29313a] bg-[#0d1218] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <div>
                        <h3 class="text-sm font-semibold text-white">Ready reports</h3>
                        <p class="mt-1 text-[10px] leading-5 text-gray-600">
                          Checksum-verified Markdown and self-contained HTML.
                        </p>
                      </div>
                      <span class="font-mono text-[10px] text-gray-600">
                        {length(@research_results)}
                      </span>
                    </div>

                    <div
                      :if={@research_results == []}
                      class="py-8 text-center text-xs text-gray-600"
                    >
                      Completed reports will appear here with an integer result number.
                    </div>

                    <article
                      :for={result <- Enum.take(@research_results, 12)}
                      id={"deep-research-result-#{research_result_public_id(result)}"}
                      class="mt-3 border border-[#29313a] bg-[#10151b] p-3"
                    >
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="font-mono text-[9px] uppercase tracking-wider text-violet-300">
                            Result #{research_result_public_id(result)} · {Map.get(result, :level)}
                          </p>
                          <p class="mt-1 line-clamp-2 text-xs leading-5 text-gray-300">
                            {research_result_label(result)}
                          </p>
                        </div>
                        <span class="shrink-0 font-mono text-[9px] text-gray-600">
                          {Map.get(result, :source_count, 0)} src
                        </span>
                      </div>
                      <div class="mt-3 grid grid-cols-3 gap-1.5">
                        <.link
                          id={"deep-research-result-open-#{research_result_public_id(result)}"}
                          href={~p"/research/#{research_result_public_id(result)}/report"}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex min-h-9 items-center justify-center gap-1 border border-violet-400/30 bg-violet-500/[0.06] px-2 font-mono text-[9px] uppercase tracking-wider text-violet-200 hover:border-violet-300/60"
                        >
                          <.icon name="hero-arrow-top-right-on-square" class="h-3 w-3" /> Open
                        </.link>
                        <.link
                          id={"deep-research-result-html-#{research_result_public_id(result)}"}
                          href={
                            ~p"/research/#{research_result_public_id(result)}/report/download"
                          }
                          class="inline-flex min-h-9 items-center justify-center gap-1 border border-[#303844] px-2 font-mono text-[9px] uppercase tracking-wider text-gray-400 hover:text-white"
                        >
                          <.icon name="hero-arrow-down-tray" class="h-3 w-3" /> HTML
                        </.link>
                        <.link
                          id={"deep-research-result-md-#{research_result_public_id(result)}"}
                          href={
                            ~p"/research/#{research_result_public_id(result)}/result/download"
                          }
                          class="inline-flex min-h-9 items-center justify-center gap-1 border border-[#303844] px-2 font-mono text-[9px] uppercase tracking-wider text-gray-400 hover:text-white"
                        >
                          <.icon name="hero-document-arrow-down" class="h-3 w-3" /> MD
                        </.link>
                      </div>
                    </article>
                  </section>
                </aside>
              </div>
            </div>
          </div>
        <% end %>

        <!-- TAB: CHAT WITH SCROLL ASSISTANT MINIMAP -->
        <%= if @active_tab == "chat" do %>
          <div class="flex-1 flex h-full overflow-hidden relative">
            <!-- Left Rail: Chat Scroll Assistant Minimap & Hover Preview Cards -->
            <div class="w-12 pl-2.5 py-6 shrink-0 flex flex-col items-start z-30 select-none border-r border-[#21262d]/40">
              <div class="scroll-assistant-rail">
                <div class="scroll-timeline-track" id="chat-timeline-track">
                  <%= for {msg, idx} <- Enum.with_index(@messages) do %>
                    <% msg_id = msg.id || "msg-#{idx}"
                    is_user = msg.role == "user"

                    preview_title =
                      if is_user,
                        do:
                          msg.content |> String.split("\n") |> List.first() |> String.slice(0, 40),
                        else: msg.agent_name || "Assistant Response"

                    preview_snippet = msg.content |> String.slice(0, 140) %>
                    <button
                      type="button"
                      id={"scroll-node-#{msg_id}"}
                      class={[
                        "scroll-timeline-node group",
                        idx == 0 && "is-active"
                      ]}
                      data-target-msg-id={msg_id}
                      phx-click="scroll_to_msg"
                      phx-value-id={msg_id}
                      aria-label={"Jump to message ##{idx + 1}"}
                      title={"Jump to message ##{idx + 1}"}
                    >
                      <!-- Timeline Tick / Notch -->
                      <span class={[
                        "scroll-notch",
                        is_user && "scroll-notch-landmark"
                      ]}></span>

                      <!-- Hover Floating Preview Card -->
                      <span class="scroll-preview-card">
                        <span class="flex items-center justify-between mb-1.5 pb-1 border-b border-white/10">
                          <span class="text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider flex items-center gap-1.5">
                            <span class={[
                              "w-1.5 h-1.5 rounded-full",
                              is_user && "bg-blue-400",
                              !is_user && "bg-purple-400"
                            ]}></span>
                            {if is_user, do: "User Prompt", else: msg.agent_name || "Assistant"}
                          </span>
                          <span class="text-[9px] font-mono text-gray-500">#{idx + 1}</span>
                        </span>
                        <span class="block text-xs font-semibold text-white tracking-tight leading-snug mb-1 truncate">
                          {preview_title}
                        </span>
                        <span class="block text-[11px] font-sans text-gray-400 line-clamp-3 leading-relaxed">
                          {preview_snippet}
                        </span>
                      </span>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Main Chat Messages Viewport -->
            <div
              id="chat-viewport"
              phx-hook=".ChatScrollAssistant"
              class="flex-1 flex flex-col h-full overflow-y-auto p-6 space-y-6 scroll-smooth"
            >
              <button
                :if={@messages_more?}
                id="load-older-messages"
                type="button"
                phx-click="load_older_messages"
                class="mx-auto flex items-center gap-1.5 rounded-lg border border-[#30363d] bg-[#11151c] px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-wider text-gray-300 transition-smooth hover:border-cyan-500/50 hover:text-cyan-200"
              >
                <.icon name="hero-arrow-up" class="h-3.5 w-3.5" /> Load older messages
              </button>
              <div
                :if={@messages == []}
                id="chat-empty-state"
                class="m-auto flex max-w-md flex-col items-center px-6 py-12 text-center"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#30363d] bg-[#11151c] text-gray-400 shadow-lg shadow-black/20">
                  <.icon name="hero-chat-bubble-left-right" class="h-5 w-5" />
                </span>
                <h3 class="mt-4 text-sm font-semibold text-gray-100">
                  Start with a clean conversation
                </h3>
                <p class="mt-2 text-xs leading-5 text-gray-400">
                  No fabricated history is added to a new session. Send a prompt below when you
                  are ready to begin.
                </p>
              </div>

              <%= for {msg, idx} <- Enum.with_index(@messages) do %>
                <% msg_id = msg.id || "msg-#{idx}"
                is_user = msg.role == "user" %>
                <div
                  id={"chat-msg-#{msg_id}"}
                  data-chat-msg-id={msg_id}
                  class={[
                    "w-full max-w-3xl transition-smooth group",
                    is_user && "ml-auto",
                    !is_user && "mr-auto"
                  ]}
                >
                  <!-- Message Bubble -->
                  <div class={[
                    "p-5 rounded-2xl border text-xs shadow-md transition-smooth",
                    is_user && "bg-[#161b22] border-[#30363d] text-white",
                    !is_user && "bg-[#11151c] border-[#21262d] text-gray-200"
                  ]}>
                    <!-- Bubble Header -->
                    <div class="flex items-center justify-between mb-2 text-[11px] font-mono text-gray-400 pb-1.5 border-b border-white/5">
                      <div class="flex items-center gap-2">
                        <span class={[
                          "w-2 h-2 rounded-full",
                          is_user && "bg-blue-400",
                          !is_user && "bg-emerald-400"
                        ]}></span>
                        <span class="font-bold text-gray-300 uppercase tracking-wider">{msg.agent_name ||
                          msg.role}</span>
                      </div>
                      <span class="text-gray-500 text-[10px]">#{idx + 1}</span>
                    </div>

                    <!-- Message Body with Reasoning & Markdown -->
                    <%= if !is_user and msg.metadata && msg.metadata["reasoning"] do %>
                      <.thinking_trace
                        reasoning={msg.metadata["reasoning"]}
                        duration_ms={msg.metadata["duration_ms"]}
                      />
                    <% end %>

                    <.markdown_content content={msg.content} />

                    <!-- Bubble Footer Action Bar -->
                    <div class="flex items-center gap-3 pt-3 mt-3 border-t border-white/5 text-gray-500">
                      <button
                        id={"copy-msg-btn-#{msg_id}"}
                        phx-hook="CodeCopy"
                        data-code={msg.content}
                        aria-label={"Copy message ##{idx + 1}"}
                        class="hover:text-gray-300 p-1 rounded transition-smooth"
                        title="Copy to clipboard"
                      >
                        <.icon name="hero-clipboard" class="w-3.5 h-3.5" />
                      </button>
                      <button
                        phx-click="expand_message"
                        phx-value-id={msg_id}
                        aria-label={"Expand message ##{idx + 1}"}
                        class="hover:text-gray-300 p-1 rounded transition-smooth"
                        title="Expand message"
                      >
                        <.icon name="hero-arrows-pointing-out" class="w-3.5 h-3.5" />
                      </button>
                    </div>
                  </div>
                </div>
              <% end %>
              <button
                :if={@messages_newer?}
                id="load-newer-messages"
                type="button"
                phx-click="load_newer_messages"
                class="mx-auto flex items-center gap-1.5 rounded-lg border border-[#30363d] bg-[#11151c] px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-wider text-gray-300 transition-smooth hover:border-cyan-500/50 hover:text-cyan-200"
              >
                Load newer messages <.icon name="hero-arrow-down" class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".ChatScrollAssistant">
            export default {
              mounted() {
                const container = this.el;
                const updateActiveNotch = () => {
                  const messages = container.querySelectorAll('[data-chat-msg-id]');
                  let activeId = null;
                  const containerRect = container.getBoundingClientRect();

                  messages.forEach(msg => {
                    const rect = msg.getBoundingClientRect();
                    if (rect.top <= containerRect.top + 200 && rect.bottom >= containerRect.top) {
                      activeId = msg.getAttribute('data-chat-msg-id');
                    }
                  });

                  if (activeId) {
                    document.querySelectorAll('.scroll-timeline-node').forEach(node => {
                      if (node.getAttribute('data-target-msg-id') === activeId) {
                        node.classList.add('is-active');
                      } else {
                        node.classList.remove('is-active');
                      }
                    });
                  }
                };

                container.addEventListener('scroll', updateActiveNotch, { passive: true });
                updateActiveNotch();

                this.handleEvent('scroll_to_msg', ({ id }) => {
                  const target = document.getElementById('chat-msg-' + id);
                  if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  }
                });
              }
            }
          </script>
        <% end %>

        <!-- TAB 6: FILES TREE EXPLORER & INLINE CODE EDITOR -->
        <%= if @active_tab == "files" do %>
          <.file_explorer
            files={@project_files}
            more_files={@files_more?}
            filter={@file_filter}
            filter_form={@file_filter_form}
            expanded_folders={@expanded_folders}
            selected_file={@selected_file}
            file_content={@file_content}
            dirty_content={@dirty_content}
            is_dirty={@is_dirty?}
            open_buffers={@open_buffers}
            editor_lock={editor_lock(assigns)}
            auto_save={@settings.auto_save == true}
          />
        <% end %>

        <!-- TAB 7: TERMINAL SESSION RUNNER -->
        <div class={[
          "flex-1 flex flex-col h-full bg-[#0a0d12] overflow-hidden",
          @active_tab != "terminal" && "hidden"
        ]}>
          <.terminal_session
            session={@session}
            running={@terminal_running?}
            status={@terminal_status}
            shell={@terminal_shell}
            cols={@terminal_cols}
            rows={@terminal_rows}
            occupant={@terminal_occupant}
            active_cmd={@terminal_active_cmd}
            output={@terminal_output}
            form={@terminal_form}
            workspace_locks={@workspace_locks}
          />
        </div>

        <%!-- RIGHT TASK DETAIL DRAWER / INSPECTOR --%>
        <%= if @show_task_drawer and @selected_task do %>
          <aside
            id="task-detail-drawer"
            phx-hook="ResponsiveSheet"
            aria-label="Task details"
            tabindex="-1"
            data-sheet-close-event="close_task_drawer"
            data-sheet-return-id={"task-card-#{@selected_task.id}"}
            data-sheet-background-id="kanban-board"
            class={["sf-task-detail-drawer absolute inset-y-0 right-0 z-40 flex h-full w-full max-w-none flex-col overflow-y-auto border-l border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] shadow-[0_24px_72px_-38px_var(--sf-shadow)] transition-smooth animate-in slide-in-from-right xl:relative xl:z-auto xl:w-96 xl:max-w-96 xl:shrink-0 xl:shadow-none"]}
          >
            <%!-- Drawer Header --%>
            <div class={["sf-task-detail-header flex items-center justify-between border-b border-[var(--sf-hairline)] p-4"]}>
              <div class="flex items-center gap-2">
                <span class={[
                  "sf-pill flex items-center gap-1.5 px-2 py-0.5 font-mono text-[10px] font-bold uppercase",
                  @selected_task.status == "running" &&
                    "border-[var(--sf-success-mark)] text-[var(--sf-success-text)]",
                  @selected_task.status != "running" &&
                    "text-[var(--sf-text-secondary)]"
                ]}>
                  <span class={[
                    "h-1.5 w-1.5 rounded-full",
                    @selected_task.status == "running" && "bg-[var(--sf-success-mark)]",
                    @selected_task.status != "running" && "bg-[var(--sf-text-secondary)]"
                  ]}></span>
                  {@selected_task.status}
                </span>
                <h2
                  id="task-detail-title"
                  class={["text-sm font-semibold text-[var(--sf-text-primary)]"]}
                >
                  Task details
                </h2>
                <span class={["font-mono text-xs text-[var(--sf-text-secondary)]"]}>#{String.slice(
                  @selected_task.id,
                  0..5
                )}</span>
              </div>
              <button
                id="close-task-detail-drawer"
                type="button"
                phx-click="close_task_drawer"
                aria-label="Close task drawer"
                class={["sf-control inline-flex min-h-11 min-w-11 items-center justify-center p-2"]}
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>

            <!-- Drawer Body -->
            <div class="p-5 space-y-5 flex-1 font-mono text-xs">
              <!-- Inline Task Editing Form -->
              <form
                phx-submit="update_task"
                id={"drawer-edit-task-#{@selected_task.id}"}
                class="space-y-3"
              >
                <input type="hidden" name="task_id" value={@selected_task.id} />
                <div>
                  <label class="block text-[11px] text-gray-400 uppercase tracking-wider mb-1 font-mono">Title</label>
                  <input
                    type="text"
                    name="title"
                    value={@selected_task.title}
                    required
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-white font-sans text-sm font-bold focus:border-cyan-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label class="block text-[11px] text-gray-400 uppercase tracking-wider mb-1 font-mono">Description</label>
                  <textarea
                    name="description"
                    rows="3"
                    placeholder="Task details and requirements..."
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl p-2.5 text-xs text-gray-300 font-mono focus:border-cyan-500 focus:outline-none"
                  >{@selected_task.description}</textarea>
                </div>

                <div>
                  <label class="block text-[11px] text-gray-400 uppercase tracking-wider mb-1 font-mono">Tags (comma-separated)</label>
                  <input
                    type="text"
                    name="tags"
                    value={Enum.join(@selected_task.tags || [], ", ")}
                    placeholder="e.g. backend, urgent, liveview"
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-xs text-gray-300 font-mono focus:border-cyan-500 focus:outline-none"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full py-1.5 bg-[#161b22] hover:bg-[#21262d] text-cyan-300 border border-cyan-500/30 rounded-xl text-xs font-mono font-medium transition-smooth flex items-center justify-center gap-1.5"
                >
                  <.icon name="hero-check" class="w-3.5 h-3.5" />
                  <span>Save Task Details</span>
                </button>
              </form>

              <!-- Subtasks Checklist Section -->
              <div class="pt-3 border-t border-[#21262d] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono text-gray-400 uppercase tracking-wider">
                    Subtasks ({@selected_task.steps_completed}/{@selected_task.steps_total})
                  </span>
                  <% subtask_pct =
                    if @selected_task.steps_total > 0 do
                      min(
                        100,
                        round(@selected_task.steps_completed / @selected_task.steps_total * 100)
                      )
                    else
                      0
                    end %>
                  <span class="text-[11px] font-mono font-bold text-emerald-400">{subtask_pct}%</span>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-[#0d1117] border border-[#21262d] rounded-full h-2 overflow-hidden">
                  <div
                    class="bg-emerald-500 h-full rounded-full transition-all duration-300 shadow-[0_0_8px_rgba(16,185,129,0.5)]"
                    style={"width: #{subtask_pct}%"}
                  >
                  </div>
                </div>

                <!-- Subtasks Items List -->
                <div class="space-y-1.5 max-h-48 overflow-y-auto">
                  <%= for subtask <- (@selected_task.subtasks || []) do %>
                    <% is_done = subtask["completed"] == true or subtask[:completed] == true
                    sid = subtask["id"] || subtask[:id] %>
                    <div class="flex items-center justify-between gap-2 p-2 bg-[#161b22] border border-[#21262d] rounded-xl group hover:border-[#30363d] transition-smooth">
                      <button
                        type="button"
                        phx-click="toggle_subtask"
                        phx-value-id={sid}
                        class="flex items-center gap-2 flex-1 text-left min-w-0"
                      >
                        <span class={[
                          "w-4 h-4 rounded flex items-center justify-center border transition-smooth shrink-0",
                          is_done && "bg-emerald-500 border-emerald-500 text-white",
                          !is_done && "border-gray-500 bg-[#0d1117] hover:border-gray-400"
                        ]}>
                          <%= if is_done do %>
                            <.icon name="hero-check" class="w-3 h-3 stroke-[3]" />
                          <% end %>
                        </span>
                        <span class={[
                          "text-xs font-mono truncate",
                          is_done && "line-through text-gray-500",
                          !is_done && "text-gray-200 font-medium"
                        ]}>
                          {subtask["title"] || subtask[:title]}
                        </span>
                      </button>
                      <button
                        type="button"
                        phx-click="delete_subtask"
                        phx-value-id={sid}
                        data-confirm="Delete this subtask?"
                        aria-label={"Delete subtask " <> (subtask["title"] || subtask[:title])}
                        class="text-gray-500 hover:text-rose-400 p-1 rounded transition-smooth opacity-0 group-hover:opacity-100 focus:opacity-100"
                        title="Delete subtask"
                      >
                        <.icon name="hero-trash" class="w-3.5 h-3.5" />
                      </button>
                    </div>
                  <% end %>
                </div>

                <!-- Add Subtask Input Form -->
                <form phx-submit="add_subtask" class="flex gap-2 pt-1">
                  <input type="hidden" name="task_id" value={@selected_task.id} />
                  <input
                    type="text"
                    name="title"
                    placeholder="Add a subtask..."
                    required
                    class="flex-1 bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-xs text-white font-mono placeholder-gray-500 focus:border-cyan-500 focus:outline-none"
                  />
                  <button
                    type="submit"
                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-mono font-medium transition-smooth shrink-0 flex items-center gap-1"
                  >
                    <.icon name="hero-plus" class="w-3.5 h-3.5" />
                    <span>Add</span>
                  </button>
                </form>
              </div>

              <!-- Metadata Grid -->
              <div class="space-y-2.5 pt-3 border-t border-[#21262d]">
                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Assignee</span>
                  <div class="flex items-center gap-1">
                    <%= for a <- ["default", "planner", "coder", "verifier"] do %>
                      <button
                        type="button"
                        phx-click="update_task_assignee"
                        phx-value-id={@selected_task.id}
                        phx-value-assignee={a}
                        class={[
                          "px-2 py-0.5 rounded text-[10px] font-mono transition-smooth capitalize",
                          @selected_task.assignee == a && "bg-purple-600 text-white font-bold",
                          @selected_task.assignee != a &&
                            "bg-[#161b22] text-gray-400 hover:text-white"
                        ]}
                      >
                        {a}
                      </button>
                    <% end %>
                  </div>
                </div>

                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Priority</span>
                  <div class="flex items-center gap-1">
                    <%= for p <- ["critical", "high", "medium", "low"] do %>
                      <button
                        type="button"
                        phx-click="update_task_priority"
                        phx-value-id={@selected_task.id}
                        phx-value-priority={p}
                        class={[
                          "px-2 py-0.5 rounded text-[10px] font-mono transition-smooth uppercase",
                          @selected_task.priority == p && p == "critical" &&
                            "bg-red-600 text-white font-bold",
                          @selected_task.priority == p && p == "high" &&
                            "bg-orange-600 text-white font-bold",
                          @selected_task.priority == p && p == "medium" &&
                            "bg-blue-600 text-white font-bold",
                          @selected_task.priority == p && p == "low" &&
                            "bg-gray-600 text-white font-bold",
                          @selected_task.priority != p &&
                            "bg-[#161b22] text-gray-400 hover:text-white"
                        ]}
                      >
                        {p}
                      </button>
                    <% end %>
                  </div>
                </div>

                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Worker PID</span>
                  <span class="text-emerald-400">{@selected_task.worker_pid || "Unassigned"}</span>
                </div>
              </div>

              <!-- Status Transition Dropdown Across 8 Columns -->
              <div class="pt-3 border-t border-[#21262d] space-y-1.5">
                <div class="text-[11px] text-gray-400 uppercase tracking-wider">
                  Move Status
                </div>
                <div class="grid grid-cols-4 gap-1">
                  <%= for s <- Kanban.Task.statuses() do %>
                    <button
                      type="button"
                      phx-click="move_task"
                      phx-value-id={@selected_task.id}
                      phx-value-status={s}
                      class={[
                        "px-2 py-1 rounded text-[10px] uppercase font-bold transition-smooth text-center",
                        @selected_task.status == s && "bg-emerald-600 text-white shadow-sm",
                        @selected_task.status != s &&
                          "bg-[#161b22] hover:bg-[#21262d] text-gray-400 hover:text-white"
                      ]}
                    >
                      {s}
                    </button>
                  <% end %>
                </div>
              </div>

              <!-- Effort Estimate Button -->
              <div class="pt-3 border-t border-[#21262d]">
                <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                  Estimate
                </div>
                <%= if @selected_task.estimate do %>
                  <div class="p-2.5 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-xs text-amber-300">
                    {@selected_task.estimate}
                  </div>
                <% else %>
                  <button
                    phx-click="estimate_task"
                    phx-value-id={@selected_task.id}
                    class="w-full flex items-center justify-center gap-2 py-2 px-3 bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] rounded-xl text-xs font-mono text-gray-300 transition-smooth"
                  >
                    <.icon name="hero-calculator" class="w-3.5 h-3.5 text-amber-400" />
                    Estimate effort (makes model call)
                  </button>
                <% end %>
              </div>

              <!-- Latest Summary -->
              <%= if @selected_task.latest_summary do %>
                <div class="pt-3 border-t border-[#21262d]">
                  <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                    Latest Summary
                  </div>
                  <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-xs text-gray-300">
                    {@selected_task.latest_summary}
                  </div>
                </div>
              <% end %>

              <!-- Quick Worker Actions & Delete -->
              <div class="pt-3 border-t border-[#21262d] flex flex-col gap-2">
                <div class="flex gap-2">
                  <button
                    phx-click="claim_task"
                    phx-value-id={@selected_task.id}
                    class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-mono font-medium transition-smooth"
                  >
                    Claim & Run Worker
                  </button>
                  <button
                    phx-click="move_task"
                    phx-value-id={@selected_task.id}
                    phx-value-status="done"
                    class="px-3 py-2 bg-[#21262d] hover:bg-gray-700 text-gray-300 rounded-xl text-xs font-mono transition-smooth"
                  >
                    Mark Done
                  </button>
                </div>
                <button
                  type="button"
                  phx-click="delete_task"
                  phx-value-id={@selected_task.id}
                  data-confirm="Delete this task? This action cannot be undone."
                  class="w-full py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 border border-rose-500/20 rounded-xl text-xs font-mono transition-smooth flex items-center justify-center gap-1.5"
                >
                  <.icon name="hero-trash" class="w-3.5 h-3.5" />
                  <span>Delete Task</span>
                </button>
              </div>
            </div>
          </aside>
          <% end %>
        <% end %>
      </div>

      <%!-- Shared command dock --%>
      <footer
        id="prompt-composer"
        aria-label="Agent prompt composer"
        data-command-dock-state={
          if(@run_setup_open? or @active_view == "chat",
            do: "expanded",
            else: if(@active_view == "deck", do: "compact", else: "focus-expand")
          )
        }
        class="sf-command-composer max-h-[calc(100dvh-3.5rem)] shrink-0 overflow-y-auto overscroll-contain p-2 pt-0 sm:p-3 sm:pt-0 xl:p-5 xl:pt-0"
      >
        <div class="max-w-4xl mx-auto">
          <%!-- Setup tray and prompt form stay siblings inside one shared vertical shell. --%>
          <div class={["sf-command-dock-shell"]}>
            <section
              :if={@run_setup_open?}
              id="run-setup-tray"
              aria-label="Run setup"
              class={["sf-sheet-scroll sf-run-setup-tray"]}
            >
              <.form
                for={@run_setup_form}
                id="run-setup-panel"
                phx-change="update_run_setup"
                class={["sf-run-setup-form mb-3 max-h-[min(60dvh,42rem)] overflow-y-auto overscroll-contain border-b pb-3 pr-1"]}
              >
                <div class="mb-3 flex items-start justify-between gap-4">
                  <div>
                    <p class={["font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--sf-live-text)]"]}>
                      Durable execution manifest
                    </p>
                    <p class={["mt-1 text-[11px] leading-5 text-[var(--sf-text-secondary)]"]}>
                      Persist mode, evidence providers, attempt policy, enforced token/time limits, and reported-cost budget.
                    </p>
                  </div>
                  <button
                    type="button"
                    phx-click="toggle_run_setup"
                    aria-label="Close run setup"
                    class={["sf-control sf-run-setup-close inline-flex min-h-11 min-w-11 items-center justify-center p-2 text-[var(--sf-text-secondary)] transition-colors"]}
                  >
                    <.icon name="hero-x-mark" class="h-4 w-4" />
                  </button>
                </div>

                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                  <.input
                    field={@run_setup_form[:mode]}
                    id="run-setup-mode"
                    type="select"
                    label="Mission type"
                    options={[
                      "Single agent": "single",
                      "Coding swarm": "swarm",
                      "Deep research": "research",
                      "Typed DAG (non-mutating)": "dag"
                    ]}
                    value={@run_setup_form[:mode].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:priority]}
                    id="run-setup-priority"
                    type="select"
                    label="Queue priority"
                    options={[Low: "low", Normal: "normal", High: "high", Critical: "critical"]}
                    value={@run_setup_form[:priority].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    :if={@run_setup_mode != "research"}
                    field={@run_setup_form[:max_attempts]}
                    id="run-setup-max-attempts"
                    type="number"
                    min="1"
                    max="10"
                    label="Manual retry ceiling"
                    value={@run_setup_form[:max_attempts].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <div
                    :if={@run_setup_mode == "research"}
                    id="run-setup-research-attempt-policy"
                    class={["sf-run-setup-policy sf-control px-3 py-2"]}
                  >
                    <p class={["text-xs font-semibold text-[var(--sf-live-text)]"]}>One paid run attempt</p>
                    <p class={["mt-1 text-[10px] leading-4 text-[var(--sf-text-secondary)]"]}>
                      Whole-run replay is disabled. Review failures before launching a new research run.
                    </p>
                  </div>
                  <.input
                    field={@run_setup_form[:time_budget_minutes]}
                    id="run-setup-time-budget"
                    type="number"
                    min="1"
                    max="10080"
                    label="Time budget (min)"
                    value={@run_setup_form[:time_budget_minutes].value}
                    placeholder="Unset"
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:token_budget]}
                    id="run-setup-token-budget"
                    type="number"
                    min="1"
                    label="Token budget"
                    value={@run_setup_form[:token_budget].value}
                    placeholder="Unset"
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:cost_budget_cents]}
                    id="run-setup-cost-budget"
                    type="number"
                    min="1"
                    label="Reported cost budget (¢)"
                    value={@run_setup_form[:cost_budget_cents].value}
                    placeholder="Unset"
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:agent_max_turns]}
                    id="run-setup-agent-max-turns"
                    type="number"
                    min="1"
                    max="20"
                    label="Agent / coder turn limit"
                    aria-description="Applies to the single-agent loop or each durable swarm coding and diagnostic repair pass."
                    value={@run_setup_form[:agent_max_turns].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:swarm_agent_count]}
                    id="run-setup-swarm-agent-count"
                    type="number"
                    min="4"
                    max="32"
                    label="Swarm agents"
                    value={@run_setup_form[:swarm_agent_count].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:swarm_max_retries]}
                    id="run-setup-swarm-max-retries"
                    type="number"
                    min="0"
                    max="10"
                    label="Swarm correction retries"
                    value={@run_setup_form[:swarm_max_retries].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:research_level]}
                    id="run-setup-research-level"
                    type="select"
                    label="Research effort"
                    options={[Low: "low", Medium: "medium", High: "high", Ultra: "ultra"]}
                    value={@run_setup_form[:research_level].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                  <.input
                    field={@run_setup_form[:research_max_sources]}
                    id="run-setup-research-sources"
                    type="number"
                    min="1"
                    max="40"
                    label="Maximum sources"
                    value={@run_setup_form[:research_max_sources].value}
                    class={["sf-run-setup-input sf-control w-full rounded-xl px-2.5 py-2 text-xs outline-none transition-colors"]}
                  />
                </div>

                <p
                  :if={@run_setup_policy_error}
                  id="run-setup-policy-error"
                  role="alert"
                  class={["mt-3 border border-[var(--sf-live-mark)] bg-[var(--sf-raised-control)] px-3 py-2 text-xs leading-5 text-[var(--sf-live-text)]"]}
                >
                  {@run_setup_policy_error}. The submitted value is preserved; fix it before queueing work.
                </p>

                <div
                  :if={@run_setup_mode == "dag"}
                  id="run-setup-dag-manifest"
                  class={["sf-run-setup-dag mt-3 border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-3"]}
                >
                  <div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                      <p class={["font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--sf-topology-text)]"]}>
                        Immutable typed manifest
                      </p>
                      <p class={["mt-1 max-w-2xl text-[11px] leading-5 text-[var(--sf-text-secondary)]"]}>
                        Editable sample for common Phoenix repositories. Missing files fail visibly;
                        only bounded, registered project-read and research node kinds execute.
                      </p>
                    </div>
                    <span class={["font-mono text-[9px] uppercase tracking-wider text-[var(--sf-text-secondary)]"]}>
                      256 KB raw limit · 128 nodes
                    </span>
                  </div>
                  <.input
                    field={@run_setup_form[:dag_manifest_json]}
                    id="run-setup-dag-manifest-json"
                    type="textarea"
                    rows="16"
                    label="DAG manifest JSON"
                    value={@run_setup_dag_manifest_json}
                    spellcheck="false"
                    class={["sf-run-setup-manifest block min-h-72 w-full resize-y rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-code-surface)] px-3 py-2.5 font-mono text-xs leading-5 text-[var(--sf-code-text)] outline-none transition-colors placeholder:text-[var(--sf-text-secondary)] focus:border-[var(--sf-live-mark)] focus-visible:ring-2 focus-visible:ring-[var(--sf-focus-ring)]"]}
                  />
                  <p
                    :if={@run_setup_dag_error}
                    id="run-setup-dag-manifest-error"
                    role="alert"
                    class={["mt-2 text-xs text-[var(--sf-live-text)]"]}
                  >
                    Manifest JSON exceeds the safe editor boundary. Shorten it before queueing.
                  </p>
                </div>

                <fieldset
                  id="run-setup-providers"
                  disabled={@run_setup_mode != "research"}
                  aria-disabled={if(@run_setup_mode != "research", do: "true", else: "false")}
                  class={[
                    "sf-run-setup-providers sf-control mt-2 px-3 py-2",
                    @run_setup_mode != "research" && "cursor-not-allowed opacity-40"
                  ]}
                >
                  <legend class={["px-1 font-mono text-[9px] font-semibold uppercase tracking-wider text-[var(--sf-text-secondary)]"]}>
                    Federated providers · ordered fan-out
                  </legend>
                  <div class="flex flex-wrap gap-x-4 gap-y-1">
                    <label
                      :for={provider <- @settings.search_provider_order || ["duckduckgo"]}
                      class={["inline-flex min-h-8 cursor-pointer items-center gap-1.5 font-mono text-[11px] text-[var(--sf-text-secondary)]"]}
                    >
                      <input
                        type="hidden"
                        name={"run_setup[providers][#{provider}]"}
                        value="false"
                      />
                      <input
                        id={"run-setup-provider-#{provider}"}
                        type="checkbox"
                        name={"run_setup[providers][#{provider}]"}
                        value="true"
                        checked={provider in @run_setup_providers}
                        class={["h-4 w-4 border-[var(--sf-hairline)] bg-[var(--sf-raised-control)] accent-[var(--sf-live-mark)]"]}
                      />
                      {provider |> String.replace("_", " ") |> String.capitalize()}
                    </label>
                  </div>
                </fieldset>
              </.form>
            </section>

              <.form
                for={@prompt_form}
                id="prompt-form"
                phx-submit="submit_prompt"
                data-command-has-context={to_string(MapSet.size(@research_attachments) > 0)}
                class="sf-command-dock-form"
              >
                <input
                  id="prompt-request-id"
                  type="hidden"
                  name="request_id"
                  value={@prompt_form[:request_id].value}
                />
                <label for="prompt-textarea" class="sr-only">Agent prompt or swarm instruction</label>
                <textarea
                  id="prompt-textarea"
                  name="prompt"
                  rows="2"
                  required
                  aria-required="true"
                  phx-hook="KeyboardSubmit"
                  placeholder="What's my next task or swarm instruction? (e.g. /swarm fix authentication)"
                  class={["sf-command-textarea w-full resize-none border-0 bg-transparent px-2 py-1 font-sans text-sm"]}
                ></textarea>

                <%!-- Bottom Action Toolbar --%>
                <div class={["sf-command-dock-toolbar flex min-w-0 items-center justify-between gap-2 border-t px-1 pt-2"]}>
                  <%!-- Left Tool / Model Badges --%>
                  <div
                    data-command-context
                    class={["sf-command-context flex min-w-0 flex-wrap items-center gap-1.5"]}
                  >
                    <div
                      :if={MapSet.size(@research_attachments) > 0}
                      id="prompt-research-attachments"
                      data-command-context
                      class={["sf-command-attachments flex flex-wrap items-center gap-1.5 px-2"]}
                      aria-label="Attached deep research results"
                    >
                      <span class={["mr-1 font-mono text-[9px] uppercase tracking-wider text-[var(--sf-text-secondary)]"]}>
                        Context
                      </span>
                      <button
                        :for={public_id <- @research_attachments |> MapSet.to_list() |> Enum.sort()}
                        id={"prompt-research-attachment-#{public_id}"}
                        type="button"
                        phx-click="toggle_research_attachment"
                        phx-value-id={public_id}
                        title={"Remove ready research result ##{public_id}"}
                        class={["sf-command-attachment sf-control inline-flex min-h-7 items-center gap-1.5 px-2 font-mono text-[9px] transition-colors"]}
                      >
                        <.icon name="hero-document-text" class="h-3 w-3" /> /deep_research {public_id}
                        <.icon name="hero-x-mark" class="h-3 w-3" />
                      </button>
                    </div>
                    <div data-command-tools class={["flex min-w-0 items-center gap-1.5 sm:gap-2"]}>
                      <%!-- Dispatch announcement and setup are tools in the compact row. --%>
                      <div
                        data-command-announcement
                        class={["flex shrink-0 items-center gap-1.5 text-[var(--sf-text-secondary)]"]}
                      >
                        <span class={["text-xs text-[var(--sf-live-mark)]"]}>◆</span>
                        <span class={["hidden font-mono text-[10px] xl:inline"]}>
                          <%= if @dispatch_mode == "background" do %>
                            Durable mode · queued work continues after you disconnect
                          <% else %>
                            Interactive mode · keep this session open for live conversation
                          <% end %>
                        </span>
                      </div>
                      <button
                        id="toggle-run-setup"
                        type="button"
                        phx-click="toggle_run_setup"
                        data-run-setup-toggle
                        data-command-setup
                        aria-expanded={@run_setup_open?}
                        aria-controls="run-setup-tray"
                        aria-label={if @run_setup_open?, do: "Close run setup", else: "Open run setup"}
                        class={["sf-control inline-flex min-h-11 shrink-0 items-center gap-1.5 px-3 font-mono text-xs transition-colors"]}
                      >
                        <.icon name="hero-adjustments-horizontal" class="h-3 w-3 text-[var(--sf-live-mark)]" />
                        <span class={["sr-only sm:not-sr-only"]}>Run setup</span>
                      </button>

                      <%!-- Model Pill Dropdown --%>
                      <div
                        class="relative"
                        phx-click-away={@open_dropdown == "model" && "close_dropdowns"}
                      >
                        <button
                          type="button"
                          phx-click="toggle_dropdown"
                          phx-value-name="model"
                          aria-haspopup="listbox"
                          aria-expanded={@open_dropdown == "model"}
                          aria-controls={
                            if(@open_dropdown == "model", do: "model-picker-listbox", else: nil)
                          }
                          aria-label="Select AI model"
                          class={["sf-command-model sf-control flex min-w-0 max-w-28 items-center rounded-xl px-2.5 py-1 font-mono text-xs transition-smooth sm:max-w-none"]}
                        >
                          <.icon name="hero-sparkles" class="mr-1.5 h-3.5 w-3.5 text-[var(--sf-live-mark)]" />
                          <span class="truncate">{@session.model_name}</span>
                          <.icon name="hero-chevron-up-down" class="ml-1.5 h-3 w-3 text-[var(--sf-text-secondary)]" />
                        </button>

                        <%= if @open_dropdown == "model" do %>
                          <div
                            id="model-picker-listbox"
                            role="listbox"
                            aria-label="AI model"
                            class={["sf-command-model-list absolute bottom-full left-0 z-50 mb-2 w-64 rounded-2xl border p-1.5 shadow-[0_24px_72px_-38px_var(--sf-shadow)] backdrop-blur-xl animate-in fade-in zoom-in-95"]}
                          >
                            <div class={["sf-command-model-list-heading mb-1 border-b px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider"]}>
                              Select AI Model
                            </div>
                            <%= for {model_id, label, provider_label, provider_id} <- [
                              {"ox-alpha", "OX Alpha", "LLMotions · OpenAI-compatible", "openai"},
                              {"gemini-3.7-flash-high", "Gemini 3.7 Flash High", "OpenAI-compatible", "openai"},
                              {"deepseek-v4-pro", "DeepSeek V4 Pro", "OpenAI-compatible", "openai"},
                              {"gpt-5.4-turbo", "GPT 5.4 Turbo", "OpenAI", "openai"},
                              {"claude-3.7-sonnet", "Claude 3.7 Sonnet", "Anthropic", "anthropic"}
                            ] do %>
                              <button
                                type="button"
                                role="option"
                                aria-selected={@session.model_name == model_id}
                                phx-click="change_model"
                                phx-value-model={model_id}
                                phx-value-provider={provider_id}
                                class={["sf-command-option flex w-full items-center justify-between rounded-xl px-3 py-2 text-xs transition-smooth"]}
                              >
                                <div class="text-left">
                                  <div class={["font-medium text-[var(--sf-text-primary)]"]}>{label}</div>
                                  <div class={["font-mono text-[10px] text-[var(--sf-text-secondary)]"]}>
                                    {provider_label}
                                  </div>
                                </div>
                                <%= if @session.model_name == model_id do %>
                                  <.icon name="hero-check" class="h-3.5 w-3.5 text-[var(--sf-success-mark)]" />
                                <% end %>
                              </button>
                            <% end %>
                          </div>
                        <% end %>
                      </div>

                      <%!-- Interactive Tool Pills --%>
                      <div class="tooltip-trigger">
                        <button
                          type="button"
                          phx-click="toggle_tool"
                          phx-value-tool="ast_search"
                          aria-label="Toggle AST search tool"
                          aria-pressed={MapSet.member?(@active_tools, "ast_search")}
                          class={[
                            "sf-control sf-command-tool p-1.5 rounded-lg transition-smooth",
                            MapSet.member?(@active_tools, "ast_search") &&
                              "sf-command-tool-active",
                            !MapSet.member?(@active_tools, "ast_search") &&
                              "sf-command-tool-idle"
                          ]}
                        >
                          <.icon name="hero-magnifying-glass" class="w-3.5 h-3.5" />
                        </button>
                        <div class={["sf-command-tooltip luxury-tooltip"]}>
                          <div class={["sf-command-tooltip-title mb-1 text-xs font-semibold tracking-tight"]}>
                            AST Search Engine
                          </div>
                          <div class={["sf-command-tooltip-meta flex items-center justify-between border-t pt-1 font-mono text-[11px]"]}>
                            <span class={["text-[var(--sf-text-secondary)]"]}>Semantic AST Query</span>
                            <span class={["text-[var(--sf-topology-text)] font-semibold"]}>{if MapSet.member?(
                                                                            @active_tools,
                                                                            "ast_search"
                                                                          ),
                                                                          do: "Active",
                                                                          else: "Disabled"}</span>
                          </div>
                        </div>
                      </div>

                      <div class="tooltip-trigger">
                        <button
                          type="button"
                          phx-click="toggle_tool"
                          phx-value-tool="web_search"
                          aria-label="Toggle live web search tool"
                          aria-pressed={MapSet.member?(@active_tools, "web_search")}
                          class={[
                            "sf-control sf-command-tool p-1.5 rounded-lg transition-smooth",
                            MapSet.member?(@active_tools, "web_search") &&
                              "sf-command-tool-active",
                            !MapSet.member?(@active_tools, "web_search") &&
                              "sf-command-tool-idle"
                          ]}
                        >
                          <.icon name="hero-globe-alt" class="w-3.5 h-3.5" />
                        </button>
                        <div class={["sf-command-tooltip luxury-tooltip"]}>
                          <div class={["sf-command-tooltip-title mb-1 text-xs font-semibold tracking-tight"]}>
                            Live Web Search
                          </div>
                          <div class={["sf-command-tooltip-meta flex items-center justify-between border-t pt-1 font-mono text-[11px]"]}>
                            <span class={["text-[var(--sf-text-secondary)]"]}>Federated providers & safe fetch</span>
                            <span class={["text-[var(--sf-success-text)] font-semibold"]}>{if MapSet.member?(
                                                                               @active_tools,
                                                                               "web_search"
                                                                             ),
                                                                             do: "Active",
                                                                             else: "Disabled"}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <%!-- Prompt dispatch mode --%>
                  <div
                      id="dispatch-mode-switcher"
                      data-command-dispatch
                      class={["flex shrink-0 items-center border border-[var(--sf-hairline)] bg-[var(--sf-raised-control)] p-0.5"]}
                      role="group"
                      aria-label="Prompt dispatch mode"
                    >
                      <button
                        id="dispatch-mode-background"
                        type="button"
                        phx-click="set_dispatch_mode"
                        phx-value-mode="background"
                        aria-pressed={to_string(@dispatch_mode == "background")}
                        aria-label="Use background dispatch mode"
                        title="Persist and run asynchronously"
                        class={[
                          "sf-control sf-command-dispatch-button flex items-center gap-1 px-2 py-1 font-mono text-[10px] transition-colors",
                          @dispatch_mode == "background" && "sf-command-dispatch-active",
                          @dispatch_mode != "background" && "sf-command-dispatch-idle"
                        ]}
                      >
                        <.icon name="hero-queue-list" class="h-3 w-3" />
                        <span class="hidden lg:inline">Background</span>
                      </button>
                      <button
                        id="dispatch-mode-interactive"
                        type="button"
                        phx-click="set_dispatch_mode"
                        phx-value-mode="interactive"
                        aria-pressed={to_string(@dispatch_mode == "interactive")}
                        aria-label="Use interactive dispatch mode"
                        title="Send to the live session"
                        class={[
                          "sf-control sf-command-dispatch-button flex items-center gap-1 px-2 py-1 font-mono text-[10px] transition-colors",
                          @dispatch_mode == "interactive" && "sf-command-dispatch-active",
                          @dispatch_mode != "interactive" && "sf-command-dispatch-idle"
                        ]}
                      >
                        <.icon name="hero-bolt" class="h-3 w-3" />
                        <span class="hidden lg:inline">Interactive</span>
                      </button>
                    </div>

                  <%!-- Right Send Button --%>
                  <div data-command-send class={["tooltip-trigger shrink-0"]}>
                    <button
                      type="submit"
                      phx-disable-with="Executing..."
                      class={["sf-control sf-command-send min-h-11 px-4 text-xs font-semibold transition-colors"]}
                    >
                      {if @dispatch_mode == "background", do: "Queue run", else: "Send"}
                    </button>
                    <div class={["sf-command-tooltip luxury-tooltip luxury-tooltip-left"]}>
                      <div class={["sf-command-tooltip-title mb-1 text-xs font-semibold tracking-tight"]}>
                        {if @dispatch_mode == "background",
                          do: "Start durable background run",
                          else: "Send live prompt"}
                      </div>
                      <div class={["sf-command-tooltip-meta flex items-center justify-between border-t pt-1 font-mono text-[11px]"]}>
                        <span class={["text-[var(--sf-text-secondary)]"]}>Trigger Pipeline</span>
                        <span class={["text-[var(--sf-live-text)] font-semibold"]}>↵ Enter</span>
                      </div>
                    </div>
                  </div>
                </div>
              </.form>
          </div>
        </div>
      </footer>
    </main>
  </div>



  <!-- Autonomous Goal Creation Modal -->
  <%= if @show_goal_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4">
      <div
        id="goal-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_goal_modal"
        data-initial-focus="input[name='goal[title]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="goal-modal-title"
        tabindex="-1"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-lg p-6 shadow-2xl font-sans text-xs space-y-4 animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center text-white font-bold text-xs shadow-md">
              <.icon name="hero-flag" class="w-4 h-4 text-white" />
            </div>
            <div>
              <h3 id="goal-modal-title" class="text-sm font-bold text-white tracking-tight">
                Create Autonomous Goal
              </h3>
              <p class="text-[11px] font-mono text-gray-400">
                Create a durable multi-agent goal lifecycle
              </p>
            </div>
          </div>
          <button
            id="goal-modal-close"
            type="button"
            phx-click="close_goal_modal"
            aria-label="Close goal modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <.form
          for={@goal_form}
          id="goal-create-form"
          phx-submit="create_goal"
          class="space-y-3 font-mono text-xs"
        >
          <input
            id="goal-request-id"
            type="hidden"
            name="goal[request_id]"
            value={@goal_form[:request_id].value}
          />
          <div>
            <label for="goal-title-input" class="block text-gray-400 mb-1 font-semibold">
              Goal Objective / Title
            </label>
            <input
              id="goal-title-input"
              type="text"
              name="goal[title]"
              placeholder="e.g. Implement payment webhook reconcile engine"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-amber-500"
              required
            />
          </div>
          <div>
            <label for="goal-description-input" class="block text-gray-400 mb-1 font-semibold">
              Detailed Instructions (Optional)
            </label>
            <textarea
              id="goal-description-input"
              name="goal[description]"
              rows="3"
              placeholder="Add constraints, target files, or acceptance criteria..."
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-amber-500 resize-none"
            ></textarea>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <input type="hidden" name="goal[auto_start]" value="false" />
            <input
              type="checkbox"
              name="goal[auto_start]"
              value="true"
              checked={@goal_form[:auto_start].value in [true, "true", "on", "1", 1]}
              id="goal-auto-start"
              class="rounded bg-[#0d1117] border-[#30363d] text-amber-500 focus:ring-0"
            />
            <label for="goal-auto-start" class="text-gray-300 text-xs">
              Queue for execution now (uncheck to save a durable draft)
            </label>
          </div>
          <section
            id="goal-run-policy-summary"
            aria-labelledby="goal-run-policy-title"
            class="border border-[#30363d] bg-[#0d1117] px-3 py-2.5"
          >
            <div class="flex items-center justify-between gap-3">
              <h4
                id="goal-run-policy-title"
                class="text-[10px] font-semibold uppercase tracking-[0.14em] text-gray-300"
              >
                Inherited run policy
              </h4>
              <span class="text-[9px] text-gray-600">From Run setup</span>
            </div>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Priority</dt>
                <dd id="goal-policy-priority" class="mt-0.5 text-[11px] text-gray-300">
                  {String.capitalize(@run_setup_priority)}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">
                  Manual retry ceiling
                </dt>
                <dd id="goal-policy-max-attempts" class="mt-0.5 text-[11px] text-gray-300">
                  {@run_setup_max_attempts}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Time budget</dt>
                <dd id="goal-policy-time-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {if(@run_setup_time_budget_minutes,
                    do: "#{@run_setup_time_budget_minutes} min",
                    else: "Not capped"
                  )}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Token budget</dt>
                <dd id="goal-policy-token-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {if(@run_setup_token_budget,
                    do: to_string(@run_setup_token_budget),
                    else: "Not capped"
                  )}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Cost budget</dt>
                <dd id="goal-policy-cost-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {goal_cost_budget_label(@run_setup_cost_budget_cents)}
                </dd>
              </div>
            </dl>
          </section>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              id="goal-modal-cancel"
              type="button"
              phx-click="close_goal_modal"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
            >
              Cancel
            </button>
            <button
              id="goal-modal-submit"
              type="submit"
              phx-disable-with="Creating…"
              class="px-5 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold rounded-xl shadow-md disabled:cursor-wait disabled:opacity-60"
            >
              Create Goal
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <!-- Cancel Session Modal (Rollback vs Commit) -->
  <%= if @show_cancel_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4">
      <div
        id="cancel-session-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_cancel_modal"
        data-initial-focus="button[aria-label='Close cancel session modal']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cancel-session-modal-title"
        tabindex="-1"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-md p-6 shadow-2xl font-sans text-xs space-y-4 animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-2.5 text-rose-400 font-bold">
            <.icon name="hero-stop-circle" class="w-5 h-5 text-rose-400" />
            <h3 id="cancel-session-modal-title" class="text-sm font-bold text-white">
              Stop & Cancel Session
            </h3>
          </div>
          <button
            phx-click="close_cancel_modal"
            aria-label="Close cancel session modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <p class="text-gray-300 text-xs leading-relaxed font-sans">
          How would you like to handle any uncommitted MultiPatch changes in this session?
        </p>

        <div class="space-y-2 font-mono text-xs">
          <button
            type="button"
            phx-click="cancel_session"
            phx-value-mode="rollback"
            class="w-full p-3 rounded-2xl bg-[#161b22] hover:bg-[#1f242c] border border-rose-500/30 text-left transition-smooth group"
          >
            <div class="font-bold text-rose-300 flex items-center gap-2 mb-1">
              <.icon name="hero-arrow-uturn-left" class="w-4 h-4 text-rose-400" />
              <span>Rollback Snapshots</span>
            </div>
            <p class="text-[11px] text-gray-400 font-sans">
              Reverts all applied patches back to the clean pre-session snapshot state.
            </p>
          </button>

          <button
            type="button"
            phx-click="cancel_session"
            phx-value-mode="commit"
            class="w-full p-3 rounded-2xl bg-[#161b22] hover:bg-[#1f242c] border border-emerald-500/30 text-left transition-smooth group"
          >
            <div class="font-bold text-emerald-300 flex items-center gap-2 mb-1">
              <.icon name="hero-check-badge" class="w-4 h-4 text-emerald-400" />
              <span>Commit Changes</span>
            </div>
            <p class="text-[11px] text-gray-400 font-sans">
              Stages and commits all generated files to git with a cancellation record.
            </p>
          </button>
        </div>

        <div class="flex justify-end pt-2 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="close_cancel_modal"
            class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
          >
            Keep Session Running
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Expanded Message Modal -->
  <%= if @expanded_message_id do %>
    <% expanded_msg = @expanded_message %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-6">
      <div
        id="expanded-message-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_expand_message"
        data-initial-focus="#copy-expanded-msg-btn"
        role="dialog"
        aria-modal="true"
        aria-labelledby="expanded-message-modal-title"
        tabindex="-1"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-3xl max-h-[85vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95"
      >
        <div class="p-4 border-b border-[#21262d] bg-[#161b22] flex items-center justify-between">
          <div class="flex items-center gap-2">
            <.icon name="hero-chat-bubble-bottom-center-text" class="w-4 h-4 text-blue-400" />
            <span
              id="expanded-message-modal-title"
              class="font-bold text-white text-xs font-mono uppercase"
            >
              {if expanded_msg,
                do: expanded_msg.agent_name || expanded_msg.role,
                else: "Message Inspector"}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <%= if expanded_msg do %>
              <button
                id="copy-expanded-msg-btn"
                phx-hook="CodeCopy"
                data-code={expanded_msg.content}
                class="px-2.5 py-1 bg-[#21262d] hover:bg-[#30363d] text-gray-200 rounded-lg text-xs font-mono transition-smooth flex items-center gap-1.5"
              >
                <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
                <span>Copy</span>
              </button>
            <% end %>
            <button
              phx-click="close_expand_message"
              aria-label="Close message inspector"
              class="text-gray-400 hover:text-white p-1 rounded-lg"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>
        </div>
        <div class="p-6 overflow-y-auto font-mono text-xs leading-relaxed text-gray-200 bg-[#0a0d12]">
          <%= if expanded_msg do %>
            <.markdown_content content={expanded_msg.content} />
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- New Project / Workspace Modal -->
  <%= if @show_project_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm">
      <div
        id="project-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_project_modal"
        data-initial-focus="input[name='project[path]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="project-modal-title"
        tabindex="-1"
        class="bg-[#161b22] border border-[#30363d] rounded-2xl w-full max-w-md p-6 shadow-2xl font-mono text-xs"
      >
        <div class="flex items-center justify-between mb-4 border-b border-[#21262d] pb-3">
          <h3 id="project-modal-title" class="text-sm font-bold text-white">
            Open Workspace Folder
          </h3>
          <button
            id="close-project-modal-btn"
            phx-click="toggle_project_modal"
            aria-label="Close workspace modal"
            class="text-gray-400 hover:text-white"
          >✕</button>
        </div>
        <.form
          for={@project_form}
          id="project-open-form"
          phx-submit="open_project"
          class="space-y-4"
        >
          <div>
            <label for="project-path-input" class="block text-gray-400 mb-1">Folder Path</label>
            <input
              id="project-path-input"
              type="text"
              name="project[path]"
              placeholder="/Users/.../my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
              required
            />
          </div>
          <div>
            <label for="project-name-input" class="block text-gray-400 mb-1">
              Project Name (Optional)
            </label>
            <input
              id="project-name-input"
              type="text"
              name="project[name]"
              placeholder="my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
            />
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_project_modal"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-lg"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Opening..."
              class="px-4 py-2 bg-emerald-600 text-white rounded-lg font-bold"
            >Open</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Scheduled Task Details Modal --%>
  <%= if @show_scheduled_task_modal && @selected_scheduled_task do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="scheduled-task-detail-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_scheduled_task_modal"
        data-initial-focus="button[aria-label='Close scheduled task details']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="scheduled-task-detail-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 font-sans shadow-2xl space-y-5 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <%!-- Modal Header --%>
        <div class="flex items-start justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-[#1c2128] border border-[#30363d] flex items-center justify-center text-orange-400 shadow-inner shrink-0">
              <.icon name="hero-calendar" class="w-5 h-5 text-orange-400" />
            </div>
            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-md bg-amber-500/15 border border-amber-500/30 text-amber-300 font-semibold">
                  ● {@selected_scheduled_task.status}
                </span>
                <span class={[
                  "text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-md font-semibold",
                  @selected_scheduled_task.priority == "critical" &&
                    "bg-red-500/15 border border-red-500/30 text-red-300",
                  @selected_scheduled_task.priority == "high" &&
                    "bg-orange-500/15 border border-orange-500/30 text-orange-300",
                  @selected_scheduled_task.priority in ["medium", "low"] &&
                    "bg-blue-500/15 border border-blue-500/30 text-blue-300"
                ]}>
                  {String.capitalize(@selected_scheduled_task.priority || "medium")} Priority
                </span>
              </div>
              <h3
                id="scheduled-task-detail-modal-title"
                class="text-base font-bold text-white tracking-tight"
              >
                {@selected_scheduled_task.title}
              </h3>
            </div>
          </div>
          <button
            phx-click="close_scheduled_task_modal"
            aria-label="Close scheduled task details"
            class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-[#1c2128] transition-smooth"
            title="Close"
          >
            ✕
          </button>
        </div>

        <%!-- Meta Grid --%>
        <div class="grid grid-cols-2 gap-3 font-mono text-xs">
          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl">
            <div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400" /> Scheduled Timing
            </div>
            <div class="text-white font-medium">
              <%= if @selected_scheduled_task.scheduled_at do %>
                {Calendar.strftime(@selected_scheduled_task.scheduled_at, "%b %d, %Y · %I:%M %p")}
              <% else %>
                <%= if @selected_scheduled_task.cron_expression do %>
                  Recurring: {@selected_scheduled_task.cron_expression}
                <% else %>
                  Immediate / On-demand
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl">
            <div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-user-circle" class="w-3.5 h-3.5 text-purple-400" />
              Assignee & Worker
            </div>
            <div class="text-white font-medium flex items-center gap-1.5">
              <span>{@selected_scheduled_task.assignee}</span>
              <%= if @selected_scheduled_task.worker_pid do %>
                <span class="text-[10px] text-emerald-400 font-mono">PID: {@selected_scheduled_task.worker_pid}</span>
              <% end %>
            </div>
          </div>
        </div>

        <%!-- Description Box --%>
        <div class="space-y-1.5 font-sans">
          <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider">
            Task Instructions & Requirements
          </div>
          <div class="p-3.5 bg-[#0d1117] border border-[#21262d] rounded-2xl text-xs leading-relaxed text-gray-300 font-sans whitespace-pre-wrap">
            {@selected_scheduled_task.description || "No specific instructions provided."}
          </div>
        </div>

        <%!-- Execution Progress & Latest Telemetry --%>
        <%= if @selected_scheduled_task.latest_summary do %>
          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl text-xs font-mono">
            <div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1">
              Latest Execution Telemetry
            </div>
            <div class="text-emerald-400">
              {@selected_scheduled_task.latest_summary}
            </div>
          </div>
        <% end %>

        <%!-- Modal Actions --%>
        <div class="flex items-center justify-between pt-3 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="delete_scheduled_task"
            phx-value-id={@selected_scheduled_task.id}
            data-confirm="Delete this scheduled task? Future runs will be removed."
            class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-mono transition-smooth flex items-center gap-1.5"
          >
            <.icon name="hero-trash" class="w-3.5 h-3.5" />
            <span>Delete Task</span>
          </button>

          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="open_edit_scheduled_task"
              phx-value-id={@selected_scheduled_task.id}
              class="px-3.5 py-2 bg-[#1c2128] hover:bg-[#21262d] text-cyan-300 rounded-xl text-xs font-mono border border-cyan-500/30 transition-smooth flex items-center gap-1.5"
            >
              <.icon name="hero-pencil-square" class="w-3.5 h-3.5" />
              <span>Edit Task</span>
            </button>
            <button
              type="button"
              phx-click="run_scheduled_task"
              phx-value-id={@selected_scheduled_task.id}
              class="px-4 py-2 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-xl text-xs font-mono font-bold shadow-lg shadow-orange-500/20 transition-smooth flex items-center gap-1.5"
            >
              <.icon name="hero-play" class="w-3.5 h-3.5" />
              <span>Run Now</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Edit Scheduled Task Modal -->
  <%= if @show_edit_scheduled_task_modal && @selected_scheduled_task do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="edit-scheduled-task-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_edit_scheduled_task"
        data-initial-focus="input[name='task[title]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-scheduled-task-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 font-mono text-xs shadow-2xl space-y-4 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <h3
            id="edit-scheduled-task-modal-title"
            class="text-sm font-bold text-white flex items-center gap-2"
          >
            <.icon name="hero-pencil-square" class="w-4 h-4 text-cyan-400" /> Edit Scheduled Task
          </h3>
          <button
            phx-click="close_edit_scheduled_task"
            aria-label="Close edit scheduled task modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >✕</button>
        </div>

        <.form
          for={to_form(%{})}
          id="edit-scheduled-task-form"
          phx-submit="update_scheduled_task"
          class="space-y-3 font-mono text-xs"
        >
          <input type="hidden" name="task[id]" value={@selected_scheduled_task.id} />
          <div>
            <label for="edit-scheduled-task-title" class="block text-gray-400 mb-1">Title</label>
            <input
              id="edit-scheduled-task-title"
              type="text"
              name="task[title]"
              value={@selected_scheduled_task.title}
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-cyan-500"
              required
            />
          </div>
          <div>
            <label for="edit-scheduled-task-description" class="block text-gray-400 mb-1">
              Description / Instructions
            </label>
            <textarea
              id="edit-scheduled-task-description"
              name="task[description]"
              rows="2"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-cyan-500 resize-none"
            ><%= @selected_scheduled_task.description %></textarea>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="edit-scheduled-task-priority" class="block text-gray-400 mb-1">
                Priority
              </label>
              <select
                id="edit-scheduled-task-priority"
                name="task[priority]"
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white text-xs"
              >
                <%= for p <- ["low", "medium", "high", "critical"] do %>
                  <option value={p} selected={@selected_scheduled_task.priority == p}>
                    {String.capitalize(p)}
                  </option>
                <% end %>
              </select>
            </div>
            <div>
              <label for="edit-scheduled-task-assignee" class="block text-gray-400 mb-1">
                Assignee
              </label>
              <select
                id="edit-scheduled-task-assignee"
                name="task[assignee]"
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white text-xs"
              >
                <%= for a <- ["default", "planner", "coder", "verifier"] do %>
                  <option value={a} selected={@selected_scheduled_task.assignee == a}>{a}</option>
                <% end %>
              </select>
            </div>
          </div>
          <div>
            <label for="edit-scheduled-task-cron" class="block text-gray-400 mb-1">
              Cron Expression (Optional)
            </label>
            <input
              id="edit-scheduled-task-cron"
              type="text"
              name="task[cron_expression]"
              value={@selected_scheduled_task.cron_expression || ""}
              placeholder="e.g. 0 0 * * *"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-amber-300 font-mono text-xs"
            />
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="close_edit_scheduled_task"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Saving..."
              class="px-5 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl font-bold"
            >Save Changes</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Create Agent Task Modal --%>
  <%= if @show_new_task_modal do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="new-task-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="toggle_new_task_modal"
        data-initial-focus="input[name='title']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="new-task-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 font-mono text-xs shadow-2xl animate-in zoom-in-95 duration-150 space-y-4 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <%!-- Modal Header --%>
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <h3
            id="new-task-modal-title"
            class="text-sm font-bold text-white flex items-center gap-2"
          >
            <.icon name="hero-plus-circle" class="w-4 h-4 text-orange-400" /> Create Agent Task
          </h3>
          <button
            phx-click="toggle_new_task_modal"
            aria-label="Close create task modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-[#1c2128]"
          >✕</button>
        </div>

        <.form for={@task_form} id="task-create-form" phx-submit="create_task" class="space-y-4">
          <!-- Task Title -->
          <div>
            <label
              for="new-task-title-input"
              class="block text-gray-400 mb-1.5 font-semibold text-[11px]"
            >
              Task Title
            </label>
            <input
              id="new-task-title-input"
              type="text"
              name="title"
              placeholder="e.g. Reconcile payment webhook states"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              required
            />
          </div>

          <!-- Description -->
          <div>
            <label
              for="new-task-description-input"
              class="block text-gray-400 mb-1.5 font-semibold text-[11px]"
            >
              Description
            </label>
            <textarea
              id="new-task-description-input"
              name="description"
              rows="2"
              placeholder="Task requirements or prompt instructions..."
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a] resize-none"
            ></textarea>
          </div>

          <%!-- Status & Priority Row --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Status Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_status" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Status</label>
              <button
                type="button"
                id="modal-status-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_status"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_status"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_status",
                    do: "modal-status-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_status == "scheduled" &&
                      "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]",
                    @new_task_status == "ready" &&
                      "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]",
                    @new_task_status == "triage" && "bg-gray-400",
                    @new_task_status == "todo" && "bg-blue-400",
                    @new_task_status == "running" &&
                      "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"
                  ]}></span>
                  <span class="capitalize font-medium truncate">
                    {case @new_task_status do
                      "ready" -> "Ready (Agent Claimable)"
                      s -> String.capitalize(s)
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="status" value={@new_task_status} class="hidden" />

              <%= if @open_modal_dropdown == "modal_status" do %>
                <div
                  id="modal-status-dropdown-menu"
                  role="listbox"
                  aria-label="Task status"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {s_val, s_label, dot_class} <- [
                    {"scheduled", "Scheduled", "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]"},
                    {"ready", "Ready (Agent Claimable)", "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"},
                    {"triage", "Triage", "bg-purple-400"},
                    {"todo", "Todo", "bg-blue-400"},
                    {"running", "Running", "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_status == s_val}
                      phx-click="select_modal_status"
                      phx-value-status={s_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_status == s_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_status != s_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{s_label}</span>
                      </div>
                      <%= if @new_task_status == s_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%!-- Priority Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_priority" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Priority</label>
              <button
                type="button"
                id="modal-priority-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_priority"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_priority"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_priority",
                    do: "modal-priority-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_priority == "critical" &&
                      "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]",
                    @new_task_priority == "high" &&
                      "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]",
                    @new_task_priority == "medium" && "bg-blue-400",
                    @new_task_priority == "low" && "bg-gray-400"
                  ]}></span>
                  <span class="capitalize font-medium truncate">{String.capitalize(
                    @new_task_priority
                  )}</span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="priority" value={@new_task_priority} class="hidden" />

              <%= if @open_modal_dropdown == "modal_priority" do %>
                <div
                  id="modal-priority-dropdown-menu"
                  role="listbox"
                  aria-label="Task priority"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {p_val, p_label, dot_class} <- [
                    {"critical", "Critical", "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]"},
                    {"high", "High", "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]"},
                    {"medium", "Medium", "bg-blue-400"},
                    {"low", "Low", "bg-gray-400"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_priority == p_val}
                      phx-click="select_modal_priority"
                      phx-value-priority={p_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_priority == p_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_priority != p_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{p_label}</span>
                      </div>
                      <%= if @new_task_priority == p_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Assignee & Tag Row --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Assignee Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_assignee" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Assignee</label>
              <button
                type="button"
                id="modal-assignee-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_assignee"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_assignee"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_assignee",
                    do: "modal-assignee-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <.icon
                    name={
                      case @new_task_assignee do
                        "planner" -> "hero-sparkles"
                        "coder" -> "hero-code-bracket"
                        "verifier" -> "hero-check-badge"
                        _ -> "hero-user-circle"
                      end
                    }
                    class={[
                      "w-3.5 h-3.5 shrink-0",
                      @new_task_assignee == "planner" && "text-amber-400",
                      @new_task_assignee == "coder" && "text-cyan-400",
                      @new_task_assignee == "verifier" && "text-emerald-400",
                      @new_task_assignee == "default" && "text-purple-400"
                    ]}
                  />
                  <span class="font-medium truncate">
                    {case @new_task_assignee do
                      "planner" -> "PlannerAgent"
                      "coder" -> "CoderAgent"
                      "verifier" -> "VerifierAgent"
                      _ -> "Default Worker"
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="assignee" value={@new_task_assignee} class="hidden" />

              <%= if @open_modal_dropdown == "modal_assignee" do %>
                <div
                  id="modal-assignee-dropdown-menu"
                  role="listbox"
                  aria-label="Task assignee"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {a_val, a_label, icon_name, icon_color} <- [
                    {"default", "Default Worker", "hero-user-circle", "text-purple-400"},
                    {"planner", "PlannerAgent", "hero-sparkles", "text-amber-400"},
                    {"coder", "CoderAgent", "hero-code-bracket", "text-cyan-400"},
                    {"verifier", "VerifierAgent", "hero-check-badge", "text-emerald-400"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_assignee == a_val}
                      phx-click="select_modal_assignee"
                      phx-value-assignee={a_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_assignee == a_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_assignee != a_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <.icon name={icon_name} class={["w-3.5 h-3.5 shrink-0", icon_color]} />
                        <span class="truncate">{a_label}</span>
                      </div>
                      <%= if @new_task_assignee == a_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Tag</label>
              <input
                type="text"
                name="tag"
                placeholder="Bug, Feature, Core..."
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Custom Date & Time Schedule Picker Section --%>
          <div class="p-3.5 bg-[#161b22]/70 border border-[#21262d] rounded-2xl space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono font-semibold text-gray-300">
              <span class="flex items-center gap-1.5">
                <.icon name="hero-calendar" class="w-3.5 h-3.5 text-orange-400" />
                <span>Schedule & Execution Time</span>
              </span>
              <button
                type="button"
                phx-click="open_time_picker"
                phx-value-mode="datetime"
                class="text-blue-400 hover:text-blue-300 text-[10px] flex items-center gap-1 hover:underline cursor-pointer"
              >
                <.icon name="hero-clock" class="w-3 h-3" />
                <span>Change Time Slot</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <%!-- Custom Popover Date Picker --%>
              <div class="relative">
                <label class="block text-gray-400 mb-1 text-[10px]">Target Date</label>
                <button
                  type="button"
                  id="target-date-picker-trigger"
                  phx-click="toggle_date_picker_popover"
                  aria-haspopup="dialog"
                  aria-expanded={@show_date_picker_popover}
                  aria-label="Target date picker"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-white font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to open calendar date picker"
                >
                  <span class={
                    if @new_task_date != "", do: "text-white font-medium", else: "text-gray-500"
                  }>
                    {format_date_display(@new_task_date)}
                  </span>
                  <.icon name="hero-calendar" class="w-3.5 h-3.5 text-gray-400 hover:text-white" />
                </button>
                <input type="text" name="scheduled_at_date" value={@new_task_date} class="hidden" />

                <%!-- Popover Calendar Card --%>
                <%= if @show_date_picker_popover do %>
                  <div
                    id="custom-date-picker-popover"
                    class="absolute bottom-full left-0 mb-2 z-50 w-64 bg-[#22272e] border border-[#30363d] rounded-2xl p-3 shadow-2xl shadow-black/80 font-mono text-xs select-none animate-in fade-in zoom-in-95 duration-100"
                  >
                    <%!-- Header Row --%>
                    <div class="flex items-center justify-between mb-2.5 px-1">
                      <div class="flex items-center gap-1 text-white font-bold text-xs font-sans">
                        <span>{month_name(@picker_month)} {@picker_year}</span>
                        <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                      </div>
                      <div class="flex items-center gap-0.5">
                        <button
                          type="button"
                          phx-click="picker_prev_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Previous Month"
                        >
                          <.icon name="hero-arrow-up" class="w-3 h-3" />
                        </button>
                        <button
                          type="button"
                          phx-click="picker_next_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Next Month"
                        >
                          <.icon name="hero-arrow-down" class="w-3 h-3" />
                        </button>
                      </div>
                    </div>

                    <%!-- Weekday Row --%>
                    <div class="grid grid-cols-7 gap-0.5 mb-1 text-center">
                      <%= for d <- ["S", "M", "T", "W", "T", "F", "S"] do %>
                        <div class="text-[10px] font-sans font-semibold text-gray-400 py-0.5">
                          {d}
                        </div>
                      <% end %>
                    </div>

                    <%!-- 6-Week Monthly Grid --%>
                    <div class="grid grid-cols-7 gap-0.5 text-center">
                      <%= for cell <- calendar_grid_cells(@picker_year, @picker_month, @new_task_date) do %>
                        <button
                          type="button"
                          phx-click="picker_select_day"
                          phx-value-year={cell.year}
                          phx-value-month={cell.month}
                          phx-value-day={cell.day}
                          class={[
                            "h-6 w-6 mx-auto flex items-center justify-center rounded-lg text-[11px] font-sans transition-smooth cursor-pointer",
                            cell.is_selected && "bg-[#58a6ff] text-white font-bold shadow-sm",
                            cell.is_today && !cell.is_selected &&
                              "border border-gray-500 text-white font-semibold",
                            !cell.is_selected && !cell.is_today && cell.is_current_month &&
                              "text-gray-200 hover:bg-[#2d333b] hover:text-white",
                            !cell.is_selected && !cell.is_today && !cell.is_current_month &&
                              "text-gray-500 hover:text-gray-400"
                          ]}
                        >
                          {cell.day}
                        </button>
                      <% end %>
                    </div>

                    <%!-- Popover Footer --%>
                    <div class="flex items-center justify-between pt-2 mt-2 border-t border-[#30363d] px-1 text-xs">
                      <button
                        type="button"
                        phx-click="picker_clear"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Clear
                      </button>
                      <button
                        type="button"
                        phx-click="picker_today"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Today
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>

              <%!-- Time Slot --%>
              <div>
                <label class="block text-gray-400 mb-1 text-[10px]">Time Slot</label>
                <button
                  type="button"
                  id="target-time-slot-trigger"
                  phx-click="open_time_picker"
                  phx-value-mode="time"
                  aria-haspopup="dialog"
                  aria-label="Select target time slot"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-blue-300 font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to select time slot"
                >
                  <span class="truncate">{@selected_time_slot}</span>
                  <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400 shrink-0 ml-1" />
                </button>
                <input
                  type="text"
                  name="scheduled_at_time_slot"
                  value={@selected_time_slot}
                  class="hidden"
                />
              </div>
            </div>

            <div>
              <label class="block text-gray-400 mb-1 text-[10px]">Recurring Cron Expression (Optional)</label>
              <input
                type="text"
                name="cron_expression"
                placeholder="e.g. 0 0 * * * (Daily) or leave empty"
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-amber-300 font-mono text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Bottom Action Buttons --%>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_new_task_modal"
              class="px-4 py-2 bg-[#21262d] hover:bg-[#2c333d] text-gray-300 rounded-xl transition-smooth cursor-pointer"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Creating..."
              class="px-5 py-2 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-xl font-bold shadow-lg shadow-orange-500/25 transition-smooth cursor-pointer"
            >Create Task</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Set Focus Time / Time & Date Picker Modal --%>
  <%= if @show_time_picker do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-md overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 shadow-2xl space-y-5 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
        id="time-picker-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_time_picker"
        data-initial-focus="button[phx-click='select_schedule_status']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="time-picker-modal-title"
        tabindex="-1"
      >
        <%!-- Modal Header --%>
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#1c2128] border border-[#30363d] flex items-center justify-center text-gray-300 shadow-inner shrink-0">
              <.icon name="hero-clock" class="w-5 h-5 text-blue-400" />
            </div>
            <div>
              <h3
                id="time-picker-modal-title"
                class="text-base font-bold text-white tracking-tight"
              >
                Set focus time & presence
              </h3>
              <p class="text-xs text-gray-400 font-sans">
                Choose when you don't want to be disturbed or set autonomous swarm mode
              </p>
            </div>
          </div>
          <button
            type="button"
            phx-click="close_time_picker"
            aria-label="Close time picker"
            class="text-gray-400 hover:text-white p-1 rounded-lg transition-smooth cursor-pointer"
            title="Close"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Select Status Section --%>
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select status</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Select your live presence & agent interaction mode"
            >ⓘ</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <%= for {status_label, dot_bg, desc} <- [
              {"Available", "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]", "Instant alerts"},
              {"Busy", "bg-red-400 shadow-[0_0_8px_rgba(239,68,68,0.8)]", "Deep focus mode"},
              {"In-meeting", "bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.8)]", "Batched summaries"},
              {"Offline", "bg-gray-400", "Scheduled cron only"}
            ] do %>
              <button
                type="button"
                phx-click="select_schedule_status"
                phx-value-status={status_label}
                aria-pressed={to_string(@selected_schedule_status == status_label)}
                class={[
                  "flex items-center gap-2.5 py-2.5 px-3 rounded-2xl text-xs font-medium border transition-smooth text-left cursor-pointer",
                  @selected_schedule_status == status_label &&
                    "bg-[#1c2128] border-gray-500 shadow-md text-white ring-1 ring-white/10",
                  @selected_schedule_status != status_label &&
                    "bg-[#0d1117] border-[#21262d] text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span class={["w-2 h-2 rounded-full shrink-0", dot_bg]}></span>
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-white tracking-tight leading-tight">
                    {status_label}
                  </div>
                  <div class="text-[10px] text-gray-500 font-mono truncate">{desc}</div>
                </div>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Select Time Section -->
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select time</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Pick an available focus window"
            >ⓘ</span>
          </div>

          <!-- Time Slots List -->
          <div class="space-y-1 max-h-56 overflow-y-auto pr-1">
            <%= for {start_t, end_t} <- [
              {"09:30 AM", "10:00 AM"},
              {"10:00 AM", "10:30 AM"},
              {"10:30 AM", "11:00 AM"},
              {"11:00 AM", "11:30 AM"},
              {"11:30 AM", "12:00 PM"},
              {"12:00 PM", "12:30 PM"},
              {"12:30 PM", "01:00 PM"},
              {"01:00 PM", "01:30 PM"},
              {"02:00 PM", "03:00 PM"}
            ] do %>
              <% slot_str = "#{start_t} - #{end_t}"
              is_selected = @selected_time_slot == slot_str %>
              <button
                type="button"
                phx-click="select_time_slot"
                phx-value-slot={slot_str}
                class={[
                  "w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-mono transition-smooth text-left",
                  is_selected &&
                    "bg-[#21262d] text-white font-semibold border border-white/10 shadow-sm",
                  !is_selected && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span>{start_t}</span>
                <%= if is_selected do %>
                  <div class="w-4 h-4 rounded-full bg-blue-500 flex items-center justify-center text-white text-[10px] shadow-sm">
                    <.icon name="hero-check" class="w-2.5 h-2.5" />
                  </div>
                <% else %>
                  <span class="w-4"></span>
                <% end %>
                <span>{end_t}</span>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Custom Time Input -->
        <%= if @show_custom_time_input do %>
          <.form
            for={@custom_time_form}
            id="custom-time-form"
            phx-change="update_custom_time"
            class="pt-2 border-t border-[#21262d] animate-in fade-in"
          >
            <label for="custom-time-input" class="block text-[11px] font-mono text-gray-400 mb-1">
              Enter Custom Time / Interval
            </label>
            <input
              id="custom-time-input"
              type="text"
              name="custom_time"
              value={@custom_time}
              placeholder="e.g. 03:15 PM - 04:00 PM"
              autocomplete="off"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-xs font-mono text-white focus:outline-hidden focus:border-blue-500"
            />
          </.form>
        <% end %>

        <!-- Footer Action Bar -->
        <div class="flex items-center justify-between pt-3 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="toggle_custom_time"
            class="text-xs text-gray-400 hover:text-white transition-smooth font-mono font-medium"
          >
            {if @show_custom_time_input, do: "Use presets", else: "Set custom time"}
          </button>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="close_time_picker"
              class="px-4 py-2 rounded-xl bg-[#1c2128] hover:bg-[#21262d] text-gray-300 text-xs font-mono font-medium transition-smooth"
            >
              Cancel
            </button>
            <button
              type="button"
              phx-click="apply_time_picker"
              class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-mono font-bold shadow-lg shadow-blue-500/25 transition-smooth"
            >
              Apply
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @pending_session_delete do %>
    <div
      id="delete-session-confirmation"
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_session_delete"
      data-sheet-return-id="command-palette-trigger"
      data-sheet-background-id="workspace-shell"
      class={[
        "fixed inset-0 z-50 flex items-end justify-center bg-[var(--sf-shadow)] p-4 sm:items-center"
      ]}
    >
      <div
        id="delete-session-confirmation-dialog"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_session_delete"
        data-initial-focus="#cancel-session-delete"
        role="dialog"
        aria-modal="true"
        aria-labelledby="delete-session-confirmation-title"
        tabindex="-1"
        class={["sf-chassis w-full max-w-md p-6"]}
      >
        <h2
          id="delete-session-confirmation-title"
          class={["text-lg font-semibold text-[var(--sf-text-primary)]"]}
        >
          Delete session?
        </h2>
        <p class={["mt-2 text-sm text-[var(--sf-text-secondary)]"]}>
          This permanently removes
          <strong class={["text-[var(--sf-text-primary)]"]}>{@pending_session_delete.title}</strong>
          and its history.
        </p>
        <div class={["mt-6 flex justify-end gap-3"]}>
          <button
            id="cancel-session-delete"
            type="button"
            phx-click="cancel_session_delete"
            class={["sf-control min-h-11 px-4 text-sm"]}
          >
            Cancel
          </button>
          <button
            id="delete-session-confirm"
            type="button"
            phx-click="confirm_session_delete"
            class={[
              "sf-control min-h-11 border-[var(--sf-live-mark)] bg-transparent px-4 text-sm text-[var(--sf-live-text)]"
            ]}
          >
            Delete session
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <.command_palette
    show={@show_command_palette}
    query={@command_palette_query}
    search_form={@command_palette_form}
    category={@command_palette_category}
    results={@command_palette_results}
    selected_index={@command_palette_selected_index}
  />
</Layouts.app>
