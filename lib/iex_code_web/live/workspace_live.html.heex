<Layouts.app flash={@flash} current_scope={@current_scope}>
  <a href="#main-content" class="workspace-skip-link">Skip to workspace content</a>
  <div
    id="workspace-shell"
    phx-hook="InstrumentDeck"
    data-active-view={@active_view}
    data-project-id={@project.id}
    data-session-id={@session.id}
    class="workspace-shell flex h-dvh min-h-0 w-full bg-[var(--sf-canvas-deep)] text-[var(--sf-text-primary)] font-sans antialiased overflow-hidden"
  >
    <main
      id="main-content"
      tabindex="-1"
      class="flex-1 flex flex-col h-full min-w-0 bg-[var(--sf-canvas-deep)] text-[var(--sf-text-primary)] relative overflow-hidden"
    >
      <h1 class="sr-only">IexCode workspace: {@project.name}</h1>
      <.mission_strip
        project={@project}
        session={@session}
        runtime={@runtime_status}
        active_view={@active_view}
      >
        <:primary_action>
          <%= if @active_view == "deck" do %>
            <button
              id="new-mission-button"
              type="button"
              phx-click="open_goal_modal"
              class="sf-control min-h-11 px-4 text-sm font-semibold"
            >
              New mission
            </button>
          <% else %>
            <button
              id="return-to-instrument-deck-action"
              type="button"
              phx-click="return_to_instrument_deck"
              class="sf-control min-h-11 px-4 text-sm font-semibold"
            >
              Return to instruments
            </button>
          <% end %>
        </:primary_action>
      </.mission_strip>

      <!-- View Containers -->
      <div id="workspace-views" class="relative flex-1 flex min-w-0 overflow-hidden">
        <%= if @active_view == "deck" do %>
          <%= if @resume_instrument != nil do %>
            <.link
              id="resume-instrument"
              patch={@resume_instrument.path}
              data-surface={@resume_instrument.surface}
              class={[
                "sf-focus-surface absolute right-5 top-5 z-10 rounded-full border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] px-4 py-2 text-xs font-semibold tracking-wide text-[var(--sf-text-primary)] transition-colors hover:bg-[var(--sf-raised-control)] md:right-7 md:top-7"
              ]}
            >
              Resume {@resume_instrument.title}
            </.link>
          <% end %>
          <.instrument_deck summaries={@instrument_summaries} active_view={@active_view} />
        <% else %>
          <%!-- Mission Board workbench --%>
        <%= if @active_view == "kanban" do %>
          <.workbench_chassis
            id="instrument-workbench-kanban"
            surface="kanban"
            index="02"
            title="Mission Board"
            status={"#{length(@tasks)} visible tasks · #{@expanded_task_status} selected"}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-kanban"
          >
            <:primary_action>
              <button
                id="kanban-primary-new-task"
                type="button"
                phx-click="toggle_new_task_modal"
                class="sf-control min-h-11 px-4 text-sm font-semibold"
              >
                New task
              </button>
            </:primary_action>
            <:primary_field>
          <div class="kanban-workbench flex min-h-0 flex-1 flex-col">
            <header class="kanban-toolbar">
              <div>
                <p class="sf-metadata">Project-wide mission queue</p>
                <h3 class="mt-1 text-base font-semibold text-[var(--sf-text-primary)]">
                  Tasks <span class="font-mono text-xs text-[var(--sf-text-secondary)]">{length(@tasks)}</span>
                </h3>
              </div>
              <.form
                for={@kanban_filter_form}
                id="kanban-filter-form"
                phx-change="filter_kanban"
                class="kanban-filter-form"
              >
                <.input
                  field={@kanban_filter_form[:search]}
                  id="kanban-filter-search"
                  type="text"
                  label="Filter tasks"
                  placeholder="Filter tasks"
                  autocomplete="off"
                  class="kanban-filter-control"
                />
                <.input
                  field={@kanban_filter_form[:priority]}
                  id="kanban-filter-priority"
                  type="select"
                  aria-label="Filter by priority"
                  options={[{"All priorities", ""} | Enum.map(Kanban.Task.priorities(), &{String.capitalize(&1), &1})]}
                  class="kanban-filter-control"
                />
                <.input
                  field={@kanban_filter_form[:status]}
                  id="kanban-filter-status"
                  type="select"
                  aria-label="Filter by status"
                  options={[{"All statuses", ""} | Enum.map(Kanban.Task.statuses(), &{String.capitalize(&1), &1})]}
                  class="kanban-filter-control"
                />
                <.input
                  field={@kanban_filter_form[:assignee]}
                  id="kanban-filter-assignee"
                  type="select"
                  aria-label="Filter by assignee"
                  options={[
                    {"All assignees", ""},
                    {"Default", "default"},
                    {"Planner", "planner"},
                    {"Coder", "coder"},
                    {"Verifier", "verifier"}
                  ]}
                  class="kanban-filter-control"
                />
              </.form>
            </header>

            <% kanban_filters_active? =
              Enum.any?(@kanban_filter, fn {_key, value} -> value != "" end) %>

            <div
              :if={@tasks == [] and kanban_filters_active?}
              id="kanban-filter-empty-state"
              class="kanban-empty-state"
            >
              <div class="flex items-start gap-3">
                <span class="kanban-empty-state__icon">
                  <.icon name="hero-funnel" class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-[var(--sf-text-primary)]">No tasks match these filters</p>
                  <p class="mt-1 max-w-xl text-sm leading-5 text-[var(--sf-text-secondary)]">
                    Your tasks are still here. Clear the active search and filters to show the full board.
                  </p>
                </div>
              </div>
              <button
                id="kanban-clear-filters"
                type="button"
                phx-click="clear_kanban_filters"
                class="sf-control inline-flex min-h-11 shrink-0 items-center gap-2 px-3.5 text-sm font-semibold"
              >
                <.icon name="hero-x-mark" class="h-3.5 w-3.5" /> Clear filters
              </button>
            </div>

            <div
              :if={@tasks == [] and !kanban_filters_active?}
              id="kanban-empty-state"
              class="kanban-empty-state"
            >
              <div class="flex items-start gap-3">
                <span class="kanban-empty-state__icon">
                  <.icon name="hero-rectangle-stack" class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-[var(--sf-text-primary)]">Your task board is ready</p>
                  <p class="mt-1 max-w-xl text-sm leading-5 text-[var(--sf-text-secondary)]">
                    This workspace starts empty. Add a task when you are ready—nothing will be
                    scheduled or executed automatically.
                  </p>
                </div>
              </div>
              <button
                id="kanban-empty-create-task"
                type="button"
                phx-click="toggle_new_task_modal"
                class="sf-control kanban-signal-control inline-flex min-h-11 shrink-0 items-center gap-2 px-3.5 text-sm font-semibold"
              >
                <.icon name="hero-plus" class="h-3.5 w-3.5" /> Create first task
              </button>
            </div>

            <%!-- Mission Board flat channels --%>
            <div id="task-move-focus-host" phx-hook="TaskMoveFocus"></div>
            <p
              id="task-move-live-region"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              class="sr-only"
            >
              {@task_move_announcement}
            </p>

            <div
              id="kanban-board"
              role="region"
              aria-label="Task status board"
              class="kanban-board"
            >
              <%= for col_status <- Kanban.Task.statuses() do %>
                <% col_tasks = Enum.filter(@tasks, &(&1.status == col_status))
                selected? = @expanded_task_status == col_status %>

                <section
                  id={"kanban-col-#{col_status}"}
                  phx-hook=".KanbanDrag"
                  phx-click="expand_task_status"
                  phx-value-status={col_status}
                  data-status={col_status}
                  data-channel-state={if(selected?, do: "selected", else: "quiet")}
                  aria-expanded={to_string(selected?)}
                  class={[
                    "kanban-channel",
                    selected? && "kanban-channel--selected",
                    !selected? && "kanban-channel--quiet"
                  ]}
                >
                  <button
                    id={"kanban-channel-trigger-#{col_status}"}
                    type="button"
                    phx-click="expand_task_status"
                    phx-value-status={col_status}
                    aria-controls={if(selected?, do: "kanban-cards-#{col_status}", else: nil)}
                    aria-expanded={to_string(selected?)}
                    class="kanban-channel__trigger"
                  >
                    <span class="kanban-channel__identity">
                      <span class="kanban-channel__mark" aria-hidden="true"></span>
                      <span class="kanban-channel__label">{String.upcase(col_status)}</span>
                    </span>
                    <span class="kanban-channel__gauge" aria-hidden="true">
                      <span
                        class="kanban-channel__gauge-fill"
                        style={"--kanban-gauge: #{min(length(col_tasks), 8) / 8 * 100}%"}
                      ></span>
                    </span>
                    <span
                      class="kanban-channel__count"
                      aria-label={"#{length(col_tasks)} tasks"}
                    >
                      {length(col_tasks)}
                    </span>
                  </button>

                  <div
                    :if={selected?}
                    id={"kanban-cards-#{col_status}"}
                    class="kanban-task-list"
                  >
                    <div :if={col_tasks == []} class="kanban-channel__empty">
                      No tasks in this channel
                    </div>
                    <%= for task <- col_tasks do %>
                      <article
                        id={"task-row-#{task.id}"}
                        phx-hook=".KanbanCard"
                        data-task-id={task.id}
                        class={[
                          "kanban-task-row",
                          @selected_task && @selected_task.id == task.id &&
                            "kanban-task-row--selected"
                        ]}
                      >
                        <button
                          type="button"
                          id={"task-card-#{task.id}"}
                          phx-click="open_task_drawer"
                          phx-value-id={task.id}
                          class="kanban-task-card"
                        >
                          <span class="kanban-task-card__meta">
                            <span>#{String.slice(task.id, 0..4)}</span>
                            <span>{String.upcase(task.priority || "medium")} priority</span>
                          </span>
                          <span class="kanban-task-card__title">{task.title}</span>
                          <span :if={task.description} class="kanban-task-card__description">
                            {task.description}
                          </span>
                          <span class="kanban-task-card__footer">
                            <span>{task.assignee || "default"}</span>
                            <span>{task.status}</span>
                          </span>
                        </button>

                        <button
                          id={"move-task-trigger-#{task.id}"}
                          type="button"
                          phx-click="open_task_move"
                          phx-value-id={task.id}
                          aria-expanded={to_string(@moving_task_id == task.id)}
                          aria-controls={"move-task-form-#{task.id}"}
                          class="kanban-move-trigger"
                        >
                          <.icon name="hero-arrows-right-left" class="size-4" />
                          <span>Move task</span>
                        </button>

                        <%= if @moving_task_id == task.id and @task_move_form do %>
                          <.form
                            for={@task_move_form}
                            id={"move-task-form-#{task.id}"}
                            phx-submit="move_task"
                            phx-hook="TaskMoveReturn"
                            data-task-id={task.id}
                            data-task-move-cancel-event="cancel_task_move"
                            data-task-move-return-id={"move-task-trigger-#{task.id}"}
                            class="kanban-move-form"
                          >
                            <.input field={@task_move_form[:id]} type="hidden" />
                            <.input
                              field={@task_move_form[:status]}
                              id={"move-task-status-#{task.id}"}
                              type="select"
                              label="Destination"
                              options={Kanban.Task.statuses()}
                              class="kanban-move-select"
                            />
                            <div class="kanban-move-form__actions">
                              <button
                                type="submit"
                                phx-disable-with="Moving…"
                                class="sf-control kanban-move-submit"
                              >
                                Move
                              </button>
                              <button
                                type="button"
                                phx-click={
                                  JS.push("cancel_task_move", value: %{id: task.id})
                                  |> JS.focus(to: "#move-task-trigger-#{task.id}")
                                }
                                class="sf-control kanban-move-cancel"
                              >
                                Cancel
                              </button>
                            </div>
                          </.form>
                        <% end %>
                      </article>
                    <% end %>
                  </div>
                </section>
              <% end %>
            </div>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanDrag">
            export default {
              mounted() {
                this.onDragOver = (event) => {
                  event.preventDefault()
                  this.el.classList.add("kanban-drop-active")
                }
                this.onDragLeave = () => this.el.classList.remove("kanban-drop-active")
                this.onDrop = (event) => {
                  event.preventDefault()
                  this.el.classList.remove("kanban-drop-active")
                  const id = event.dataTransfer.getData("text/plain")
                  const status = this.el.dataset.status
                  if (id && status) this.pushEvent("move_task", {id, status})
                }
                this.el.addEventListener("dragover", this.onDragOver)
                this.el.addEventListener("dragleave", this.onDragLeave)
                this.el.addEventListener("drop", this.onDrop)
              },
              destroyed() {
                this.el.classList.remove("kanban-drop-active")
                this.el.removeEventListener("dragover", this.onDragOver)
                this.el.removeEventListener("dragleave", this.onDragLeave)
                this.el.removeEventListener("drop", this.onDrop)
              }
            }
          </script>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanCard">
            export default {
              mounted() {
                this.el.setAttribute("draggable", "true")
                this.onDragStart = (event) => {
                  this.el.classList.add("card-dragging")
                  event.dataTransfer.setData("text/plain", this.el.dataset.taskId)
                }
                this.onDragEnd = () => this.el.classList.remove("card-dragging")
                this.el.addEventListener("dragstart", this.onDragStart)
                this.el.addEventListener("dragend", this.onDragEnd)
              },
              destroyed() {
                this.el.classList.remove("card-dragging")
                this.el.removeEventListener("dragstart", this.onDragStart)
                this.el.removeEventListener("dragend", this.onDragEnd)
              }
            }
          </script>
          </div>
            </:primary_field>
            <:signal_panel>
              <section id="kanban-signal-panel" aria-labelledby="kanban-signal-title">
                <p class="sf-metadata">Board signal</p>
                <h3 id="kanban-signal-title" class="mt-2 text-base font-semibold">
                  {@expanded_task_status |> String.upcase()}
                </h3>
                <p class="mt-2 text-sm leading-6 text-[var(--sf-text-secondary)]">
                  Activate a quiet gauge to inspect its tasks. Drag between channels or use each
                  task's Move task control for a keyboard and touch-safe transfer.
                </p>
                <dl class="mt-5 grid gap-3 text-xs">
                  <%= for status <- Kanban.Task.statuses() do %>
                    <div class="flex items-center justify-between border-t border-[var(--sf-hairline)] pt-3">
                      <dt>{String.upcase(status)}</dt>
                      <dd>{Enum.count(@tasks, &(&1.status == status))}</dd>
                    </div>
                  <% end %>
                </dl>
              </section>
            </:signal_panel>
            <:command_dock>
              <.shared_command_dock workspace_assigns={assigns} />
            </:command_dock>
          </.workbench_chassis>
        <% end %>

        <%!-- TAB 2: ACTIVE MISSION / COACH & SWARM --%>
        <%= if @active_view == "swarm" do %>
          <.workbench_chassis
            id="instrument-workbench-swarm"
            surface="swarm"
            index="01"
            title="Active Mission"
            status={if(@selected_run, do: String.capitalize(@selected_run.status), else: "No active run")}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-swarm"
          >
            <:primary_action>
              <button
                id="new-goal-button"
                type="button"
                phx-click="open_goal_modal"
                class="sf-control min-h-11 px-4 text-sm font-semibold"
              >
                <.icon name="hero-plus" class="size-4" />
                <span>New mission</span>
              </button>
            </:primary_action>
            <:local_modes>
              <.mission_control_tabs mode={@mission_control_mode} />
            </:local_modes>
            <:primary_field>
              <.run_control_plane
                runs={@run_rows}
                run_count={@run_count}
                run_counts={@run_counts}
                selected_run={@selected_run}
                steps={@run_steps}
                events={@run_event_rows}
                approvals={@run_approvals}
                artifacts={@run_artifacts}
                controls={@run_controls}
                run_manifest={@run_manifest}
                stats={@run_dispatcher_stats}
                workspace_locks={@workspace_locks}
                agents={@streams.run_agents}
                agent_count={@run_agent_count}
                fleet_summary={@run_fleet_summary}
                fleet_loading={@run_fleet_loading?}
                agent_guidance={@run_agent_guidance}
                agent_receipts={@run_agent_receipts}
                dag_projection={@dag_projection}
                mode={@mission_control_mode}
                phase={@mission_control_phase}
              >
                <:interactive_execution>
                  <section
                    id="mission-control-interactive-execution"
                    aria-labelledby="mission-control-interactive-execution-title"
                    class="mt-4 space-y-5"
                  >
                    <h3 id="mission-control-interactive-execution-title" class="sr-only">
                      Interactive session execution controls
                    </h3>
                    <div id="interactive-coach-session-surface" class="sf-coach-session-surface">
                      <header class="sf-coach-session-header">
                        <div class="min-w-0">
                          <p class="sf-metadata">Interactive session plane</p>
                          <h4 class="mt-1 text-lg font-semibold text-[var(--sf-text-primary)]">Milo · session coach</h4>
                          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--sf-text-secondary)]">
                            These controls target the current interactive session, not the durable run selected above.
                            Use the selected-run controls for durable pause, cancel, retry, and steering.
                          </p>
                        </div>
                        <p id="interactive-session-status" role="status" class="sf-coach-session-status">
                          Session status · {String.upcase(to_string(@session.status || "idle"))}
                        </p>
                      </header>

                      <div class="sf-coach-capabilities" aria-label="Interactive session capabilities">
                        <span>Native terminal</span>
                        <span>Scheduler</span>
                        <span>Git and tests</span>
                        <span>SQLite journal</span>
                      </div>

                      <div class="sf-coach-control-grid">
                        <div
                          class="relative min-w-0"
                          phx-click-away={@open_dropdown == "coach_menu" && "close_dropdowns"}
                        >
                          <button
                            id="coach-actions-toggle"
                            type="button"
                            phx-click="toggle_coach_menu"
                            aria-expanded={to_string(@open_dropdown == "coach_menu")}
                            aria-controls="coach-actions-disclosure"
                            class="sf-control min-h-11 w-full justify-center px-3 text-sm font-semibold sm:w-auto"
                          >
                            <.icon name="hero-ellipsis-horizontal" class="size-4" />
                            Session actions
                          </button>
                          <div
                            :if={@open_dropdown == "coach_menu"}
                            id="coach-actions-disclosure"
                            class="sf-coach-actions-disclosure"
                          >
                            <button
                              type="button"
                              phx-click="switch_tab"
                              phx-value-tab="terminal"
                              class="sf-control min-h-11 w-full justify-start px-3 text-sm"
                            >
                              <.icon name="hero-command-line" class="size-4" />
                              Open Terminal
                            </button>
                            <button
                              type="button"
                              phx-click="clear_operations"
                              data-confirm="Clear this session's operation history?"
                              class="sf-control min-h-11 w-full justify-start px-3 text-sm"
                            >
                              <.icon name="hero-trash" class="size-4" />
                              Clear operations
                            </button>
                          </div>
                        </div>

                        <div class="flex min-w-0 flex-wrap gap-2">
                          <%= if @session.status in ["running", :running] do %>
                            <button
                              type="button"
                              phx-click="pause_session"
                              class="sf-control min-h-11 px-3 text-sm font-semibold"
                              title="Pause active execution without losing state"
                            >
                              <.icon name="hero-pause" class="size-4" /> Pause session
                            </button>
                          <% else %>
                            <button
                              type="button"
                              phx-click="resume_session"
                              class="sf-control min-h-11 px-3 text-sm font-semibold"
                              title="Resume paused execution"
                            >
                              <.icon name="hero-play" class="size-4" /> Resume session
                            </button>
                          <% end %>
                          <button
                            type="button"
                            phx-click="open_cancel_modal"
                            class="sf-control min-h-11 px-3 text-sm font-semibold"
                            title="Stop session with rollback or commit"
                          >
                            <.icon name="hero-stop" class="size-4" /> Stop session
                          </button>
                        </div>

                        <.form
                          for={@session_steering_form}
                          id="steering-form"
                          phx-change="update_session_steering"
                          phx-submit="send_steering"
                          class="sf-coach-steering-form"
                        >
                          <.input
                            field={@session_steering_form[:steering]}
                            id="session-steering-input"
                            type="text"
                            label="Session steering guidance"
                            placeholder="Steer the interactive session…"
                            class="min-h-11 min-w-0 w-full border border-[var(--sf-hairline)] bg-[var(--sf-code-surface)] px-3 text-sm text-[var(--sf-text-primary)] outline-none placeholder:text-[var(--sf-text-secondary)]"
                          />
                          <button
                            id="session-steering-submit"
                            type="submit"
                            phx-disable-with="Sending…"
                            class="sf-control min-h-11 px-4 text-sm font-semibold"
                          >
                            <.icon name="hero-paper-airplane" class="size-4" />
                            Steer
                          </button>
                        </.form>

                        <p class="sf-metadata self-center">Session-scoped controls</p>
                      </div>
                    </div>

            <%!-- Visible error state for failed operations --%>
            <% failed_ops = Enum.filter(@operations, &(&1.status == "failed")) %>
            <%= if failed_ops != [] do %>
              <div
                role="alert"
                class="flex items-center gap-2.5 border border-[var(--sf-hairline)] px-4 py-3 text-sm text-[var(--sf-text-primary)]"
              >
                <.icon name="hero-exclamation-triangle" class="size-4 shrink-0" />
                <span class="min-w-0 break-words">
                  {length(failed_ops)} operation{if length(failed_ops) == 1, do: "", else: "s"} failed
                  <%= latest_error = Enum.find_value(failed_ops, & &1.error_message)
                  if latest_error do %>
                    <span>· {latest_error}</span>
                  <% end %>
                </span>
              </div>
            <% end %>

            <div id="interactive-operation-history-note" class="border-l border-[var(--sf-hairline)] pl-3">
              <p class="text-sm font-semibold text-[var(--sf-text-primary)]">Interactive operation history</p>
              <p class="mt-1 text-sm leading-6 text-[var(--sf-text-secondary)]">
                Session-scoped tool activity is kept separate from the selected run's persisted fleet.
              </p>
            </div>
            <section
              id="interactive-role-templates"
              aria-labelledby="interactive-role-templates-heading"
            >
              <div class="mb-3 flex items-start gap-2 border border-[var(--sf-hairline)] px-3 py-3">
                <.icon
                  name="hero-information-circle"
                  class="mt-1 size-4 shrink-0 text-[var(--sf-text-secondary)]"
                />
                <div>
                  <h3
                    id="interactive-role-templates-heading"
                    class="sf-metadata font-semibold"
                  >
                    Interactive role templates
                  </h3>
                  <p class="mt-1 text-sm leading-6 text-[var(--sf-text-secondary)]">
                    Fixed session role templates show legacy operation telemetry only. Idle cards do not represent live or persisted workers.
                  </p>
                </div>
              </div>
              <.subagent_cards
                operations={@operations}
                active_agent={@active_agent}
                active_stage={@active_stage}
                swarm_mode={@session.swarm_mode}
              />
            </section>
            <.operation_tree
              operations={@operations}
              expanded_ops={@expanded_ops}
            />
                  </section>
                </:interactive_execution>
              </.run_control_plane>
            </:primary_field>
            <:signal_panel>
              <.mission_control_signal_panel
                selected_run={@selected_run}
                run_counts={@run_counts}
                workspace_locks={@workspace_locks}
                stats={@run_dispatcher_stats}
              />
            </:signal_panel>
            <:command_dock>
              <.shared_command_dock workspace_assigns={assigns} />
            </:command_dock>
          </.workbench_chassis>
        <% end %>

        <%!-- TAB 3: SCHEDULE CHRONOMETER --%>
        <%= if @active_view == "calendar" do %>
          <% agenda_items = calendar_agenda_items(@tasks) %>
          <.workbench_chassis
            id="instrument-workbench-calendar"
            surface="calendar"
            index="04"
            title="Schedule Chronometer"
            status={@instrument_summaries["calendar"].primary}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-calendar"
          >
            <:primary_action>
              <button
                id="calendar-primary-new-task"
                type="button"
                phx-click="toggle_new_task_modal"
                phx-disable-with="Opening…"
                class="sf-control min-h-11 px-4 text-sm font-semibold"
              >
                Schedule action
              </button>
            </:primary_action>
            <:local_modes>
              <% today = Date.utc_today() %>
              <div id="calendar-controls" class="flex flex-wrap items-center gap-2">
                <button
                  id="calendar-today"
                  type="button"
                  phx-click="select_calendar_day"
                  phx-value-day={today.day}
                  phx-value-date={Date.to_iso8601(today)}
                  class="sf-control min-h-11 px-3 text-sm font-semibold"
                >
                  Today
                </button>
                <button
                  id="calendar-prev-month"
                  type="button"
                  phx-click="calendar_prev_month"
                  aria-label="Previous month"
                  class="sf-control inline-flex min-h-11 min-w-11 items-center justify-center p-2"
                >
                  <.icon name="hero-chevron-left" class="size-4" />
                </button>
                <button
                  id="calendar-next-month"
                  type="button"
                  phx-click="calendar_next_month"
                  aria-label="Next month"
                  class="sf-control inline-flex min-h-11 min-w-11 items-center justify-center p-2"
                >
                  <.icon name="hero-chevron-right" class="size-4" />
                </button>
                <button
                  id="calendar-focus-time-btn"
                  type="button"
                  phx-click="open_time_picker"
                  phx-disable-with="Opening…"
                  class="sf-control inline-flex min-h-11 items-center gap-2 px-3 text-sm font-semibold"
                  title="Set focus time and availability window"
                >
                  <.icon name="hero-clock" class="size-4" />
                  <span>Set focus time</span>
                </button>
              </div>
            </:local_modes>
            <:primary_field>
              <div class="calendar-workbench">
                <h3 id="calendar-focus-return-target" phx-hook="CalendarDeleteFocus" tabindex="-1" class="calendar-focus-return-target">
                  Schedule Chronometer
                </h3>
                <section
                  id="calendar-mobile-agenda"
                  data-mobile-default="true"
                  aria-labelledby="calendar-mobile-agenda-title"
                  class="sm:hidden"
                >
                  <header class="calendar-agenda-heading">
                    <div>
                      <p class="sf-metadata">UTC-forward schedule</p>
                      <h3 id="calendar-mobile-agenda-title" class="calendar-section-title">
                        Upcoming actions
                      </h3>
                    </div>
                    <span class="calendar-agenda-limit">Earliest 100</span>
                  </header>
                  <div id="calendar-mobile-agenda-items" class="calendar-agenda-list">
                    <p
                      :if={agenda_items == []}
                      id="calendar-mobile-agenda-empty"
                      class="calendar-empty-state"
                    >
                      No scheduled actions
                    </p>
                    <%= for task <- agenda_items do %>
                      <article
                        id={"calendar-mobile-agenda-item-#{task.id}"}
                        class="calendar-agenda-row"
                      >
                        <button
                          id={"calendar-mobile-agenda-open-#{task.id}"}
                          type="button"
                          phx-click="show_scheduled_task"
                          phx-value-id={task.id}
                          phx-disable-with="Opening…"
                          aria-label={"Open #{task.title}"}
                          class="calendar-agenda-open min-h-11"
                        >
                          <span class="calendar-agenda-meta">
                            <span>{String.upcase(task.status)}</span>
                            <span>{String.upcase(task.priority || "medium")} priority</span>
                          </span>
                          <span class="calendar-agenda-title">{task.title}</span>
                          <time
                            id={"calendar-local-time-#{task.id}"}
                            phx-hook="LocalTime"
                            phx-update="ignore"
                            data-utc={DateTime.to_iso8601(task.scheduled_at)}
                            datetime={DateTime.to_iso8601(task.scheduled_at)}
                            class="calendar-agenda-time"
                          >{DateTime.to_iso8601(task.scheduled_at)} UTC</time>
                        </button>
                        <div class="calendar-agenda-actions" aria-label={"Actions for #{task.title}"}>
                          <button
                            id={"calendar-mobile-agenda-run-#{task.id}"}
                            type="button"
                            phx-click="run_scheduled_task"
                            phx-value-id={task.id}
                            phx-disable-with="Running…"
                            aria-label={"Run #{task.title} now"}
                            class="sf-control min-h-11 px-3 text-sm font-semibold"
                          >Run now</button>
                          <button
                            id={"calendar-mobile-agenda-edit-#{task.id}"}
                            type="button"
                            phx-click="open_edit_scheduled_task"
                            phx-value-id={task.id}
                            phx-disable-with="Opening…"
                            aria-label={"Edit #{task.title}"}
                            class="sf-control min-h-11 px-3 text-sm font-semibold"
                          >Edit</button>
                          <button
                            id={"calendar-mobile-agenda-delete-trigger-#{task.id}"}
                            type="button"
                            phx-click="request_calendar_task_delete"
                            phx-value-id={task.id}
                            phx-value-source="mobile"
                            phx-disable-with="Opening…"
                            aria-label={"Delete #{task.title}"}
                            class="sf-control calendar-delete-control min-h-11 px-3 text-sm font-semibold"
                          >Delete</button>
                        </div>
                      </article>
                    <% end %>
                  </div>
                </section>

                <section
                  id="calendar-month-view"
                  aria-labelledby="calendar-month-title"
                  class="hidden sm:block"
                >
                  <div class="calendar-desktop-layout">
                    <div class="calendar-month-field">
                      <header class="calendar-month-heading">
                        <p class="sf-metadata">Monday-first month</p>
                        <h3 id="calendar-month-title" class="calendar-section-title">
                          {month_name(@calendar_month)}, {@calendar_year}
                        </h3>
                      </header>

                      <div id="calendar-weekdays" class="calendar-weekdays">
                        <%= for day_name <- ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] do %>
                          <div
                            id={"calendar-weekday-#{String.downcase(day_name)}"}
                            class="calendar-weekday"
                          >
                            {day_name}
                          </div>
                        <% end %>
                      </div>

                      <div id="calendar-grid" class="calendar-grid">
                        <%= for cell <- calendar_grid_cells(@calendar_year, @calendar_month, @selected_calendar_date) do %>
                          <% day_tasks =
                            if cell.is_current_month, do: tasks_for_day(@tasks, cell), else: []

                          date_str =
                            "#{cell.year}-#{String.pad_leading("#{cell.month}", 2, "0")}-#{String.pad_leading("#{cell.day}", 2, "0")}"

                          cell_id =
                            if cell.is_current_month,
                              do: "calendar-day-#{cell.day}",
                              else: "calendar-day-pad-#{cell.year}-#{cell.month}-#{cell.day}" %>
                          <div
                            id={cell_id}
                            class={[
                              "calendar-day",
                              cell.is_current_month && "calendar-day--current-month",
                              !cell.is_current_month && "calendar-day--padding",
                              cell.is_selected && "calendar-day--selected",
                              cell.is_today && "calendar-day--today"
                            ]}
                          >
                            <button
                              type="button"
                              id={"#{cell_id}-select"}
                              phx-click="select_calendar_day"
                              phx-value-day={cell.day}
                              phx-value-date={date_str}
                              aria-label={"Schedule task on #{date_str}"}
                              aria-pressed={cell.is_selected}
                              class="calendar-day-select"
                              title={"Schedule task on #{date_str}"}
                            >
                              <span class="sr-only">Schedule task on {date_str}</span>
                            </button>
                            <div class="calendar-day-header" aria-hidden="true">
                              <span>{cell.day}</span>
                              <span :if={cell.is_today}>Today</span>
                            </div>
                            <div class="calendar-day-tasks">
                              <%= for task <- day_tasks do %>
                                <button
                                  type="button"
                                  id={"calendar-task-#{cell.day}-#{task.id}"}
                                  phx-click="show_scheduled_task"
                                  phx-value-id={task.id}
                                  phx-disable-with="Opening…"
                                  class="calendar-day-task"
                                  title={task.title}
                                >
                                  <span>{task.title}</span>
                                </button>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <aside
                      id="calendar-desktop-agenda"
                      aria-labelledby="calendar-desktop-agenda-title"
                      class="calendar-desktop-agenda"
                    >
                      <header class="calendar-agenda-heading">
                        <div>
                          <p class="sf-metadata">UTC-forward schedule</p>
                          <h3 id="calendar-desktop-agenda-title" class="calendar-section-title">
                            Agenda
                          </h3>
                        </div>
                        <span class="calendar-agenda-limit">Earliest 100</span>
                      </header>
                      <div id="calendar-desktop-agenda-items" class="calendar-agenda-list">
                        <p
                          :if={agenda_items == []}
                          id="calendar-desktop-agenda-empty"
                          class="calendar-empty-state"
                        >
                          No scheduled actions
                        </p>
                        <%= for task <- agenda_items do %>
                          <article
                            id={"calendar-desktop-agenda-item-#{task.id}"}
                            class="calendar-agenda-row"
                          >
                            <button
                              id={"calendar-desktop-agenda-open-#{task.id}"}
                              type="button"
                              phx-click="show_scheduled_task"
                              phx-value-id={task.id}
                              phx-disable-with="Opening…"
                              aria-label={"Open #{task.title}"}
                              class="calendar-agenda-open min-h-11"
                            >
                              <span class="calendar-agenda-meta">
                                <span>{String.upcase(task.status)}</span>
                                <span>{String.upcase(task.priority || "medium")} priority</span>
                              </span>
                              <span class="calendar-agenda-title">{task.title}</span>
                              <time
                                id={"calendar-local-time-desktop-#{task.id}"}
                                phx-hook="LocalTime"
                                phx-update="ignore"
                                data-utc={DateTime.to_iso8601(task.scheduled_at)}
                                datetime={DateTime.to_iso8601(task.scheduled_at)}
                                class="calendar-agenda-time"
                              >{DateTime.to_iso8601(task.scheduled_at)} UTC</time>
                            </button>
                            <div class="calendar-agenda-actions" aria-label={"Actions for #{task.title}"}>
                              <button
                                id={"calendar-desktop-agenda-run-#{task.id}"}
                                type="button"
                                phx-click="run_scheduled_task"
                                phx-value-id={task.id}
                                phx-disable-with="Running…"
                                aria-label={"Run #{task.title} now"}
                                class="sf-control min-h-11 px-3 text-sm font-semibold"
                              >Run</button>
                              <button
                                id={"calendar-desktop-agenda-edit-#{task.id}"}
                                type="button"
                                phx-click="open_edit_scheduled_task"
                                phx-value-id={task.id}
                                phx-disable-with="Opening…"
                                aria-label={"Edit #{task.title}"}
                                class="sf-control min-h-11 px-3 text-sm font-semibold"
                              >Edit</button>
                              <button
                                id={"calendar-desktop-agenda-delete-trigger-#{task.id}"}
                                type="button"
                                phx-click="request_calendar_task_delete"
                                phx-value-id={task.id}
                                phx-value-source="desktop"
                                phx-disable-with="Opening…"
                                aria-label={"Delete #{task.title}"}
                                class="sf-control calendar-delete-control min-h-11 px-3 text-sm font-semibold"
                              >Delete</button>
                            </div>
                          </article>
                        <% end %>
                      </div>
                    </aside>
                  </div>
                </section>
              </div>
            </:primary_field>
            <:command_dock>
              <.shared_command_dock workspace_assigns={assigns} />
            </:command_dock>
          </.workbench_chassis>
        <% end %>

        <%!-- TAB 4: CHANGE LEDGER --%>
          <%= if @active_view == "changes" do %>
            <% summary = @instrument_summaries["changes"] %>
            <.workbench_chassis
              id="instrument-workbench-changes"
              surface="changes"
              index="05"
              title="Change Ledger"
              status={summary.primary || "Warming · checking Git"}
              return_to={workspace_path(@workspace_route, "deck")}
              return_instrument_id="instrument-card-changes"
            >
              <:primary_action>
                <button
                  id="changes-fetch-action"
                  type="button"
                  phx-click="git_fetch"
                  phx-disable-with="Fetching…"
                  class="sf-control min-h-11 inline-flex items-center gap-2 px-4 text-sm font-semibold"
                >
                  <.icon name="hero-arrow-down-tray" class="h-4 w-4" /> Fetch
                </button>
              </:primary_action>
              <:local_modes>
                <div
                  id="changes-subtab-switcher"
                  class="flex flex-wrap gap-2"
                  role="group"
                  aria-label="Change Ledger mode"
                >
                  <%= for {label, value} <- [{"Changes", "changes"}, {"All files", "all"}, {"Desktop", "desktop"}] do %>
                    <button
                      type="button"
                      phx-click="switch_changes_subtab"
                      phx-value-tab={value}
                      aria-pressed={to_string(@changes_subtab == value)}
                      class="sf-control min-h-11 px-3 text-xs"
                    >{label}</button>
                  <% end %>
                </div>
              </:local_modes>
              <:primary_field>
                <div id="changes-primary" class="changes-primary-field">
                  <div
                    id="changes-toolbar"
                    class="changes-toolbar sf-hairline-b flex flex-wrap items-center justify-between gap-3"
                  >
                    <div class="flex min-w-0 flex-wrap items-center gap-3">
                      <div
                        class="relative"
                        phx-click-away={@show_branch_menu && "close_branch_menu"}
                      >
                        <button
                          id="changes-branch-trigger"
                          type="button"
                          phx-click="toggle_branch_menu"
                          aria-expanded={to_string(@show_branch_menu)}
                          aria-controls="changes-branch-menu"
                          aria-label={"Current branch #{@current_branch}. Toggle branch menu"}
                          class="sf-control min-h-11 inline-flex max-w-full items-center gap-2 px-3 font-mono text-xs font-semibold"
                        >
                          <.icon name="hero-code-bracket-square" class="h-4 w-4" />
                          <span class="max-w-48 truncate">{@current_branch}</span>
                          <.icon name="hero-chevron-down" class="h-3.5 w-3.5" />
                        </button>
                        <div
                          :if={@show_branch_menu}
                          id="changes-branch-menu"
                          role="region"
                          aria-labelledby="changes-branch-menu-title"
                          class="absolute left-0 top-full z-20 mt-2 w-72 max-w-[calc(100vw-2rem)] border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] p-2 shadow-xl"
                        >
                          <div id="changes-branch-menu-title" class="px-2 py-1 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                            Branches
                          </div>
                          <div class="max-h-52 overflow-y-auto">
                            <%= for branch <- @git_branches do %>
                              <button
                                type="button"
                                phx-click="switch_git_branch"
                                phx-value-branch={branch.name}
                                class={[
                                  "flex min-h-11 w-full items-center justify-between px-2 text-left font-mono text-xs",
                                  branch.current? && "text-[var(--sf-live-text)]",
                                  !branch.current? && "text-[var(--sf-text-primary)]"
                                ]}
                              >
                                <span class="truncate">{branch.name}</span>
                                <span :if={branch.current?} aria-label="Current branch">●</span>
                              </button>
                            <% end %>
                          </div>
                          <.form
                            for={@git_branch_form}
                            id="git-branch-form"
                            phx-submit="create_git_branch"
                            class="mt-2 flex gap-2 border-t border-[var(--sf-hairline)] pt-2"
                          >
                            <.input
                              field={@git_branch_form[:name]}
                              type="text"
                              id="git-branch-name"
                              label="New branch name"
                              placeholder="New branch name"
                              autocomplete="off"
                              class="sf-control min-h-11 min-w-0 flex-1 px-2 text-xs"
                            />
                            <button
                              type="submit"
                              phx-disable-with="Creating…"
                              class="sf-control min-h-11 px-3 text-xs"
                            >Create</button>
                          </.form>
                        </div>
                      </div>
                      <div
                        class="flex items-center gap-2 font-mono text-xs text-[var(--sf-text-secondary)]"
                        aria-label="Git sync facts"
                      >
                        <span>Ahead
                        <strong class="text-[var(--sf-text-primary)]">{if(@git_status,
                          do: @git_status.ahead,
                          else: 0
                        )}</strong></span>
                        <span aria-hidden="true">·</span>
                        <span>Behind
                        <strong class="text-[var(--sf-text-primary)]">{if(@git_status,
                          do: @git_status.behind,
                          else: 0
                        )}</strong></span>
                      </div>
                    </div>
                    <button
                      id="changes-pull-action"
                      type="button"
                      phx-click="git_pull"
                      phx-disable-with="Pulling…"
                      class="sf-control min-h-11 inline-flex items-center gap-2 px-3 text-xs"
                    >
                      <.icon name="hero-arrow-path" class="h-4 w-4" /> Pull
                    </button>
                  </div>

                  <div id="changes-layout" class="changes-layout">
                    <section
                      id="changes-staging-panel"
                      aria-labelledby="changes-staging-title"
                      class="changes-staging-panel"
                    >
                      <div class="flex items-center justify-between border-b border-[var(--sf-hairline)] pb-3">
                        <div>
                          <p class="sf-metadata">Bounded working tree</p>
                          <h3 id="changes-staging-title" tabindex="-1" class="mt-1 font-semibold">
                            Staging ledger
                          </h3>
                        </div>
                      </div>
                      <div class="changes-file-lists">
                        <section aria-labelledby="staged-heading">
                          <div class="changes-list-heading">
                            <h4 id="staged-heading">Staged</h4><button
                              :if={@staged_diffs != []}
                              type="button"
                              phx-click="unstage_all"
                              class="sf-control min-h-11 px-2 text-xs"
                            >Unstage all</button>
                          </div>
                          <div class="changes-list">
                            <%= for file_diff <- @staged_diffs do %>
                              <% path = file_diff.path || file_diff.new_path %>
                              <div class={[
                                "changes-file-row",
                                @selected_diff_file == path && @active_diff_scope == :staged &&
                                  "changes-file-row--selected"
                              ]}>
                                <button
                                  type="button"
                                  phx-click="select_diff_file"
                                  phx-value-file={path}
                                  phx-value-scope="staged"
                                  aria-label={"View staged #{path}"}
                                  class="changes-file-select"
                                ><span aria-hidden="true">S</span><span class="truncate">{path}</span></button>
                                <div class="flex items-center gap-1">
                                  <button
                                    type="button"
                                    phx-click="unstage_file"
                                    phx-value-file={path}
                                    aria-label={"Unstage #{path}"}
                                    class="sf-control min-h-11 min-w-11 px-2 text-xs"
                                  >−</button>
                                  <button
                                    id={"git-file-revert-trigger-#{git_path_digest("staged", path)}"}
                                    type="button"
                                    phx-click="request_revert_git_file"
                                    phx-value-file={path}
                                    phx-value-source="ledger"
                                    phx-value-scope="staged"
                                    aria-label={"Revert staged changes to #{path}"}
                                    class="sf-control min-h-11 min-w-11 px-2 text-xs"
                                  >↶</button>
                                </div>
                              </div>
                            <% end %>
                            <p :if={@staged_diffs == []} class="changes-empty">
                              No staged changes
                            </p>
                          </div>
                        </section>

                        <section aria-labelledby="unstaged-heading">
                          <div class="changes-list-heading">
                            <h4 id="unstaged-heading">Unstaged</h4><button
                              :if={@unstaged_diffs != []}
                              type="button"
                              phx-click="stage_all"
                              class="sf-control min-h-11 px-2 text-xs"
                            >Stage all</button>
                          </div>
                          <div class="changes-list">
                            <%= for file_diff <- @unstaged_diffs do %>
                              <% path = file_diff.path || file_diff.new_path %>
                              <div class={[
                                "changes-file-row",
                                @selected_diff_file == path && @active_diff_scope == :unstaged &&
                                  "changes-file-row--selected"
                              ]}>
                                <button
                                  type="button"
                                  phx-click="select_diff_file"
                                  phx-value-file={path}
                                  phx-value-scope="unstaged"
                                  aria-label={"View unstaged #{path}"}
                                  class="changes-file-select"
                                ><span aria-hidden="true">U</span><span class="truncate">{path}</span></button>
                                <div class="flex items-center gap-1">
                                  <button
                                    type="button"
                                    phx-click="stage_file"
                                    phx-value-file={path}
                                    aria-label={"Stage #{path}"}
                                    class="sf-control min-h-11 min-w-11 px-2 text-xs"
                                  >+</button>
                                  <button
                                    id={"git-file-revert-trigger-#{git_path_digest("unstaged", path)}"}
                                    type="button"
                                    phx-click="request_revert_git_file"
                                    phx-value-file={path}
                                    phx-value-source="ledger"
                                    phx-value-scope="unstaged"
                                    aria-label={"Revert changes to #{path}"}
                                    class="sf-control min-h-11 min-w-11 px-2 text-xs"
                                  >↶</button>
                                </div>
                              </div>
                            <% end %>
                            <p :if={@unstaged_diffs == []} class="changes-empty">
                              No unstaged changes
                            </p>
                          </div>
                        </section>

                        <section
                          :if={@git_status && @git_status.untracked != []}
                          aria-labelledby="untracked-heading"
                        >
                          <div class="changes-list-heading">
                            <h4 id="untracked-heading">Untracked</h4>
                          </div>
                          <div class="changes-list">
                            <%= for path <- @git_status.untracked do %>
                              <div class="changes-file-row">
                                <span class="changes-file-select"><span aria-hidden="true">?</span><span class="truncate">{path}</span></span>
                                <div class="flex items-center gap-1">
                                  <button type="button" phx-click="stage_file" phx-value-file={path} aria-label={"Stage untracked #{path}"} class="sf-control min-h-11 min-w-11 px-2 text-xs">+</button>
                                  <button id={"git-file-revert-trigger-#{git_path_digest("untracked", path)}"} type="button" phx-click="request_revert_git_file" phx-value-file={path} phx-value-source="ledger" phx-value-scope="untracked" aria-label={"Remove untracked #{path}"} class="sf-control min-h-11 min-w-11 px-2 text-xs">↶</button>
                                </div>
                              </div>
                            <% end %>
                          </div>
                        </section>

                        <section
                          :if={@git_status && @git_status.conflicted != []}
                          aria-labelledby="conflicted-heading"
                        >
                          <div class="changes-list-heading">
                            <h4 id="conflicted-heading">Conflicts</h4>
                          </div>
                          <div class="changes-list">
                            <%= for entry <- @git_status.conflicted do %>
                              <div class="changes-file-row">
                                <span class="changes-file-select"><span aria-hidden="true">!</span><span class="truncate">{entry.path}</span></span><span class="font-mono text-xs text-[var(--sf-live-text)]">Conflict</span>
                              </div>
                            <% end %>
                          </div>
                        </section>

                        <div
                          :if={@git_status && @git_status.truncated?}
                          id="git-status-truncated"
                          class="changes-truncation"
                        >
                          Showing bounded Git status. Retained status is capped to the workspace limit.
                        </div>
                      </div>
                      <div class="changes-commit-panel">
                        <div class="flex items-center justify-between gap-2">
                          <h4>Commit staged changes</h4><button
                            type="button"
                            phx-click="generate_commit_msg"
                            class="sf-control min-h-11 px-2 text-xs"
                          >AI generate</button>
                        </div>
                        <.form
                          for={@commit_form}
                          id="commit-composer-form"
                          phx-change="update_commit_message"
                          phx-submit="git_commit"
                          class="mt-3 space-y-2"
                        >
                          <.input
                            field={@commit_form[:message]}
                            id="commit-message"
                            type="textarea"
                            rows="3"
                            label="Commit message"
                            placeholder="Describe the staged change"
                            class="sf-code-surface min-h-24 w-full resize-y p-2 text-sm"
                          />
                          <button
                            type="submit"
                            phx-disable-with="Committing…"
                            disabled={
                              String.trim(@commit_message || "") == "" or @staged_diffs == []
                            }
                            class="sf-control min-h-11 w-full px-3 text-xs font-semibold"
                          >Commit to {@current_branch} ({length(@staged_diffs)} staged)</button>
                        </.form>
                      </div>
                    </section>

                    <section
                      id="changes-diff-panel"
                      tabindex="-1"
                      aria-label="Selected diff"
                      class="changes-diff-panel"
                    >
                      <div
                        :if={@diff_truncated?}
                        id="diff-preview-truncated"
                        class="changes-truncation"
                      >
                        Preview capped at 2 MiB. The repository content is unchanged; use Git locally for the complete diff.
                      </div>
                      <.interactive_diff_viewer
                        diff_text={@diff_text}
                        diff_mode={@diff_mode}
                        file_path={@diff_file_path}
                        hunks={@diff_hunks}
                        staged={@active_diff_scope == :staged}
                      />
                    </section>
                  </div>
                </div>
              </:primary_field>
              <:signal_panel>
              <section id="changes-signal-panel" data-summary-status={summary.status} aria-labelledby="changes-signal-title">
                  <p class="sf-metadata">Change Ledger signal</p>
                  <h3 id="changes-signal-title" class="mt-2 text-base font-semibold">
                    {summary.primary}
                  </h3>
                  <p
                    :if={summary.detail}
                    class="mt-2 text-sm leading-6 text-[var(--sf-text-secondary)]"
                  >
                    {summary.detail}
                  </p>
                  <dl class="changes-signal-facts">
                    <%= for fact <- summary.secondary do %>
                      <div>
                        <dt>{fact.label}</dt><dd>{fact.value}</dd>
                      </div>
                    <% end %>
                  </dl>
                </section>
              </:signal_panel>
              <:command_dock><.shared_command_dock workspace_assigns={assigns} /></:command_dock>
            </.workbench_chassis>
          <% end %>

          <!-- DEDICATED DEEP RESEARCH WORKSPACE -->
        <%= if @active_view == "research" do %>
          <% level = research_level_semantics(@research_launch_level) %>
          <.workbench_chassis
            id="instrument-workbench-research"
            surface="research"
            index="03"
            title="Research Radar"
            status={research_workbench_status(@selected_research_run, @research_results)}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-research"
          >
            <:primary_action>
              <.link
                id="research-open-settings"
                navigate={settings_path(@workspace_route, "providers")}
                class="sf-control min-h-11 inline-flex items-center justify-center gap-2 px-4 text-sm font-semibold"
              >
                <.icon name="hero-adjustments-horizontal" class="h-4 w-4" /> Provider settings
              </.link>
            </:primary_action>
            <:primary_field>
          <div id="deep-research-page" class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="mx-auto max-w-7xl space-y-5">
              <header class="flex flex-col gap-5 border-b border-[var(--sf-hairline)] pb-6 lg:flex-row lg:items-end lg:justify-between">
                <div class="max-w-3xl">
                  <div class="mb-2 flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-[var(--sf-text-secondary)]">
                    <span class="h-1.5 w-1.5 bg-[var(--sf-text-secondary)]" aria-hidden="true"></span> Evidence workspace
                  </div>
                  <h2 class="text-3xl font-semibold tracking-[-0.04em] text-[var(--sf-text-primary)] sm:text-4xl">
                    Deep research, without hidden work.
                  </h2>
                  <p class="sf-body-copy mt-3 max-w-[68ch]">
                    Define an exact bounded investigation, attach prior research, and keep the
                    requested execution contract visible before any work begins.
                  </p>
                </div>
              </header>

              <div class="grid gap-5 xl:grid-cols-[minmax(0,1.15fr)_minmax(22rem,0.85fr)]">
                <.form
                  for={@research_form}
                  id="deep-research-form"
                  phx-change="update_research_launch"
                  phx-submit="submit_deep_research"
                  class="min-w-0 border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-4 sm:p-5"
                >
                  <section id="research-stage-objective" class="research-stage">
                    <div class="research-stage-heading"><span class="sf-metadata">01</span><h3>Objective</h3></div>
                  <input
                    id="deep-research-request-id"
                    type="hidden"
                    name="research[request_id]"
                    value={@research_form[:request_id].value}
                  />
                  <div class="mb-5 flex items-center justify-between gap-4">
                    <div>
                      <h3 class="text-base font-semibold text-[var(--sf-text-primary)]">Research brief</h3>
                      <p class="sf-body-copy mt-1">
                        Queued as a durable finite DAG with exact level limits.
                      </p>
                    </div>
                    <span class="px-2 py-1 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                      async · durable
                    </span>
                  </div>

                  <.input
                    field={@research_form[:objective]}
                    id="deep-research-objective"
                    type="textarea"
                    rows="5"
                    label="What should I investigate?"
                    placeholder="Compare evidence, identify disagreements, and recommend a defensible implementation…"
                    required
                    class="block min-h-32 w-full resize-y rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2.5 text-sm leading-6 text-[var(--sf-text-primary)] outline-none transition-colors placeholder:text-[var(--sf-text-secondary)] focus:border-[var(--sf-text-secondary)] focus-visible:ring-2 focus-visible:ring-[var(--sf-focus-ring)]"
                  />

                  </section>
                  <section id="research-stage-depth" class="research-stage">
                    <div class="research-stage-heading"><span class="sf-metadata">02</span><h3>Depth</h3></div>
                  <fieldset id="deep-research-levels" class="mt-5">
                    <legend class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--sf-text-secondary)]">
                      Research level
                    </legend>
                    <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                      <label
                        :for={
                          {level_name, title} <- [
                            {"low", "Low"},
                            {"medium", "Medium"},
                            {"high", "High"},
                            {"ultra", "Ultra"}
                          ]
                        }
                        class={[
                          "cursor-pointer rounded-2xl border p-3 transition-colors focus-within:outline-none focus-within:ring-2 focus-within:ring-[var(--sf-focus-ring)]",
                          @research_launch_level == level_name &&
                            "border-[var(--sf-hairline)] bg-[var(--sf-raised-control)]",
                          @research_launch_level != level_name &&
                            "border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] hover:border-[var(--sf-text-secondary)]"
                        ]}
                        data-level={level_name}
                        data-selection-state={if(@research_launch_level == level_name, do: "selected", else: "available")}
                        data-subagents={research_level_semantics(level_name).subagents}
                        data-rounds={research_level_semantics(level_name).rounds}
                        data-query-fanout={research_level_semantics(level_name).subagents}
                      >
                        <input
                          id={"deep-research-level-#{level_name}"}
                          type="radio"
                          name="research[level]"
                          value={level_name}
                          checked={@research_launch_level == level_name}
                          class="sr-only"
                        />
                        <span class="flex items-center justify-between gap-2 text-sm font-semibold text-[var(--sf-text-primary)]"><span>{title}</span><span :if={@research_launch_level == level_name} data-selected-indicator class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-primary)]"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-[var(--sf-live-mark)]"></span>Selected</span></span>
                        <span class="sf-body-copy mt-1 block">
                          {research_level_contract(level_name)}
                        </span>
                      </label>
                    </div>
                  </fieldset>

                  <dl :if={level} id="research-level-facts" class="mt-4 grid gap-3 sm:grid-cols-2">
                    <div class="research-fact-row border-l border-[var(--sf-hairline)] py-1 pl-3">
                      <dt class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                        Requested rounds
                      </dt>
                      <dd class="sf-body-copy mt-1 text-[var(--sf-text-primary)]">
                        {level.rounds} sequential evidence rounds
                      </dd>
                    </div>
                    <div class="research-fact-row border-l border-[var(--sf-hairline)] py-1 pl-3">
                      <dt class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                        Per-search-step query fanout
                      </dt>
                      <dd class="sf-body-copy mt-1 text-[var(--sf-text-primary)]">
                        Up to {level.subagents} bounded asynchronous queries
                      </dd>
                    </div>
                  </dl>

                  </section>
                  <section id="research-stage-sources" class="research-stage">
                    <div class="research-stage-heading"><span class="sf-metadata">03</span><h3>Sources &amp; attachments</h3></div>
                  <div class="mt-5 grid gap-4 sm:grid-cols-[10rem_minmax(0,1fr)]">
                    <.input
                      field={@research_form[:max_sources]}
                      id="deep-research-max-sources"
                      type="number"
                      min="1"
                      max="40"
                      label="Maximum sources"
                      value={@research_launch_sources}
                      class="block min-h-11 w-full rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 text-sm text-[var(--sf-text-primary)] outline-none focus:border-[var(--sf-text-secondary)]"
                    />
                    <div>
                      <div class="flex items-center justify-between gap-3">
                        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--sf-text-secondary)]">
                          Ranked providers
                        </p>
                        <span class="font-mono text-xs text-[var(--sf-text-secondary)]">
                          {length(@research_launch_providers)} selected
                        </span>
                      </div>
                      <div class="mt-2 flex flex-wrap gap-2">
                        <label
                          :for={provider <- @settings.search_provider_order || ["duckduckgo"]}
                          class={[
                            "inline-flex min-h-11 items-center gap-2 rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] px-2.5 font-mono text-xs",
                            research_provider_selectable?(@settings, provider) &&
                              "cursor-pointer text-[var(--sf-text-secondary)]",
                            !research_provider_selectable?(@settings, provider) &&
                              "cursor-not-allowed text-[var(--sf-text-secondary)] opacity-60"
                          ]}
                          title={
                            if research_provider_selectable?(@settings, provider),
                              do: "Include #{provider}",
                              else: "Enable and configure #{provider} in Provider settings"
                          }
                        >
                          <input
                            type="hidden"
                            name={"research[providers][#{provider}]"}
                            value="false"
                          />
                          <input
                            id={"deep-research-provider-#{provider}"}
                            type="checkbox"
                            name={"research[providers][#{provider}]"}
                            value="true"
                            checked={provider in @research_launch_providers}
                            disabled={!research_provider_selectable?(@settings, provider)}
                            class="h-3.5 w-3.5 accent-[var(--sf-live-mark)]"
                          />
                          {String.replace(provider, "_", " ")}
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] p-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <p class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--sf-text-secondary)]">
                          Prior research
                        </p>
                        <p class="mt-1 text-sm leading-5 text-[var(--sf-text-secondary)]">
                          Attach up to 12 ready results from this session by public result number.
                        </p>
                      </div>
                      <button
                        id="deep-research-attachment-picker-toggle"
                        type="button"
                        phx-click="toggle_research_attachment_picker"
                        aria-expanded={@research_attachment_picker_open?}
                        aria-controls="deep-research-attachment-picker"
                        class="inline-flex min-h-11 items-center gap-2 rounded-2xl border border-[var(--sf-hairline)] px-3 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-primary)] hover:border-[var(--sf-text-secondary)]"
                      >
                        <.icon name="hero-paper-clip" class="research-attachment-icon h-3.5 w-3.5 text-[var(--sf-text-secondary)]" />
                        Attach ready results
                      </button>
                    </div>
                    <div
                      :if={MapSet.size(@research_attachments) > 0}
                      class="mt-3 flex flex-wrap gap-1.5"
                    >
                      <span
                        :for={
                          public_id <- @research_attachments |> MapSet.to_list() |> Enum.sort()
                        }
                        data-research-attachment-id={public_id}
                        class="max-w-full truncate border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] px-2 py-1 font-mono text-xs text-[var(--sf-text-primary)]"
                        title={"Ready research result ##{public_id}"}
                      >
                        /deep_research {public_id}
                      </span>
                      <button
                        type="button"
                        phx-click="clear_research_attachments"
                        class="px-2 py-1 font-mono text-xs text-[var(--sf-text-secondary)] hover:text-[var(--sf-text-primary)]"
                      >
                        Clear
                      </button>
                    </div>
                    <div
                      :if={@research_attachment_picker_open?}
                      id="deep-research-attachment-picker"
                      class="mt-3 max-h-52 overflow-y-auto border-t border-[var(--sf-hairline)] pt-2"
                    >
                      <p
                        :if={@research_results == []}
                        class="sf-body-copy py-5 text-center text-[var(--sf-text-secondary)]"
                      >
                        No ready research results in this session.
                      </p>
                      <button
                        :for={result <- Enum.take(@research_results, 200)}
                        id={"deep-research-attachment-#{research_result_public_id(result)}"}
                        type="button"
                        phx-click="toggle_research_attachment"
                        phx-value-id={research_result_public_id(result)}
                        aria-pressed={
                          MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          )
                        }
                        class={[
                          "flex min-h-11 w-full items-center gap-2 rounded-2xl px-2 text-left font-mono text-xs transition-colors",
                          MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          ) &&
                            "bg-[var(--sf-instrument-raised)] text-[var(--sf-text-primary)]",
                          !MapSet.member?(
                            @research_attachments,
                            research_result_public_id(result)
                          ) &&
                            "text-[var(--sf-text-secondary)] hover:bg-[var(--sf-instrument-raised)] hover:text-[var(--sf-text-primary)]"
                        ]}
                      >
                        <.icon name="hero-document-text" class="h-3.5 w-3.5 shrink-0" />
                        <span class="shrink-0 text-[var(--sf-text-primary)]">
                          #{research_result_public_id(result)}
                        </span>
                        <span class="truncate">{research_result_label(result)}</span>
                        <span :if={MapSet.member?(@research_attachments, research_result_public_id(result))} data-selected-indicator class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-primary)]">Selected</span>
                        <span class="ml-auto shrink-0 text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                          {Map.get(result, :level)} · {Map.get(result, :source_count, 0)} sources
                        </span>
                      </button>
                    </div>
                  </div>

                  </section>
                  <section id="research-stage-contract" class="research-stage">
                    <div class="research-stage-heading"><span class="sf-metadata">04</span><h3>Run contract</h3></div>
                    <div id="research-run-contract" class="research-run-contract" data-contract-state={if(level, do: "valid", else: "invalid")}>
                      <%= if level do %>
                        <span data-rounds={level.rounds} data-query-fanout={level.subagents}>{level.rounds} rounds · {level.subagents} query fanout · max {@research_launch_sources} sources</span>
                      <% else %>
                        <span id="research-invalid-level" data-invalid-level={@research_launch_level}>Choose a valid research level before queuing.</span>
                      <% end %>
                    </div>
                  <button
                    id="deep-research-submit"
                    type="submit"
                    phx-disable-with="Checking availability…"
                    class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-raised-control)] px-5 font-mono text-sm font-semibold uppercase tracking-wider text-[var(--sf-text-primary)] transition-colors hover:border-[var(--sf-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sf-focus-ring)]"
                  >
                    <.icon name="hero-arrow-up-right" class="h-4 w-4" /> Queue deep research
                  </button>
                  </section>
                </.form>


                <section id="research-progress-dag" :if={@selected_research_run && @research_dag_projection} class="research-progress" aria-label="Research progress">
                  <DagComponents.dag_projection projection={@research_dag_projection} />
                </section>
                <section id="research-progress-fallback" :if={is_nil(@research_dag_projection)} data-run-status={if(@selected_research_run, do: @selected_research_run.status, else: "none")} data-projection-state={if(@research_projection_state == :bounded_out, do: "bounded-out", else: @research_projection_state)} class="research-progress-fallback" aria-label="Research progress">
                  <%= if @selected_research_run do %>
                    <p class="sf-metadata">Status · {@selected_research_run.status}</p>
                    <p class="mt-1 text-sm">Progress · {min(max(@selected_research_run.progress || 0, 0), 100)}%</p>
                    <ul :if={@selected_research_steps != []} class="mt-3 space-y-1 text-xs">
                      <li :for={step <- Enum.take(@selected_research_steps, 32)}>{step.key} · {step.status}</li>
                    </ul>
                  <% else %>
                    <p class="text-sm">No research run selected</p>
                  <% end %>
                </section>
                <aside class="min-w-0 space-y-4">
                  <section
                    id="deep-research-semantics"
                    class="border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-semibold text-[var(--sf-text-primary)]">Exact execution semantics</h3>
                      <span class="px-2 py-1 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                        Launch contract
                      </span>
                    </div>
                    <p class="mt-3 text-sm leading-5 text-[var(--sf-text-secondary)]">
                      Each named level creates an immutable finite research graph. Every step
                      records one logical lead; ranked and grounded search steps supervise bounded
                      asynchronous query tasks. Durable provider intents prevent ambiguous
                      paid-call replay.
                    </p>
                    <dl :if={level} id="research-semantics-facts" class="mt-4 grid gap-3 sm:grid-cols-2">
                      <div class="research-fact-row border-l border-[var(--sf-hairline)] py-1 pl-3">
                        <dt class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                          Rounds
                        </dt>
                        <dd class="mt-1 text-lg font-semibold text-[var(--sf-text-primary)]">{level.rounds}</dd>
                      </div>
                      <div class="research-fact-row border-l border-[var(--sf-hairline)] py-1 pl-3">
                        <dt class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                          Search-step query fanout
                        </dt>
                        <dd class="mt-1 text-lg font-semibold text-[var(--sf-text-primary)]">
                          {level.subagents}
                        </dd>
                      </div>
                    </dl>
                    <div class="sf-body-copy mt-4 border-t border-[var(--sf-hairline)] pt-3 text-[var(--sf-text-secondary)]">
                      The composer, <code class="text-[var(--sf-text-primary)]">/research</code>, and this page
                      all queue the exact finite DAG. Existing persisted legacy runs keep their
                      fixed-stage execution history without being reinterpreted.
                    </div>
                    <div class="sf-body-copy mt-4 border-t border-[var(--sf-hairline)] pt-3 text-[var(--sf-text-primary)]">
                      Stage cards are observational. Pause, resume, cancel, and retry remain run-scoped
                      and generation-fenced in Mission Control. Immutable DAG runs cannot be steered.
                    </div>
                  </section>

                  <section
                    id="deep-research-run-list"
                    class="border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <h3 class="text-sm font-semibold text-[var(--sf-text-primary)]">Recent investigations</h3>
                      <span class="font-mono text-xs text-[var(--sf-text-secondary)]">{length(@research_runs)}</span>
                    </div>
                    <div :if={@research_runs == []} class="research-empty-state sf-body-copy py-8 text-center text-[var(--sf-text-secondary)]">
                      No research runs in this session.
                    </div>
                    <button
                      :for={run <- Enum.take(@research_runs, 8)}
                      id={"deep-research-run-#{run.id}"}
                      type="button"
                      phx-click="open_research_run"
                      phx-value-id={run.id}
                      aria-pressed={to_string(@selected_research_run && @selected_research_run.id == run.id)}
                      data-selection-state={if(@selected_research_run && @selected_research_run.id == run.id, do: "selected", else: "available")}
                      class={[
                        "mt-2 w-full rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-3 text-left transition-colors hover:border-[var(--sf-text-secondary)]",
                        @selected_research_run && @selected_research_run.id == run.id && "bg-[var(--sf-raised-control)]"
                      ]}
                    >
                      <div class="flex items-center justify-between gap-3">
                        <span class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]"><span :if={@selected_research_run && @selected_research_run.id == run.id} data-selected-indicator class="inline-flex items-center gap-1.5 text-[var(--sf-text-primary)]"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-[var(--sf-live-mark)]"></span>Selected</span>{run.status}</span>
                        <span class="font-mono text-xs tabular-nums text-[var(--sf-text-secondary)]">{run.progress ||
                          0}%</span>
                      </div>
                      <p class="sf-body-copy mt-2 text-[var(--sf-text-secondary)]">Persisted research run</p>
                    </button>
                  </section>

                  <section
                    id="deep-research-ready-results"
                    class="border border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-4 sm:p-5"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <div>
                        <h3 class="text-sm font-semibold text-[var(--sf-text-primary)]">Ready reports</h3>
                        <p class="sf-body-copy mt-1 text-[var(--sf-text-secondary)]">
                          Recorded Markdown and self-contained HTML artifacts.
                        </p>
                      </div>
                      <span class="font-mono text-xs text-[var(--sf-text-secondary)]">
                        {length(@research_results)}
                      </span>
                    </div>

                    <div
                      :if={@research_results == []}
                      class="research-empty-state sf-body-copy py-8 text-center text-[var(--sf-text-secondary)]"
                    >
                      Completed reports will appear here with an integer result number.
                    </div>

                    <article
                      :for={result <- Enum.take(@research_results, 12)}
                      id={"research-evidence-#{research_result_public_id(result)}"}
                      data-evidence-level={Map.get(result, :level)}
                      data-evidence-source-count={Map.get(result, :source_count, 0)}
                      data-artifacts-recorded={to_string(is_binary(Map.get(result, :result_path)) and is_binary(Map.get(result, :html_path)))}
                      data-digests-recorded={to_string(is_binary(Map.get(result, :markdown_sha256)) and is_binary(Map.get(result, :html_sha256)))}
                      class="research-evidence mt-3 border-t border-[var(--sf-hairline)] bg-[var(--sf-instrument)] p-3"
                    >
                      <div id={"deep-research-result-#{research_result_public_id(result)}"} class="contents">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)]">
                            Result #{research_result_public_id(result)} · {Map.get(result, :level)}
                          </p>
                          <p class="sf-body-copy mt-1 text-[var(--sf-text-primary)]">
                            Persisted ready report · artifacts and digests recorded
                          </p>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-[var(--sf-text-secondary)]">
                          {Map.get(result, :source_count, 0)} src
                        </span>
                      </div>
                      <div class="mt-3 grid grid-cols-3 gap-1.5">
                        <.link
                          id={"deep-research-result-open-#{research_result_public_id(result)}"}
                          href={~p"/research/#{research_result_public_id(result)}/report"}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={"Open report for research result #{research_result_public_id(result)}"}
                          class="inline-flex min-h-11 items-center justify-center gap-1 rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-raised-control)] px-2 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-primary)] hover:border-[var(--sf-text-secondary)]"
                        >
                          <.icon name="hero-arrow-top-right-on-square" class="h-3 w-3" /> Open
                        </.link>
                        <.link
                          id={"deep-research-result-html-#{research_result_public_id(result)}"}
                          href={
                            ~p"/research/#{research_result_public_id(result)}/report/download"
                          }
                          aria-label={"Download HTML report for research result #{research_result_public_id(result)}"}
                          class="inline-flex min-h-11 items-center justify-center gap-1 rounded-2xl border border-[var(--sf-hairline)] px-2 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)] hover:text-[var(--sf-text-primary)]"
                        >
                          <.icon name="hero-arrow-down-tray" class="h-3 w-3" /> HTML
                        </.link>
                        <.link
                          id={"deep-research-result-md-#{research_result_public_id(result)}"}
                          href={
                            ~p"/research/#{research_result_public_id(result)}/result/download"
                          }
                          aria-label={"Download Markdown report for research result #{research_result_public_id(result)}"}
                          class="inline-flex min-h-11 items-center justify-center gap-1 rounded-2xl border border-[var(--sf-hairline)] px-2 font-mono text-xs uppercase tracking-wider text-[var(--sf-text-secondary)] hover:text-[var(--sf-text-primary)]"
                        >
                          <.icon name="hero-document-arrow-down" class="h-3 w-3" /> MD
                        </.link>
                      </div>
                      </div>
                    </article>
                  </section>
                </aside>
              </div>
            </div>
          </div>
            </:primary_field>
            <:signal_panel>
              <section id="research-signal-panel" aria-label="Research readiness">
                <p class="sf-metadata">Research signal</p>
                <p class="mt-2 text-sm">{length(@research_runs)} recent investigations · {length(@research_results)} ready reports</p>
                <p class="sf-body-copy mt-2">Launch contract and recorded evidence remain server-owned facts.</p>
              </section>
            </:signal_panel>
            <:command_dock>
              <.shared_command_dock workspace_assigns={assigns} />
            </:command_dock>
          </.workbench_chassis>
        <% end %>

        <%!-- Conversation Loop workbench --%>
        <%= if @active_tab == "chat" do %>
          <.workbench_chassis
            id="instrument-workbench-chat"
            surface="chat"
            index="06"
            title="Conversation Loop"
            status={if @instrument_summaries["chat"].primary, do: @instrument_summaries["chat"].primary, else: "No messages yet"}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-chat"
          >
            <:primary_field>
              <div id="conversation-loop-field" class="conversation-loop-field flex min-h-0 flex-1">
                <aside id="chat-minimap" aria-label="Conversation timeline" class="chat-minimap">
                  <div id="chat-timeline-track" class="scroll-timeline-track">
                    <%= for {msg, idx} <- Enum.with_index(retained_chat_messages(@messages)) do %>
                      <% msg_id = msg.id
                      is_user = msg.role == "user"
                      preview_title =
                        if is_user,
                          do: msg.content |> String.split("\n") |> List.first() |> String.slice(0, 40),
                          else: msg.agent_name || "Assistant Response"
                      preview_snippet = msg.content |> String.slice(0, 140) %>
                      <button
                        type="button"
                        id={"scroll-node-#{msg_id}"}
                        class={["scroll-timeline-node", idx == 0 && "is-active"]}
                        data-target-msg-id={msg_id}
                        phx-click="scroll_to_msg"
                        phx-value-id={msg_id}
                        aria-label={"Jump to message ##{idx + 1}"}
                        title={"Jump to message ##{idx + 1}"}
                      >
                        <span class={["scroll-notch", is_user && "scroll-notch-landmark"]}></span>
                        <span class="scroll-preview-card">
                          <span class="flex items-center justify-between mb-1.5 pb-1 border-b border-[var(--sf-hairline)]">
                            <span class="sf-code-surface border-0 bg-transparent p-0 text-[10px] font-semibold uppercase tracking-wider">
                              {if is_user, do: "User Prompt", else: msg.agent_name || "Assistant"}
                            </span>
                            <span class="sf-code-surface border-0 bg-transparent p-0 text-[10px]">#{idx + 1}</span>
                          </span>
                          <span class="block sf-chat-prose truncate">{preview_title}</span>
                          <span class="block sf-chat-prose line-clamp-3">{preview_snippet}</span>
                        </span>
                      </button>
                    <% end %>
                  </div>
                </aside>

                <button
                  id="chat-jump-to-message"
                  type="button"
                  phx-click="open_chat_jump_sheet"
                  aria-haspopup="dialog"
                  aria-controls="chat-jump-sheet"
                  aria-expanded={if(@chat_jump_sheet_open?, do: "true", else: "false")}
                  disabled={!chat_has_retained_message?(@messages)}
                  class="sf-control chat-jump-trigger min-h-11 w-full justify-center gap-2"
                >
                  <.icon name="hero-list-bullet" class="h-4 w-4" />
                  Jump to message
                </button>

                <div
                  id="chat-viewport"
                  phx-hook=".ChatScrollAssistant"
                  class="chat-viewport flex min-h-0 flex-1 flex-col overflow-y-auto scroll-smooth"
                >
                  <button
                    :if={@messages_more?}
                    id="load-older-messages"
                    type="button"
                    phx-click="load_older_messages"
                    class="sf-control mx-auto min-h-11 gap-1.5"
                  >
                    <.icon name="hero-arrow-up" class="h-3.5 w-3.5" /> Load older messages
                  </button>
                  <div
                    :if={!chat_has_retained_message?(@messages)}
                    id="chat-empty-state"
                    class="sf-chat-prose m-auto flex max-w-md flex-col items-center px-6 py-12 text-center"
                  >
                    <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] text-[var(--sf-text-secondary)]">
                      <.icon name="hero-chat-bubble-left-right" class="h-5 w-5" />
                    </span>
                    <h3 class="mt-4 text-base font-semibold text-[var(--sf-text-primary)]">Start with a clean conversation</h3>
                    <p class="mt-2 leading-6 text-[var(--sf-text-secondary)]">No fabricated history is added to a new session. Send a prompt below when you are ready to begin.</p>
                  </div>

                  <%= for {msg, idx} <- Enum.with_index(retained_chat_messages(@messages)) do %>
                    <% msg_id = msg.id
                    is_user = msg.role == "user" %>
                    <article
                      id={"chat-msg-#{msg_id}"}
                      data-chat-msg-id={msg_id}
                      class={["sf-chat-message sf-chat-prose", is_user && "chat-message-user", !is_user && "chat-message-assistant"]}
                    >
                      <header class="sf-chat-message-header">
                        <span class="sf-chat-event-mark" aria-hidden="true"></span>
                        <span>{msg.agent_name || msg.role}</span>
                        <span class="sf-code-surface border-0 bg-transparent p-0">#{idx + 1}</span>
                      </header>
                      <%= if !is_user and msg.metadata && msg.metadata["reasoning"] do %>
                        <.thinking_trace
                          reasoning={msg.metadata["reasoning"]}
                          duration_ms={msg.metadata["duration_ms"]}
                        />
                      <% end %>
                      <div class="sf-chat-prose">
                        <.markdown_content content={msg.content} namespace={"chat-message-#{msg_id}"} />
                      </div>
                      <footer class="sf-chat-message-actions">
                        <button
                          id={"copy-msg-btn-#{msg_id}"}
                          type="button"
                          phx-hook="CodeCopy"
                          phx-update="ignore"
                          data-code={msg.content}
                          aria-label={"Copy message ##{idx + 1}"}
                          class="sf-control min-h-11 min-w-11 justify-center p-2"
                          title="Copy to clipboard"
                        ><.icon name="hero-clipboard" class="h-3.5 w-3.5" /></button>
                        <button
                          type="button"
                          phx-click="expand_message"
                          phx-value-id={msg_id}
                          aria-label={"Expand message ##{idx + 1}"}
                          class="sf-control min-h-11 min-w-11 justify-center p-2"
                          title="Expand message"
                        ><.icon name="hero-arrows-pointing-out" class="h-3.5 w-3.5" /></button>
                      </footer>
                    </article>
                  <% end %>
                  <button
                    :if={@messages_newer?}
                    id="load-newer-messages"
                    type="button"
                    phx-click="load_newer_messages"
                    class="sf-control mx-auto min-h-11 gap-1.5"
                  >
                    Newer messages available <.icon name="hero-arrow-down" class="h-3.5 w-3.5" />
                  </button>
                </div>

                <%= if @chat_jump_sheet_open? and chat_has_retained_message?(@messages) do %>
                  <div
                    id="chat-jump-sheet"
                    phx-hook="ResponsiveSheet"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="chat-jump-sheet-title"
                    tabindex="-1"
                    data-sheet-dialog="true"
                    data-sheet-close-event="close_chat_jump_sheet"
                    data-sheet-return-id="chat-jump-to-message"
                    data-sheet-background-id="chat-viewport"
                    class="sf-chat-jump-sheet sf-chassis fixed inset-x-0 bottom-0 z-50 max-h-[min(85dvh,42rem)] rounded-b-none"
                  >
                    <div class="flex items-center justify-between border-b border-[var(--sf-hairline)] p-4">
                      <h2 id="chat-jump-sheet-title" class="text-base font-semibold">Jump to message</h2>
                      <button
                        id="chat-jump-sheet-close"
                        type="button"
                        phx-click="close_chat_jump_sheet"
                        class="sf-control min-h-11 min-w-11 justify-center"
                        aria-label="Close jump to message"
                      ><.icon name="hero-x-mark" class="h-4 w-4" /></button>
                    </div>
                    <div class="sf-sheet-scroll p-4">
                      <%= for {msg, idx} <- Enum.with_index(retained_chat_messages(@messages)) do %>
                        <% msg_id = msg.id %>
                        <button
                          id={"chat-jump-message-#{msg_id}"}
                          type="button"
                          phx-click="jump_to_message"
                          phx-value-id={msg_id}
                          class="sf-control mb-2 min-h-11 w-full justify-start gap-3 text-left"
                        >
                          <span class="sf-code-surface border-0 bg-transparent p-0 text-xs">#{idx + 1}</span>
                          <span class="sf-chat-prose truncate">{String.slice(msg.content || "", 0, 96)}</span>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </:primary_field>
            <:command_dock><.shared_command_dock workspace_assigns={assigns} /></:command_dock>
          </.workbench_chassis>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".ChatScrollAssistant">
            export default {
              mounted() {
                const container = this.el;
                this.updateActiveNotch = () => {
                  const messages = container.querySelectorAll('[data-chat-msg-id]');
                  let activeId = null;
                  const top = container.getBoundingClientRect().top + 200;
                  messages.forEach(msg => {
                    const rect = msg.getBoundingClientRect();
                    if (rect.top <= top && rect.bottom >= container.getBoundingClientRect().top) activeId = msg.dataset.chatMsgId;
                  });
                  if (activeId) document.querySelectorAll('.scroll-timeline-node').forEach(node => node.classList.toggle('is-active', node.dataset.targetMsgId === activeId));
                };
                container.addEventListener('scroll', this.updateActiveNotch, { passive: true });
                this.updateActiveNotch();
                this.handleScrollToMsg = ({ id }) => {
                  const target = document.getElementById('chat-msg-' + id);
                  if (target) target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
                };
                this.handleEvent('scroll_to_msg', this.handleScrollToMsg);
              },
              destroyed() {
                this.el?.removeEventListener('scroll', this.updateActiveNotch);
              }
            }
          </script>
        <% end %>

        <%!-- Instrument 07: File Atlas --%>
        <%= if @active_view == "files" do %>
          <% file_summary = @instrument_summaries["files"] %>
          <.workbench_chassis
            id="instrument-workbench-files"
            surface="files"
            index="07"
            title="File Atlas"
            status={file_summary.primary}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-files"
          >
            <:primary_action>
              <button
                id="files-focus-mode-toggle"
                type="button"
                phx-click="toggle_files_focus_mode"
                aria-controls="file-atlas-primary-field"
                aria-pressed={to_string(@files_focus_mode?)}
                class="sf-control min-h-11 px-4 text-sm font-semibold"
              >
                <.icon name={if(@files_focus_mode?, do: "hero-arrows-pointing-in", else: "hero-arrows-pointing-out")} class="size-4" />
                {if(@files_focus_mode?, do: "Exit focus", else: "Focus editor")}
              </button>
            </:primary_action>
            <:primary_field>
              <div
                id="file-atlas-primary-field"
                data-files-focus-mode={to_string(@files_focus_mode?)}
                class="sf-file-atlas-field flex min-h-0 flex-1"
              >
                <.file_explorer
                  files={@project_files}
                  more_files={@files_can_load_more?}
                  files_omitted={@files_more?}
                  inventory_loaded={@files_loaded?}
                  inventory_status={file_summary.primary}
                  filter={@file_filter}
                  filter_form={@file_filter_form}
                  expanded_folders={@expanded_folders}
                  selected_file={@selected_file}
                  file_content={@file_content}
                  dirty_content={@dirty_content}
                  is_dirty={@is_dirty?}
                  open_buffers={@open_buffers}
                  editor_lock={editor_lock(assigns)}
                  auto_save={@settings.auto_save == true}
                />
              </div>
            </:primary_field>
            <:signal_panel>
              <div id="file-atlas-signal-panel" class="sf-file-atlas-signals">
                <p class="sf-metadata">Current buffer signal</p>
                <dl class="sf-file-atlas-signal-list">
                  <%= for fact <- file_summary.secondary do %>
                    <div id={"files-#{String.downcase(fact.label)}-signal"} class="sf-file-atlas-signal">
                      <dt>{fact.label}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  <% end %>
                </dl>
              </div>
            </:signal_panel>
            <:command_dock><.shared_command_dock workspace_assigns={assigns} /></:command_dock>
          </.workbench_chassis>
        <% end %>

          <%!-- Instrument 08: Terminal Scope --%>
        <%= if @active_view != "deck" do %>
            <% terminal_summary = @instrument_summaries["terminal"] %>
            <.workbench_chassis
              id="instrument-workbench-terminal"
              surface="terminal"
              index="08"
              title="Terminal Scope"
              status={terminal_summary.primary}
            return_to={workspace_path(@workspace_route, "deck")}
            return_instrument_id="instrument-card-terminal"
            hidden={@active_view != "terminal"}
            >
              <:primary_action>
                <button
                  id="btn-terminal-replay"
                  type="button"
                  phx-click="replay_terminal_command"
                disabled={
                  @terminal_history == [] or not @terminal_available? or
                    not @terminal_running? or terminal_input_locked?(assigns)
                }
                  class="sf-control min-h-11 px-4 text-sm font-semibold"
                >
                  <.icon name="hero-arrow-uturn-left" class="size-4" /> Replay last command
                </button>
              </:primary_action>
              <:primary_field>
                <.terminal_session
                  session={@session}
                  running={@terminal_running?}
                  status={@terminal_status}
                  shell={@terminal_shell}
                  cols={@terminal_cols}
                  rows={@terminal_rows}
                  occupant={@terminal_occupant}
                  active_cmd={@terminal_active_cmd}
                output={@terminal_output}
                form={@terminal_form}
                workspace_locks={@workspace_locks}
                can_clear?={@terminal_history != [] or @terminal_output != ""}
                can_interrupt?={is_binary(@terminal_active_cmd) and @terminal_active_cmd != ""}
                active?={@active_view == "terminal"}
              />
              </:primary_field>
              <:signal_panel>
                <div id="terminal-signal-panel" class="sf-terminal-signal-panel">
                  <p class="sf-metadata">Session signal</p>
                  <p class="sf-terminal-signal-primary">{terminal_summary.primary}</p>
                  <p :if={terminal_summary.detail} class="sf-terminal-signal-detail">
                    {terminal_summary.detail}
                  </p>
                  <dl class="sf-terminal-facts">
                    <%= for fact <- terminal_summary.secondary do %>
                      <div class="sf-terminal-fact">
                        <dt>{fact.label}</dt>
                        <dd>{fact.value}</dd>
                      </div>
                    <% end %>
                  </dl>
                  <div :if={@terminal_history != []} class="sf-terminal-trace">
                    <p class="sf-metadata">Recent command trace</p>
                    <ol class="sf-terminal-trace-list">
                      <%= for {command, index} <- @terminal_history |> Enum.take(8) |> Enum.with_index() do %>
                        <li id={"terminal-command-trace-#{index}"} class="sf-terminal-trace-row">
                          <span aria-hidden="true">{String.pad_leading(
                            Integer.to_string(index + 1),
                            2,
                            "0"
                          )}</span>
                          <code>{command}</code>
                        </li>
                      <% end %>
                    </ol>
                  </div>
                </div>
              </:signal_panel>
            <:command_dock :if={@active_view == "terminal"}><.shared_command_dock workspace_assigns={assigns} /></:command_dock>
            </.workbench_chassis>
          <% end %>

        <%!-- RIGHT TASK DETAIL DRAWER / INSPECTOR --%>
        <%= if @show_task_drawer and @selected_task do %>
          <aside
            id="task-detail-drawer"
            phx-hook="ResponsiveSheet"
            aria-label="Task details"
            aria-labelledby="task-detail-title"
            tabindex="-1"
            data-sheet-dialog="true"
            data-sheet-close-event="close_task_drawer"
            data-sheet-return-id={"task-card-#{@selected_task.id}"}
            data-sheet-background-id="kanban-board"
            class={["sf-task-detail-drawer absolute inset-y-0 right-0 z-40 flex h-full w-full max-w-none flex-col overflow-y-auto border-l border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] shadow-[0_24px_72px_-38px_var(--sf-shadow)] transition-smooth animate-in slide-in-from-right"]}
          >
            <%!-- Drawer Header --%>
            <div class={["sf-task-detail-header flex items-center justify-between border-b border-[var(--sf-hairline)] p-4"]}>
              <div class="flex items-center gap-2">
                <span class={[
                  "sf-pill flex items-center gap-1.5 px-2 py-0.5 font-mono text-xs font-bold uppercase",
                  @selected_task.status == "running" &&
                    "border-[var(--sf-success-mark)] text-[var(--sf-success-text)]",
                  @selected_task.status != "running" &&
                    "text-[var(--sf-text-secondary)]"
                ]}>
                  <span class={[
                    "h-1.5 w-1.5 rounded-full",
                    @selected_task.status == "running" && "bg-[var(--sf-success-mark)]",
                    @selected_task.status != "running" && "bg-[var(--sf-text-secondary)]"
                  ]}></span>
                  {@selected_task.status}
                </span>
                <h2 id="task-detail-title" tabindex="-1" class={["text-sm font-semibold text-[var(--sf-text-primary)]"]}>
                  Task details
                </h2>
                <span class={["font-mono text-sm text-[var(--sf-text-secondary)]"]}>#{String.slice(
                  @selected_task.id,
                  0..5
                )}</span>
              </div>
              <button
                id="close-task-detail-drawer"
                type="button"
                phx-click="close_task_drawer"
                aria-label="Close task drawer"
                class={["sf-control inline-flex min-h-11 min-w-11 items-center justify-center p-2"]}
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>

            <!-- Drawer Body -->
            <div class="p-5 space-y-5 flex-1 font-mono text-sm">
              <!-- Inline Task Editing Form -->
              <form
                phx-submit="update_task"
                id={"drawer-edit-task-#{@selected_task.id}"}
                class="space-y-3"
              >
                <input type="hidden" name="task_id" value={@selected_task.id} />
                <div>
                  <label class="block text-xs text-gray-400 uppercase tracking-wider mb-1 font-mono">Title</label>
                  <input
                    type="text"
                    name="title"
                    value={@selected_task.title}
                    required
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-white font-sans text-sm font-bold focus:border-cyan-500 focus:outline-none"
                  />
                </div>

                <div>
                  <label class="block text-xs text-gray-400 uppercase tracking-wider mb-1 font-mono">Description</label>
                  <textarea
                    name="description"
                    rows="3"
                    placeholder="Task details and requirements..."
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl p-2.5 text-sm text-gray-300 font-mono focus:border-cyan-500 focus:outline-none"
                  >{@selected_task.description}</textarea>
                </div>

                <div>
                  <label class="block text-xs text-gray-400 uppercase tracking-wider mb-1 font-mono">Tags (comma-separated)</label>
                  <input
                    type="text"
                    name="tags"
                    value={Enum.join(@selected_task.tags || [], ", ")}
                    placeholder="e.g. backend, urgent, liveview"
                    class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-sm text-gray-300 font-mono focus:border-cyan-500 focus:outline-none"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full py-1.5 bg-[#161b22] hover:bg-[#21262d] text-cyan-300 border border-cyan-500/30 rounded-xl text-sm font-mono font-medium transition-smooth flex items-center justify-center gap-1.5"
                >
                  <.icon name="hero-check" class="w-3.5 h-3.5" />
                  <span>Save Task Details</span>
                </button>
              </form>

              <!-- Subtasks Checklist Section -->
              <div class="pt-3 border-t border-[#21262d] space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono text-gray-400 uppercase tracking-wider">
                    Subtasks ({@selected_task.steps_completed}/{@selected_task.steps_total})
                  </span>
                  <% subtask_pct =
                    if @selected_task.steps_total > 0 do
                      min(
                        100,
                        round(@selected_task.steps_completed / @selected_task.steps_total * 100)
                      )
                    else
                      0
                    end %>
                  <span class="text-xs font-mono font-bold text-emerald-400">{subtask_pct}%</span>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-[#0d1117] border border-[#21262d] rounded-full h-2 overflow-hidden">
                  <div
                    class="bg-emerald-500 h-full rounded-full transition-all duration-300 shadow-[0_0_8px_rgba(16,185,129,0.5)]"
                    style={"width: #{subtask_pct}%"}
                  >
                  </div>
                </div>

                <!-- Subtasks Items List -->
                <div class="space-y-1.5 max-h-48 overflow-y-auto">
                  <%= for subtask <- (@selected_task.subtasks || []) do %>
                    <% is_done = subtask["completed"] == true or subtask[:completed] == true
                    sid = subtask["id"] || subtask[:id] %>
                    <div class="flex items-center justify-between gap-2 p-2 bg-[#161b22] border border-[#21262d] rounded-xl group hover:border-[#30363d] transition-smooth">
                      <button
                        type="button"
                        phx-click="toggle_subtask"
                        phx-value-id={sid}
                        class="flex items-center gap-2 flex-1 text-left min-w-0"
                      >
                        <span class={[
                          "w-4 h-4 rounded flex items-center justify-center border transition-smooth shrink-0",
                          is_done && "bg-emerald-500 border-emerald-500 text-white",
                          !is_done && "border-gray-500 bg-[#0d1117] hover:border-gray-400"
                        ]}>
                          <%= if is_done do %>
                            <.icon name="hero-check" class="w-3 h-3 stroke-[3]" />
                          <% end %>
                        </span>
                        <span class={[
                          "text-sm font-mono truncate",
                          is_done && "line-through text-gray-500",
                          !is_done && "text-gray-200 font-medium"
                        ]}>
                          {subtask["title"] || subtask[:title]}
                        </span>
                      </button>
                      <button
                        id={"delete-subtask-trigger-#{sid}"}
                        type="button"
                        phx-click="request_delete_subtask"
                        phx-value-id={sid}
                        phx-value-task-id={@selected_task.id}
                        aria-label={"Delete subtask " <> (subtask["title"] || subtask[:title])}
                        class="text-gray-500 hover:text-rose-400 p-1 rounded transition-smooth opacity-0 group-hover:opacity-100 focus:opacity-100"
                        title="Delete subtask"
                      >
                        <.icon name="hero-trash" class="w-3.5 h-3.5" />
                      </button>
                    </div>
                  <% end %>
                </div>

                <!-- Add Subtask Input Form -->
                <form phx-submit="add_subtask" class="flex gap-2 pt-1">
                  <input type="hidden" name="task_id" value={@selected_task.id} />
                  <input
                    type="text"
                    name="title"
                    placeholder="Add a subtask..."
                    required
                    class="flex-1 bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-sm text-white font-mono placeholder-gray-500 focus:border-cyan-500 focus:outline-none"
                  />
                  <button
                    type="submit"
                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-sm font-mono font-medium transition-smooth shrink-0 flex items-center gap-1"
                  >
                    <.icon name="hero-plus" class="w-3.5 h-3.5" />
                    <span>Add</span>
                  </button>
                </form>
              </div>

              <!-- Metadata Grid -->
              <div class="space-y-2.5 pt-3 border-t border-[#21262d]">
                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Assignee</span>
                  <div class="flex items-center gap-1">
                    <%= for a <- ["default", "planner", "coder", "verifier"] do %>
                      <button
                        type="button"
                        phx-click="update_task_assignee"
                        phx-value-id={@selected_task.id}
                        phx-value-assignee={a}
                        class={[
                          "px-2 py-0.5 rounded text-xs font-mono transition-smooth capitalize",
                          @selected_task.assignee == a && "bg-purple-600 text-white font-bold",
                          @selected_task.assignee != a &&
                            "bg-[#161b22] text-gray-400 hover:text-white"
                        ]}
                      >
                        {a}
                      </button>
                    <% end %>
                  </div>
                </div>

                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Priority</span>
                  <div class="flex items-center gap-1">
                    <%= for p <- ["critical", "high", "medium", "low"] do %>
                      <button
                        type="button"
                        phx-click="update_task_priority"
                        phx-value-id={@selected_task.id}
                        phx-value-priority={p}
                        class={[
                          "px-2 py-0.5 rounded text-xs font-mono transition-smooth uppercase",
                          @selected_task.priority == p && p == "critical" &&
                            "bg-red-600 text-white font-bold",
                          @selected_task.priority == p && p == "high" &&
                            "bg-orange-600 text-white font-bold",
                          @selected_task.priority == p && p == "medium" &&
                            "bg-blue-600 text-white font-bold",
                          @selected_task.priority == p && p == "low" &&
                            "bg-gray-600 text-white font-bold",
                          @selected_task.priority != p &&
                            "bg-[#161b22] text-gray-400 hover:text-white"
                        ]}
                      >
                        {p}
                      </button>
                    <% end %>
                  </div>
                </div>

                <div class="flex justify-between items-center">
                  <span class="text-gray-400">Worker PID</span>
                  <span class="text-emerald-400">{@selected_task.worker_pid || "Unassigned"}</span>
                </div>
              </div>

              <!-- Status Transition Dropdown Across 8 Columns -->
              <div class="pt-3 border-t border-[#21262d] space-y-1.5">
                <div class="text-xs text-gray-400 uppercase tracking-wider">
                  Move Status
                </div>
                <div class="grid grid-cols-4 gap-1">
                  <%= for s <- Kanban.Task.statuses() do %>
                    <button
                      type="button"
                      phx-click="move_task"
                      phx-value-id={@selected_task.id}
                      phx-value-status={s}
                      class={[
                        "px-2 py-1 rounded text-xs uppercase font-bold transition-smooth text-center",
                        @selected_task.status == s && "bg-emerald-600 text-white shadow-sm",
                        @selected_task.status != s &&
                          "bg-[#161b22] hover:bg-[#21262d] text-gray-400 hover:text-white"
                      ]}
                    >
                      {s}
                    </button>
                  <% end %>
                </div>
              </div>

              <!-- Effort Estimate Button -->
              <div class="pt-3 border-t border-[#21262d]">
                <div class="text-xs font-mono text-gray-400 uppercase tracking-wider mb-2">
                  Estimate
                </div>
                <%= if @selected_task.estimate do %>
                  <div class="p-2.5 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-sm text-amber-300">
                    {@selected_task.estimate}
                  </div>
                <% else %>
                  <button
                    phx-click="estimate_task"
                    phx-value-id={@selected_task.id}
                    class="w-full flex items-center justify-center gap-2 py-2 px-3 bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] rounded-xl text-sm font-mono text-gray-300 transition-smooth"
                  >
                    <.icon name="hero-calculator" class="w-3.5 h-3.5 text-amber-400" />
                    Estimate effort (makes model call)
                  </button>
                <% end %>
              </div>

              <!-- Latest Summary -->
              <%= if @selected_task.latest_summary do %>
                <div class="pt-3 border-t border-[#21262d]">
                  <div class="text-xs font-mono text-gray-400 uppercase tracking-wider mb-2">
                    Latest Summary
                  </div>
                  <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-sm text-gray-300">
                    {@selected_task.latest_summary}
                  </div>
                </div>
              <% end %>

              <!-- Quick Worker Actions & Delete -->
              <div class="pt-3 border-t border-[#21262d] flex flex-col gap-2">
                <div class="flex gap-2">
                  <button
                    phx-click="claim_task"
                    phx-value-id={@selected_task.id}
                    class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-sm font-mono font-medium transition-smooth"
                  >
                    Claim & Run Worker
                  </button>
                  <button
                    phx-click="move_task"
                    phx-value-id={@selected_task.id}
                    phx-value-status="done"
                    class="px-3 py-2 bg-[#21262d] hover:bg-gray-700 text-gray-300 rounded-xl text-sm font-mono transition-smooth"
                  >
                    Mark Done
                  </button>
                </div>
                <button
                  id={"delete-task-trigger-#{@selected_task.id}"}
                  type="button"
                  phx-click="request_delete_task"
                  phx-value-id={@selected_task.id}
                  class="sf-control min-h-11 w-full justify-center border-[var(--sf-live-mark)] text-[var(--sf-live-text)]"
                >
                  <.icon name="hero-trash" class="w-3.5 h-3.5" />
                  <span>Delete Task</span>
                </button>
              </div>
            </div>
          </aside>
          <% end %>
        <% end %>


      </div>

      <%!-- Shared command dock --%>
      <%= if @active_view not in ["kanban", "calendar", "swarm", "research", "changes", "chat", "files", "terminal"] do %>
        <.shared_command_dock workspace_assigns={assigns} />
      <% end %>
      <%!-- Shared composer component owns data-command-context, data-command-tools, id="toggle-run-setup", id="run-setup-tray", id="prompt-form", var(--sf-text-primary), var(--sf-text-secondary), var(--sf-live-mark), and var(--sf-hairline). --%>
    </main>
  </div>

  <%= if @pending_terminal_confirmation do %>
    <% pending_terminal = @pending_terminal_confirmation %>
    <% {host_id, title, copy} =
      case pending_terminal.kind do
        :clear_terminal_history ->
          {"terminal-clear-confirmation", "Clear terminal history?", "Clear terminal scrollback and command history? This cannot be undone."}

        :restart_terminal_session ->
          {"terminal-restart-confirmation", "Restart the PTY shell?", "Active and queued terminal work will stop."}

        :interrupt_terminal ->
          {"terminal-interrupt-confirmation", "Interrupt the foreground process?", "The PTY session will stay open."}
      end %>
    <div
      id={host_id}
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_terminal_confirmation"
      data-sheet-return-id={pending_terminal.return_id}
      data-sheet-background-id="workspace-shell"
      class="terminal-confirmation-overlay fixed inset-0 z-[70] flex items-end justify-center bg-[var(--sf-shadow)] p-4 sm:items-center"
    >
      <div
        id={"#{host_id}-dialog"}
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_terminal_confirmation"
        data-initial-focus="#cancel-terminal-confirmation"
        role="dialog"
        aria-modal="true"
        aria-labelledby="terminal-confirmation-title"
        tabindex="-1"
        class="sf-chassis w-full max-w-md p-6"
      >
        <p class="sf-metadata">Destructive terminal action</p>
        <h2 id="terminal-confirmation-title" class="mt-2 text-lg font-semibold text-[var(--sf-text-primary)]">
          {title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-[var(--sf-text-secondary)]">{copy}</p>
        <div class="mt-6 flex flex-wrap justify-end gap-3 pb-[env(safe-area-inset-bottom)]">
          <button id="cancel-terminal-confirmation" type="button" phx-click="cancel_terminal_confirmation" class="sf-control min-h-11 px-4 text-sm">Cancel</button>
          <button id="confirm-terminal-confirmation" type="button" phx-click="confirm_terminal_action" phx-disable-with="Confirming…" class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]">Confirm</button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @pending_file_confirmation do %>
    <% pending_file = @pending_file_confirmation %>
    <div
      id="file-buffer-revert-confirmation"
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_file_confirmation"
      data-sheet-return-id={pending_file.return_id}
      data-sheet-background-id="workspace-shell"
      class="file-confirmation-overlay fixed inset-0 z-[70] flex items-end justify-center bg-[var(--sf-shadow)] sm:items-center"
    >
      <div
        id="file-buffer-revert-confirmation-dialog"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_file_confirmation"
        data-initial-focus="#cancel-file-confirmation"
        role="dialog"
        aria-modal="true"
        aria-labelledby="file-buffer-confirmation-title"
        tabindex="-1"
        class="file-confirmation-dialog sf-chassis sf-sheet-scroll w-full max-w-md p-6"
      >
        <p class="sf-metadata">Destructive buffer action</p>
        <h2 id="file-buffer-confirmation-title" class="mt-2 text-lg font-semibold text-[var(--sf-text-primary)]">
          {if(pending_file.kind == :close, do: "Close unsaved buffer?", else: "Revert unsaved changes?")}
        </h2>
        <p class="mt-2 text-sm leading-6 text-[var(--sf-text-secondary)]">
          Your current unsaved editor text will be discarded. The file on disk is not changed.
        </p>
        <div class="mt-6 flex flex-wrap justify-end gap-3 pb-[env(safe-area-inset-bottom)]">
          <button id="cancel-file-confirmation" type="button" phx-click="cancel_file_confirmation" class="sf-control min-h-11 px-4 text-sm">Cancel</button>
          <button
            id="confirm-file-confirmation"
            type="button"
            phx-click={if(pending_file.kind == :close, do: "close_file_buffer", else: "revert_file_buffer")}
            class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]"
          >
            {if(pending_file.kind == :close, do: "Close buffer", else: "Revert changes")}
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @pending_git_confirmation do %>
    <% pending_git = @pending_git_confirmation
    {host_id, title, action, hunk_id} = git_confirmation_host(pending_git) %>
    <div
      id={host_id}
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_git_confirmation"
      data-sheet-return-id={git_confirmation_return_id(pending_git)}
      data-sheet-background-id="workspace-shell"
      class="git-confirmation-overlay fixed inset-0 z-[70] flex items-end justify-center bg-[var(--sf-shadow)] sm:items-center"
    >
      <div
        id={"#{host_id}-dialog"}
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_git_confirmation"
        data-initial-focus="#cancel-git-confirmation"
        role="dialog"
        aria-modal="true"
        aria-labelledby="git-confirmation-title"
        tabindex="-1"
        class="git-confirmation-dialog sf-chassis sf-sheet-scroll w-full max-w-md p-6"
      >
        <p class="sf-metadata">Destructive Git action</p>
        <h2 id="git-confirmation-title" class="mt-2 text-lg font-semibold text-[var(--sf-text-primary)]">
          {title}
        </h2>
        <p class="mt-2 text-sm leading-6 text-[var(--sf-text-secondary)]">
          {git_confirmation_copy(pending_git)} This action cannot be undone.
        </p>
        <p :if={hunk_id} class="mt-3 font-mono text-xs text-[var(--sf-text-secondary)]">
          Authorized hunk {hunk_id}
        </p>
        <div class="mt-6 flex flex-wrap justify-end gap-3 pb-[env(safe-area-inset-bottom)]">
          <button
            id="cancel-git-confirmation"
            type="button"
            phx-click="cancel_git_confirmation"
            class="sf-control min-h-11 px-4 text-sm"
          >Cancel</button>
          <button
            id="confirm-git-confirmation"
            type="button"
            phx-click={
              JS.set_attribute(
                {"data-sheet-return-id", git_confirmation_success_return_id(pending_git)},
                to: "##{host_id}"
              )
              |> JS.push(action)
            }
            phx-disable-with="Confirming…"
            class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]"
          >Confirm destructive action</button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @pending_calendar_task_delete do %>
    <% pending_calendar_delete = @pending_calendar_task_delete %>
    <div
      id={"calendar-delete-confirmation-#{pending_calendar_delete.task_id}"}
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_calendar_task_delete"
      data-sheet-return-id={pending_calendar_delete.return_id}
      data-sheet-background-id={pending_calendar_delete.background_id}
      class="calendar-confirmation-overlay fixed inset-0 z-[70] flex items-end justify-center bg-[var(--sf-shadow)] p-4 sm:items-center"
    >
      <div
        id={"calendar-delete-confirmation-dialog-#{pending_calendar_delete.task_id}"}
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_calendar_task_delete"
        data-initial-focus="#cancel-calendar-task-delete"
        role="dialog"
        aria-modal="true"
        aria-labelledby="calendar-delete-confirmation-title"
        tabindex="-1"
        class="calendar-confirmation-dialog sf-chassis sf-sheet-scroll w-full max-w-md p-6"
      >
        <p class="sf-metadata">Destructive schedule action</p>
        <h2
          id="calendar-delete-confirmation-title"
          class="mt-2 text-lg font-semibold text-[var(--sf-text-primary)]"
        >
          Delete scheduled task?
        </h2>
        <p class="mt-2 min-w-0 [overflow-wrap:anywhere] text-sm leading-6 text-[var(--sf-text-secondary)]">
          This permanently removes
          <strong class="min-w-0 [overflow-wrap:anywhere] text-[var(--sf-text-primary)]">{pending_calendar_delete.title}</strong>
          and its future schedule. This action cannot be undone.
        </p>
        <div class="mt-6 flex justify-end gap-3 pb-[env(safe-area-inset-bottom)]">
          <button
            id="cancel-calendar-task-delete"
            type="button"
            phx-click="cancel_calendar_task_delete"
            class="sf-control min-h-11 px-4 text-sm"
          >
            Cancel
          </button>
          <button
            id="confirm-calendar-task-delete"
            type="button"
            phx-click="confirm_calendar_task_delete"
            phx-disable-with="Deleting…"
            class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]"
          >
            Delete task
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if match?({:task, _}, @pending_task_confirmation) do %>
    <% {:task, pending_task} = @pending_task_confirmation %>
    <div
      id={"task-delete-confirmation-#{pending_task.id}"}
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_task_delete"
      data-sheet-return-id={"delete-task-trigger-#{pending_task.id}"}
      data-sheet-background-id="workspace-shell"
      class="kanban-confirmation-overlay fixed inset-0 z-50 flex items-end justify-center bg-[var(--sf-shadow)] sm:items-center"
    >
      <div
        id={"task-delete-confirmation-dialog-#{pending_task.id}"}
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_task_delete"
        data-initial-focus="#cancel-task-delete"
        role="dialog"
        aria-modal="true"
        aria-labelledby="task-delete-confirmation-title"
        tabindex="-1"
        class="kanban-confirmation-dialog sf-chassis w-full max-w-md p-6"
      >
        <h2 id="task-delete-confirmation-title" class="text-lg font-semibold text-[var(--sf-text-primary)]">
          Delete task?
        </h2>
        <p class="mt-2 text-sm text-[var(--sf-text-secondary)]">
          This permanently removes <strong>{pending_task.title}</strong> and its subtasks.
        </p>
        <div class="mt-6 flex justify-end gap-3">
          <button id="cancel-task-delete" type="button" phx-click="cancel_task_delete" class="sf-control min-h-11 px-4 text-sm">Cancel</button>
          <button
            id="confirm-task-delete"
            type="button"
            phx-click={
              JS.set_attribute(
                {"data-sheet-return-id", "kanban-channel-trigger-#{pending_task.status}"},
                to: "#task-delete-confirmation-#{pending_task.id}"
              )
              |> JS.push("confirm_task_delete")
            }
            class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]"
          >
            Delete task
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if match?({:subtask, _, _}, @pending_task_confirmation) do %>
    <% {:subtask, _pending_subtask_task, pending_subtask_id} = @pending_task_confirmation %>
    <div
      id={"subtask-delete-confirmation-#{pending_subtask_id}"}
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_subtask_delete"
      data-sheet-return-id={"delete-subtask-trigger-#{pending_subtask_id}"}
      data-sheet-background-id="workspace-shell"
      class="kanban-confirmation-overlay fixed inset-0 z-50 flex items-end justify-center bg-[var(--sf-shadow)] sm:items-center"
    >
      <div
        id={"subtask-delete-confirmation-dialog-#{pending_subtask_id}"}
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_subtask_delete"
        data-initial-focus="#cancel-subtask-delete"
        role="dialog"
        aria-modal="true"
        aria-labelledby="subtask-delete-confirmation-title"
        tabindex="-1"
        class="kanban-confirmation-dialog sf-chassis w-full max-w-md p-6"
      >
        <h2 id="subtask-delete-confirmation-title" class="text-lg font-semibold text-[var(--sf-text-primary)]">
          Delete subtask?
        </h2>
        <p class="mt-2 text-sm text-[var(--sf-text-secondary)]">This removes the selected checklist item.</p>
        <div class="mt-6 flex justify-end gap-3">
          <button id="cancel-subtask-delete" type="button" phx-click="cancel_subtask_delete" class="sf-control min-h-11 px-4 text-sm">Cancel</button>
          <button
            id="confirm-subtask-delete"
            type="button"
            phx-click={
              JS.set_attribute(
                {"data-sheet-return-id", "task-detail-title"},
                to: "#subtask-delete-confirmation-#{pending_subtask_id}"
              )
              |> JS.push("confirm_subtask_delete")
            }
            class="sf-control min-h-11 border-[var(--sf-live-mark)] px-4 text-sm text-[var(--sf-live-text)]"
          >
            Delete subtask
          </button>
        </div>
      </div>
    </div>
  <% end %>



  <!-- Autonomous Goal Creation Modal -->
  <%= if @show_goal_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4">
      <div
        id="goal-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_goal_modal"
        data-initial-focus="input[name='goal[title]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="goal-modal-title"
        tabindex="-1"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-lg p-6 shadow-2xl font-sans text-xs space-y-4 animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center text-white font-bold text-xs shadow-md">
              <.icon name="hero-flag" class="w-4 h-4 text-white" />
            </div>
            <div>
              <h3 id="goal-modal-title" class="text-sm font-bold text-white tracking-tight">
                Create Autonomous Goal
              </h3>
              <p class="text-[11px] font-mono text-gray-400">
                Create a durable multi-agent goal lifecycle
              </p>
            </div>
          </div>
          <button
            id="goal-modal-close"
            type="button"
            phx-click="close_goal_modal"
            aria-label="Close goal modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <.form
          for={@goal_form}
          id="goal-create-form"
          phx-submit="create_goal"
          class="space-y-3 font-mono text-xs"
        >
          <input
            id="goal-request-id"
            type="hidden"
            name="goal[request_id]"
            value={@goal_form[:request_id].value}
          />
          <div>
            <label for="goal-title-input" class="block text-gray-400 mb-1 font-semibold">
              Goal Objective / Title
            </label>
            <input
              id="goal-title-input"
              type="text"
              name="goal[title]"
              placeholder="e.g. Implement payment webhook reconcile engine"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-amber-500"
              required
            />
          </div>
          <div>
            <label for="goal-description-input" class="block text-gray-400 mb-1 font-semibold">
              Detailed Instructions (Optional)
            </label>
            <textarea
              id="goal-description-input"
              name="goal[description]"
              rows="3"
              placeholder="Add constraints, target files, or acceptance criteria..."
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-sans text-xs focus:outline-none focus:border-amber-500 resize-none"
            ></textarea>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <input type="hidden" name="goal[auto_start]" value="false" />
            <input
              type="checkbox"
              name="goal[auto_start]"
              value="true"
              checked={@goal_form[:auto_start].value in [true, "true", "on", "1", 1]}
              id="goal-auto-start"
              class="rounded bg-[#0d1117] border-[#30363d] text-amber-500 focus:ring-0"
            />
            <label for="goal-auto-start" class="text-gray-300 text-xs">
              Queue for execution now (uncheck to save a durable draft)
            </label>
          </div>
          <section
            id="goal-run-policy-summary"
            aria-labelledby="goal-run-policy-title"
            class="border border-[#30363d] bg-[#0d1117] px-3 py-2.5"
          >
            <div class="flex items-center justify-between gap-3">
              <h4
                id="goal-run-policy-title"
                class="text-[10px] font-semibold uppercase tracking-[0.14em] text-gray-300"
              >
                Inherited run policy
              </h4>
              <span class="text-[9px] text-gray-600">From Run setup</span>
            </div>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Priority</dt>
                <dd id="goal-policy-priority" class="mt-0.5 text-[11px] text-gray-300">
                  {String.capitalize(@run_setup_priority)}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">
                  Manual retry ceiling
                </dt>
                <dd id="goal-policy-max-attempts" class="mt-0.5 text-[11px] text-gray-300">
                  {@run_setup_max_attempts}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Time budget</dt>
                <dd id="goal-policy-time-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {if(@run_setup_time_budget_minutes,
                    do: "#{@run_setup_time_budget_minutes} min",
                    else: "Not capped"
                  )}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Token budget</dt>
                <dd id="goal-policy-token-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {if(@run_setup_token_budget,
                    do: to_string(@run_setup_token_budget),
                    else: "Not capped"
                  )}
                </dd>
              </div>
              <div>
                <dt class="text-[9px] uppercase tracking-wider text-gray-600">Cost budget</dt>
                <dd id="goal-policy-cost-budget" class="mt-0.5 text-[11px] text-gray-300">
                  {goal_cost_budget_label(@run_setup_cost_budget_cents)}
                </dd>
              </div>
            </dl>
          </section>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              id="goal-modal-cancel"
              type="button"
              phx-click="close_goal_modal"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
            >
              Cancel
            </button>
            <button
              id="goal-modal-submit"
              type="submit"
              phx-disable-with="Creating…"
              class="px-5 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold rounded-xl shadow-md disabled:cursor-wait disabled:opacity-60"
            >
              Create Goal
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <!-- Cancel Session Modal (Rollback vs Commit) -->
  <%= if @show_cancel_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4">
      <div
        id="cancel-session-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_cancel_modal"
        data-initial-focus="button[aria-label='Close cancel session modal']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cancel-session-modal-title"
        tabindex="-1"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-md p-6 shadow-2xl font-sans text-xs space-y-4 animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-2.5 text-rose-400 font-bold">
            <.icon name="hero-stop-circle" class="w-5 h-5 text-rose-400" />
            <h3 id="cancel-session-modal-title" class="text-sm font-bold text-white">
              Stop & Cancel Session
            </h3>
          </div>
          <button
            phx-click="close_cancel_modal"
            aria-label="Close cancel session modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <p class="text-gray-300 text-xs leading-relaxed font-sans">
          How would you like to handle any uncommitted MultiPatch changes in this session?
        </p>

        <div class="space-y-2 font-mono text-xs">
          <button
            type="button"
            phx-click="cancel_session"
            phx-value-mode="rollback"
            class="w-full p-3 rounded-2xl bg-[#161b22] hover:bg-[#1f242c] border border-rose-500/30 text-left transition-smooth group"
          >
            <div class="font-bold text-rose-300 flex items-center gap-2 mb-1">
              <.icon name="hero-arrow-uturn-left" class="w-4 h-4 text-rose-400" />
              <span>Rollback Snapshots</span>
            </div>
            <p class="text-[11px] text-gray-400 font-sans">
              Reverts all applied patches back to the clean pre-session snapshot state.
            </p>
          </button>

          <button
            type="button"
            phx-click="cancel_session"
            phx-value-mode="commit"
            class="w-full p-3 rounded-2xl bg-[#161b22] hover:bg-[#1f242c] border border-emerald-500/30 text-left transition-smooth group"
          >
            <div class="font-bold text-emerald-300 flex items-center gap-2 mb-1">
              <.icon name="hero-check-badge" class="w-4 h-4 text-emerald-400" />
              <span>Commit Changes</span>
            </div>
            <p class="text-[11px] text-gray-400 font-sans">
              Stages and commits all generated files to git with a cancellation record.
            </p>
          </button>
        </div>

        <div class="flex justify-end pt-2 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="close_cancel_modal"
            class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
          >
            Keep Session Running
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Expanded Message Modal -->
  <%= if @expanded_message_id do %>
    <% expanded_msg = @expanded_message %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-[var(--sf-shadow)] backdrop-blur-md p-6">
      <div
        id="expanded-message-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_expand_message"
        data-initial-focus="#copy-expanded-msg-btn"
        role="dialog"
        aria-modal="true"
        aria-labelledby="expanded-message-modal-title"
        tabindex="-1"
        class="sf-chassis w-full max-w-3xl max-h-[85vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95"
      >
        <div class="flex items-center justify-between border-b border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] p-4">
          <div class="flex items-center gap-2">
            <.icon name="hero-chat-bubble-bottom-center-text" class="h-4 w-4 text-[var(--sf-live-text)]" />
            <span
              id="expanded-message-modal-title"
              class="font-mono text-xs font-bold uppercase text-[var(--sf-text-primary)]"
            >
              {if expanded_msg,
                do: expanded_msg.agent_name || expanded_msg.role,
                else: "Message Inspector"}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <%= if expanded_msg do %>
              <button
                id="copy-expanded-msg-btn"
                type="button"
                phx-hook="CodeCopy"
                phx-update="ignore"
                data-code={expanded_msg.content}
                class="sf-control flex min-h-11 items-center gap-1.5 px-2.5 font-mono text-xs"
              >
                <.icon name="hero-clipboard-document" class="w-3.5 h-3.5" />
                <span>Copy</span>
              </button>
            <% end %>
            <button
              type="button"
              phx-click="close_expand_message"
              aria-label="Close message inspector"
              class="sf-control min-h-11 min-w-11 justify-center p-2 text-[var(--sf-text-secondary)]"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>
        </div>
        <div id="expanded-message-body" class="sf-chat-prose sf-sheet-scroll flex-1 p-6">
          <%= if expanded_msg do %>
            <.markdown_content
              content={expanded_msg.content}
              namespace={"expanded-message-#{expanded_msg.id}"}
            />
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- New Project / Workspace Modal -->
  <%= if @show_project_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm">
      <div
        id="project-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_project_modal"
        data-initial-focus="input[name='project[path]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="project-modal-title"
        tabindex="-1"
        class="bg-[#161b22] border border-[#30363d] rounded-2xl w-full max-w-md p-6 shadow-2xl font-mono text-xs"
      >
        <div class="flex items-center justify-between mb-4 border-b border-[#21262d] pb-3">
          <h3 id="project-modal-title" class="text-sm font-bold text-white">
            Open Workspace Folder
          </h3>
          <button
            id="close-project-modal-btn"
            phx-click="toggle_project_modal"
            aria-label="Close workspace modal"
            class="text-gray-400 hover:text-white"
          >✕</button>
        </div>
        <.form
          for={@project_form}
          id="project-open-form"
          phx-submit="open_project"
          class="space-y-4"
        >
          <div>
            <label for="project-path-input" class="block text-gray-400 mb-1">Folder Path</label>
            <input
              id="project-path-input"
              type="text"
              name="project[path]"
              placeholder="/Users/.../my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
              required
            />
          </div>
          <div>
            <label for="project-name-input" class="block text-gray-400 mb-1">
              Project Name (Optional)
            </label>
            <input
              id="project-name-input"
              type="text"
              name="project[name]"
              placeholder="my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
            />
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_project_modal"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-lg"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Opening..."
              class="px-4 py-2 bg-emerald-600 text-white rounded-lg font-bold"
            >Open</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Scheduled Task Details Modal --%>
  <%= if @show_scheduled_task_modal && @selected_scheduled_task do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[var(--sf-shadow)] p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="scheduled-task-detail-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_scheduled_task_modal"
        data-initial-focus="button[aria-label='Close scheduled task details']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="scheduled-task-detail-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] p-4 font-sans space-y-5 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <%!-- Modal Header --%>
        <div class="flex items-start justify-between pb-3 border-b border-[var(--sf-hairline)]">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-[var(--sf-raised-control)] border border-[var(--sf-hairline)] flex items-center justify-center text-[var(--sf-text-primary)] shadow-none shrink-0">
              <.icon name="hero-calendar" class="w-5 h-5 text-[var(--sf-text-primary)]" />
            </div>
            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-sm font-mono uppercase tracking-wider px-2 py-0.5 rounded-md bg-[var(--sf-raised-control)] border border-[var(--sf-hairline)] text-[var(--sf-text-primary)] font-semibold">
                  ● {@selected_scheduled_task.status}
                </span>
                <span class="rounded-md border border-[var(--sf-hairline)] bg-[var(--sf-raised-control)] px-2 py-0.5 font-mono text-sm font-semibold uppercase tracking-wider text-[var(--sf-text-secondary)]">
                  {String.capitalize(@selected_scheduled_task.priority || "medium")} Priority
                </span>
              </div>
              <h3
                id="scheduled-task-detail-modal-title"
                class="text-base font-bold text-[var(--sf-text-primary)] tracking-tight"
              >
                {@selected_scheduled_task.title}
              </h3>
            </div>
          </div>
          <button
            phx-click="close_scheduled_task_modal"
            aria-label="Close scheduled task details"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-[var(--sf-text-secondary)] transition-smooth hover:bg-[var(--sf-raised-control)] hover:text-[var(--sf-text-primary)]"
            title="Close"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>

        <%!-- Meta Grid --%>
        <div class="grid grid-cols-2 gap-3 font-mono text-sm">
          <div class="p-3 bg-[var(--sf-instrument)] border border-[var(--sf-hairline)] rounded-2xl">
            <div class="text-sm text-[var(--sf-text-secondary)] uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-clock" class="w-3.5 h-3.5 text-[var(--sf-text-secondary)]" /> Scheduled Timing
            </div>
            <div class="text-[var(--sf-text-primary)] font-medium">
              <%= if @selected_scheduled_task.scheduled_at do %>
                {Calendar.strftime(@selected_scheduled_task.scheduled_at, "%b %d, %Y · %I:%M %p")}
              <% else %>
                <%= if @selected_scheduled_task.cron_expression do %>
                  Recurring: {@selected_scheduled_task.cron_expression}
                <% else %>
                  Immediate / On-demand
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="p-3 bg-[var(--sf-instrument)] border border-[var(--sf-hairline)] rounded-2xl">
            <div class="text-sm text-[var(--sf-text-secondary)] uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-user-circle" class="w-3.5 h-3.5 text-[var(--sf-text-secondary)]" />
              Assignee & Worker
            </div>
            <div class="text-[var(--sf-text-primary)] font-medium flex items-center gap-1.5">
              <span>{@selected_scheduled_task.assignee}</span>
              <%= if @selected_scheduled_task.worker_pid do %>
                <span class="text-sm text-[var(--sf-text-secondary)] font-mono">PID: {@selected_scheduled_task.worker_pid}</span>
              <% end %>
            </div>
          </div>
        </div>

        <%!-- Description Box --%>
        <div class="space-y-1.5 font-sans">
          <div class="text-sm font-mono text-[var(--sf-text-secondary)] uppercase tracking-wider">
            Task Instructions & Requirements
          </div>
          <div class="p-3.5 bg-[var(--sf-canvas-deep)] border border-[var(--sf-hairline)] rounded-2xl text-sm leading-relaxed text-[var(--sf-text-primary)] font-sans whitespace-pre-wrap">
            {@selected_scheduled_task.description || "No specific instructions provided."}
          </div>
        </div>

        <%!-- Execution Progress & Latest Telemetry --%>
        <%= if @selected_scheduled_task.latest_summary do %>
          <div class="p-3 bg-[var(--sf-instrument)] border border-[var(--sf-hairline)] rounded-2xl text-sm font-mono">
            <div class="text-sm text-[var(--sf-text-secondary)] uppercase tracking-wider mb-1">
              Latest Execution Telemetry
            </div>
            <div class="text-[var(--sf-text-secondary)]">
              {@selected_scheduled_task.latest_summary}
            </div>
          </div>
        <% end %>

        <%!-- Modal Actions --%>
        <div class="flex items-center justify-between pt-3 border-t border-[var(--sf-hairline)]">
          <button
            id={"calendar-detail-delete-trigger-#{@selected_scheduled_task.id}"}
            type="button"
            phx-click="request_calendar_task_delete"
            phx-value-id={@selected_scheduled_task.id}
            phx-value-source="detail"
            phx-disable-with="Opening…"
            class="flex min-h-11 items-center gap-1.5 rounded-xl border border-[var(--sf-live-mark)] bg-transparent px-3.5 py-2 font-mono text-sm text-[var(--sf-live-text)] transition-smooth hover:bg-[var(--sf-raised-control)]"
          >
            <.icon name="hero-trash" class="w-3.5 h-3.5" />
            <span>Delete Task</span>
          </button>

          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="open_edit_scheduled_task"
              phx-value-id={@selected_scheduled_task.id}
              phx-disable-with="Opening…"
              class="min-h-11 px-3.5 py-2 bg-[var(--sf-raised-control)] hover:bg-[var(--sf-raised-control)] text-[var(--sf-text-primary)] rounded-xl text-sm font-mono border border-[var(--sf-hairline)] transition-smooth flex items-center gap-1.5"
            >
              <.icon name="hero-pencil-square" class="w-3.5 h-3.5" />
              <span>Edit Task</span>
            </button>
            <button
              type="button"
              phx-click="run_scheduled_task"
              phx-value-id={@selected_scheduled_task.id}
              phx-disable-with="Running…"
              class="sf-control min-h-11 px-4 py-2 text-sm font-semibold"
            >
              <.icon name="hero-play" class="w-3.5 h-3.5" />
              <span>Run Now</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Edit Scheduled Task Modal -->
  <%= if @show_edit_scheduled_task_modal && @selected_scheduled_task do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[var(--sf-shadow)] p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="edit-scheduled-task-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_edit_scheduled_task"
        data-initial-focus="input[name='task[title]']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-scheduled-task-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[var(--sf-hairline)] bg-[var(--sf-instrument-raised)] p-4 font-mono text-sm space-y-4 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <div class="flex items-center justify-between pb-3 border-b border-[var(--sf-hairline)]">
          <h3
            id="edit-scheduled-task-modal-title"
            class="text-sm font-bold text-[var(--sf-text-primary)] flex items-center gap-2"
          >
            <.icon name="hero-pencil-square" class="w-4 h-4 text-[var(--sf-text-primary)]" /> Edit Scheduled Task
          </h3>
          <button
            phx-click="close_edit_scheduled_task"
            aria-label="Close edit scheduled task modal"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-[var(--sf-text-secondary)] hover:text-[var(--sf-text-primary)]"
          ><.icon name="hero-x-mark" class="size-4" /></button>
        </div>

        <.form
          for={@scheduled_task_form}
          id="edit-scheduled-task-form"
          phx-submit="update_scheduled_task"
          class="space-y-3 font-mono text-sm"
        >
          <.input field={@scheduled_task_form[:id]} type="hidden" />
          <.input
            field={@scheduled_task_form[:title]}
            id="edit-scheduled-task-title"
            type="text"
            label="Title"
            required
            class="min-h-11 w-full rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 font-sans text-sm text-[var(--sf-text-primary)] focus:border-[var(--sf-focus-ring)] focus:outline-none"
          />
          <.input
            field={@scheduled_task_form[:description]}
            id="edit-scheduled-task-description"
            type="textarea"
            label="Description / Instructions"
            rows="2"
            class="min-h-20 w-full resize-y rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 font-sans text-sm text-[var(--sf-text-primary)] focus:border-[var(--sf-focus-ring)] focus:outline-none"
          />
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <.input
              field={@scheduled_task_form[:priority]}
              id="edit-scheduled-task-priority"
              type="select"
              label="Priority"
              options={Enum.map(["low", "medium", "high", "critical"], &{String.capitalize(&1), &1})}
              class="min-h-11 w-full rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 text-sm text-[var(--sf-text-primary)]"
            />
            <.input
              field={@scheduled_task_form[:assignee]}
              id="edit-scheduled-task-assignee"
              type="select"
              label="Assignee"
              options={["default", "planner", "coder", "verifier"]}
              class="min-h-11 w-full rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 text-sm text-[var(--sf-text-primary)]"
            />
          </div>
          <.input
            field={@scheduled_task_form[:cron_expression]}
            id="edit-scheduled-task-cron"
            type="text"
            label="Cron Expression (Optional)"
            placeholder="e.g. 0 0 * * *"
            class="min-h-11 w-full rounded-xl border border-[var(--sf-hairline)] bg-[var(--sf-canvas-deep)] px-3 py-2 font-mono text-sm text-[var(--sf-text-primary)]"
          />
          <div class="flex justify-end gap-2 pt-3 border-t border-[var(--sf-hairline)]">
            <button
              type="button"
              phx-click="close_edit_scheduled_task"
              class="sf-control min-h-11 px-4 text-sm"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Saving…"
              class="sf-control min-h-11 px-5 font-bold"
            >Save changes</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Create Agent Task Modal --%>
  <%= if @show_new_task_modal do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        id="new-task-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="toggle_new_task_modal"
        data-initial-focus="input[name='title']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="new-task-modal-title"
        tabindex="-1"
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-lg overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 font-mono text-xs shadow-2xl animate-in zoom-in-95 duration-150 space-y-4 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
      >
        <%!-- Modal Header --%>
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <h3
            id="new-task-modal-title"
            class="text-sm font-bold text-white flex items-center gap-2"
          >
            <.icon name="hero-plus-circle" class="w-4 h-4 text-orange-400" /> Create Agent Task
          </h3>
          <button
            phx-click="toggle_new_task_modal"
            aria-label="Close create task modal"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-gray-400 hover:bg-[#1c2128] hover:text-white"
          ><.icon name="hero-x-mark" class="size-4" /></button>
        </div>

        <.form for={@task_form} id="task-create-form" phx-submit="create_task" class="space-y-4">
          <!-- Task Title -->
          <div>
            <label
              for="new-task-title-input"
              class="block text-gray-400 mb-1.5 font-semibold text-[11px]"
            >
              Task Title
            </label>
            <input
              id="new-task-title-input"
              type="text"
              name="title"
              placeholder="e.g. Reconcile payment webhook states"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              required
            />
          </div>

          <!-- Description -->
          <div>
            <label
              for="new-task-description-input"
              class="block text-gray-400 mb-1.5 font-semibold text-[11px]"
            >
              Description
            </label>
            <textarea
              id="new-task-description-input"
              name="description"
              rows="2"
              placeholder="Task requirements or prompt instructions..."
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a] resize-none"
            ></textarea>
          </div>

          <%!-- Status & Priority Row --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Status Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_status" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Status</label>
              <button
                type="button"
                id="modal-status-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_status"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_status"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_status",
                    do: "modal-status-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_status == "scheduled" &&
                      "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]",
                    @new_task_status == "ready" &&
                      "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]",
                    @new_task_status == "triage" && "bg-gray-400",
                    @new_task_status == "todo" && "bg-blue-400",
                    @new_task_status == "running" &&
                      "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"
                  ]}></span>
                  <span class="capitalize font-medium truncate">
                    {case @new_task_status do
                      "ready" -> "Ready (Agent Claimable)"
                      s -> String.capitalize(s)
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="status" value={@new_task_status} class="hidden" />

              <%= if @open_modal_dropdown == "modal_status" do %>
                <div
                  id="modal-status-dropdown-menu"
                  role="listbox"
                  aria-label="Task status"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {s_val, s_label, dot_class} <- [
                    {"scheduled", "Scheduled", "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]"},
                    {"ready", "Ready (Agent Claimable)", "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"},
                    {"triage", "Triage", "bg-purple-400"},
                    {"todo", "Todo", "bg-blue-400"},
                    {"running", "Running", "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_status == s_val}
                      phx-click="select_modal_status"
                      phx-value-status={s_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_status == s_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_status != s_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{s_label}</span>
                      </div>
                      <%= if @new_task_status == s_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%!-- Priority Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_priority" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Priority</label>
              <button
                type="button"
                id="modal-priority-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_priority"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_priority"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_priority",
                    do: "modal-priority-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_priority == "critical" &&
                      "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]",
                    @new_task_priority == "high" &&
                      "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]",
                    @new_task_priority == "medium" && "bg-blue-400",
                    @new_task_priority == "low" && "bg-gray-400"
                  ]}></span>
                  <span class="capitalize font-medium truncate">{String.capitalize(
                    @new_task_priority
                  )}</span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="priority" value={@new_task_priority} class="hidden" />

              <%= if @open_modal_dropdown == "modal_priority" do %>
                <div
                  id="modal-priority-dropdown-menu"
                  role="listbox"
                  aria-label="Task priority"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {p_val, p_label, dot_class} <- [
                    {"critical", "Critical", "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]"},
                    {"high", "High", "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]"},
                    {"medium", "Medium", "bg-blue-400"},
                    {"low", "Low", "bg-gray-400"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_priority == p_val}
                      phx-click="select_modal_priority"
                      phx-value-priority={p_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_priority == p_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_priority != p_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{p_label}</span>
                      </div>
                      <%= if @new_task_priority == p_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Assignee & Tag Row --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Assignee Custom Dropdown --%>
            <div
              class="relative"
              phx-click-away={@open_modal_dropdown == "modal_assignee" && "close_modal_dropdowns"}
            >
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Assignee</label>
              <button
                type="button"
                id="modal-assignee-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_assignee"
                aria-haspopup="listbox"
                aria-expanded={@open_modal_dropdown == "modal_assignee"}
                aria-controls={
                  if(@open_modal_dropdown == "modal_assignee",
                    do: "modal-assignee-dropdown-menu",
                    else: nil
                  )
                }
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <.icon
                    name={
                      case @new_task_assignee do
                        "planner" -> "hero-sparkles"
                        "coder" -> "hero-code-bracket"
                        "verifier" -> "hero-check-badge"
                        _ -> "hero-user-circle"
                      end
                    }
                    class={[
                      "w-3.5 h-3.5 shrink-0",
                      @new_task_assignee == "planner" && "text-amber-400",
                      @new_task_assignee == "coder" && "text-cyan-400",
                      @new_task_assignee == "verifier" && "text-emerald-400",
                      @new_task_assignee == "default" && "text-purple-400"
                    ]}
                  />
                  <span class="font-medium truncate">
                    {case @new_task_assignee do
                      "planner" -> "PlannerAgent"
                      "coder" -> "CoderAgent"
                      "verifier" -> "VerifierAgent"
                      _ -> "Default Worker"
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="assignee" value={@new_task_assignee} class="hidden" />

              <%= if @open_modal_dropdown == "modal_assignee" do %>
                <div
                  id="modal-assignee-dropdown-menu"
                  role="listbox"
                  aria-label="Task assignee"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {a_val, a_label, icon_name, icon_color} <- [
                    {"default", "Default Worker", "hero-user-circle", "text-purple-400"},
                    {"planner", "PlannerAgent", "hero-sparkles", "text-amber-400"},
                    {"coder", "CoderAgent", "hero-code-bracket", "text-cyan-400"},
                    {"verifier", "VerifierAgent", "hero-check-badge", "text-emerald-400"}
                  ] do %>
                    <button
                      type="button"
                      role="option"
                      aria-selected={@new_task_assignee == a_val}
                      phx-click="select_modal_assignee"
                      phx-value-assignee={a_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_assignee == a_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_assignee != a_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <.icon name={icon_name} class={["w-3.5 h-3.5 shrink-0", icon_color]} />
                        <span class="truncate">{a_label}</span>
                      </div>
                      <%= if @new_task_assignee == a_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Tag</label>
              <input
                type="text"
                name="tag"
                placeholder="Bug, Feature, Core..."
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Custom Date & Time Schedule Picker Section --%>
          <div class="p-3.5 bg-[#161b22]/70 border border-[#21262d] rounded-2xl space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono font-semibold text-gray-300">
              <span class="flex items-center gap-1.5">
                <.icon name="hero-calendar" class="w-3.5 h-3.5 text-orange-400" />
                <span>Schedule & Execution Time</span>
              </span>
              <button
                type="button"
                phx-click="open_time_picker"
                phx-value-mode="datetime"
                class="text-blue-400 hover:text-blue-300 text-[10px] flex items-center gap-1 hover:underline cursor-pointer"
              >
                <.icon name="hero-clock" class="w-3 h-3" />
                <span>Change Time Slot</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <%!-- Custom Popover Date Picker --%>
              <div class="relative">
                <label class="block text-gray-400 mb-1 text-[10px]">Target Date</label>
                <button
                  type="button"
                  id="target-date-picker-trigger"
                  phx-click="toggle_date_picker_popover"
                  aria-haspopup="dialog"
                  aria-expanded={@show_date_picker_popover}
                  aria-label="Target date picker"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-white font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to open calendar date picker"
                >
                  <span class={
                    if @new_task_date != "", do: "text-white font-medium", else: "text-gray-500"
                  }>
                    {format_date_display(@new_task_date)}
                  </span>
                  <.icon name="hero-calendar" class="w-3.5 h-3.5 text-gray-400 hover:text-white" />
                </button>
                <input type="text" name="scheduled_at_date" value={@new_task_date} class="hidden" />

                <%!-- Popover Calendar Card --%>
                <%= if @show_date_picker_popover do %>
                  <div
                    id="custom-date-picker-popover"
                    class="absolute bottom-full left-0 mb-2 z-50 w-64 bg-[#22272e] border border-[#30363d] rounded-2xl p-3 shadow-2xl shadow-black/80 font-mono text-xs select-none animate-in fade-in zoom-in-95 duration-100"
                  >
                    <%!-- Header Row --%>
                    <div class="flex items-center justify-between mb-2.5 px-1">
                      <div class="flex items-center gap-1 text-white font-bold text-xs font-sans">
                        <span>{month_name(@picker_month)} {@picker_year}</span>
                        <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                      </div>
                      <div class="flex items-center gap-0.5">
                        <button
                          type="button"
                          phx-click="picker_prev_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Previous Month"
                        >
                          <.icon name="hero-arrow-up" class="w-3 h-3" />
                        </button>
                        <button
                          type="button"
                          phx-click="picker_next_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Next Month"
                        >
                          <.icon name="hero-arrow-down" class="w-3 h-3" />
                        </button>
                      </div>
                    </div>

                    <%!-- Weekday Row --%>
                    <div class="grid grid-cols-7 gap-0.5 mb-1 text-center">
                      <%= for d <- ["S", "M", "T", "W", "T", "F", "S"] do %>
                        <div class="text-[10px] font-sans font-semibold text-gray-400 py-0.5">
                          {d}
                        </div>
                      <% end %>
                    </div>

                    <%!-- 6-Week Monthly Grid --%>
                    <div class="grid grid-cols-7 gap-0.5 text-center">
                      <%= for cell <- calendar_grid_cells(@picker_year, @picker_month, @new_task_date) do %>
                        <button
                          type="button"
                          phx-click="picker_select_day"
                          phx-value-year={cell.year}
                          phx-value-month={cell.month}
                          phx-value-day={cell.day}
                          class={[
                            "h-6 w-6 mx-auto flex items-center justify-center rounded-lg text-[11px] font-sans transition-smooth cursor-pointer",
                            cell.is_selected && "bg-[#58a6ff] text-white font-bold shadow-sm",
                            cell.is_today && !cell.is_selected &&
                              "border border-gray-500 text-white font-semibold",
                            !cell.is_selected && !cell.is_today && cell.is_current_month &&
                              "text-gray-200 hover:bg-[#2d333b] hover:text-white",
                            !cell.is_selected && !cell.is_today && !cell.is_current_month &&
                              "text-gray-500 hover:text-gray-400"
                          ]}
                        >
                          {cell.day}
                        </button>
                      <% end %>
                    </div>

                    <%!-- Popover Footer --%>
                    <div class="flex items-center justify-between pt-2 mt-2 border-t border-[#30363d] px-1 text-xs">
                      <button
                        type="button"
                        phx-click="picker_clear"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Clear
                      </button>
                      <button
                        type="button"
                        phx-click="picker_today"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Today
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>

              <%!-- Time Slot --%>
              <div>
                <label class="block text-gray-400 mb-1 text-[10px]">Time Slot</label>
                <button
                  type="button"
                  id="target-time-slot-trigger"
                  phx-click="open_time_picker"
                  phx-value-mode="time"
                  aria-haspopup="dialog"
                  aria-label="Select target time slot"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-blue-300 font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to select time slot"
                >
                  <span class="truncate">{@selected_time_slot}</span>
                  <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400 shrink-0 ml-1" />
                </button>
                <input
                  type="text"
                  name="scheduled_at_time_slot"
                  value={@selected_time_slot}
                  class="hidden"
                />
              </div>
            </div>

            <div>
              <label class="block text-gray-400 mb-1 text-[10px]">Recurring Cron Expression (Optional)</label>
              <input
                type="text"
                name="cron_expression"
                placeholder="e.g. 0 0 * * * (Daily) or leave empty"
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-amber-300 font-mono text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Bottom Action Buttons --%>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_new_task_modal"
              class="min-h-11 px-4 py-2 bg-[#21262d] hover:bg-[#2c333d] text-gray-300 rounded-xl transition-smooth cursor-pointer"
            >Cancel</button>
            <button
              type="submit"
              phx-disable-with="Creating..."
              class="min-h-11 px-5 py-2 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-xl font-bold shadow-lg shadow-orange-500/25 transition-smooth cursor-pointer"
            >Create Task</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Set Focus Time / Time & Date Picker Modal --%>
  <%= if @show_time_picker do %>
    <div class="workspace-modal-backdrop fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-md animate-in fade-in duration-150 sm:p-4">
      <div
        class="workspace-modal-panel my-auto max-h-[calc(100dvh-1.5rem)] w-full max-w-md overflow-y-auto rounded-3xl border border-[#21262d] bg-[#11151c] p-4 shadow-2xl space-y-5 animate-in zoom-in-95 duration-150 sm:max-h-[calc(100dvh-2rem)] sm:p-6"
        id="time-picker-modal"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="close_time_picker"
        data-initial-focus="button[phx-click='select_schedule_status']"
        role="dialog"
        aria-modal="true"
        aria-labelledby="time-picker-modal-title"
        tabindex="-1"
      >
        <%!-- Modal Header --%>
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#1c2128] border border-[#30363d] flex items-center justify-center text-gray-300 shadow-inner shrink-0">
              <.icon name="hero-clock" class="w-5 h-5 text-blue-400" />
            </div>
            <div>
              <h3
                id="time-picker-modal-title"
                class="text-base font-bold text-white tracking-tight"
              >
                Set focus time & presence
              </h3>
              <p class="text-xs text-gray-400 font-sans">
                Choose when you don't want to be disturbed or set autonomous swarm mode
              </p>
            </div>
          </div>
          <button
            type="button"
            phx-click="close_time_picker"
            aria-label="Close time picker"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2 text-gray-400 transition-smooth hover:text-white"
            title="Close"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Select Status Section --%>
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select status</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Select your live presence & agent interaction mode"
            >ⓘ</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <%= for {status_label, dot_bg, desc} <- [
              {"Available", "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]", "Instant alerts"},
              {"Busy", "bg-red-400 shadow-[0_0_8px_rgba(239,68,68,0.8)]", "Deep focus mode"},
              {"In-meeting", "bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.8)]", "Batched summaries"},
              {"Offline", "bg-gray-400", "Scheduled cron only"}
            ] do %>
              <button
                type="button"
                phx-click="select_schedule_status"
                phx-value-status={status_label}
                aria-pressed={to_string(@selected_schedule_status == status_label)}
                class={[
                  "flex items-center gap-2.5 py-2.5 px-3 rounded-2xl text-xs font-medium border transition-smooth text-left cursor-pointer",
                  @selected_schedule_status == status_label &&
                    "bg-[#1c2128] border-gray-500 shadow-md text-white ring-1 ring-white/10",
                  @selected_schedule_status != status_label &&
                    "bg-[#0d1117] border-[#21262d] text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span class={["w-2 h-2 rounded-full shrink-0", dot_bg]}></span>
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-white tracking-tight leading-tight">
                    {status_label}
                  </div>
                  <div class="text-[10px] text-gray-500 font-mono truncate">{desc}</div>
                </div>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Select Time Section -->
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select time</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Pick an available focus window"
            >ⓘ</span>
          </div>

          <!-- Time Slots List -->
          <div class="space-y-1 max-h-56 overflow-y-auto pr-1">
            <%= for {start_t, end_t} <- [
              {"09:30 AM", "10:00 AM"},
              {"10:00 AM", "10:30 AM"},
              {"10:30 AM", "11:00 AM"},
              {"11:00 AM", "11:30 AM"},
              {"11:30 AM", "12:00 PM"},
              {"12:00 PM", "12:30 PM"},
              {"12:30 PM", "01:00 PM"},
              {"01:00 PM", "01:30 PM"},
              {"02:00 PM", "03:00 PM"}
            ] do %>
              <% slot_str = "#{start_t} - #{end_t}"
              is_selected = @selected_time_slot == slot_str %>
              <button
                type="button"
                phx-click="select_time_slot"
                phx-value-slot={slot_str}
                class={[
                  "w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-mono transition-smooth text-left",
                  is_selected &&
                    "bg-[#21262d] text-white font-semibold border border-white/10 shadow-sm",
                  !is_selected && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span>{start_t}</span>
                <%= if is_selected do %>
                  <div class="w-4 h-4 rounded-full bg-blue-500 flex items-center justify-center text-white text-[10px] shadow-sm">
                    <.icon name="hero-check" class="w-2.5 h-2.5" />
                  </div>
                <% else %>
                  <span class="w-4"></span>
                <% end %>
                <span>{end_t}</span>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Custom Time Input -->
        <%= if @show_custom_time_input do %>
          <.form
            for={@custom_time_form}
            id="custom-time-form"
            phx-change="update_custom_time"
            class="pt-2 border-t border-[#21262d] animate-in fade-in"
          >
            <label for="custom-time-input" class="block text-[11px] font-mono text-gray-400 mb-1">
              Enter Custom Time / Interval
            </label>
            <input
              id="custom-time-input"
              type="text"
              name="custom_time"
              value={@custom_time}
              placeholder="e.g. 03:15 PM - 04:00 PM"
              autocomplete="off"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-xs font-mono text-white focus:outline-hidden focus:border-blue-500"
            />
          </.form>
        <% end %>

        <!-- Footer Action Bar -->
        <div class="flex items-center justify-between pt-3 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="toggle_custom_time"
            class="text-xs text-gray-400 hover:text-white transition-smooth font-mono font-medium"
          >
            {if @show_custom_time_input, do: "Use presets", else: "Set custom time"}
          </button>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="close_time_picker"
              class="min-h-11 px-4 py-2 rounded-xl bg-[#1c2128] hover:bg-[#21262d] text-gray-300 text-xs font-mono font-medium transition-smooth"
            >
              Cancel
            </button>
            <button
              type="button"
              phx-click="apply_time_picker"
              class="min-h-11 px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-mono font-bold shadow-lg shadow-blue-500/25 transition-smooth"
            >
              Apply
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @pending_session_delete do %>
    <div
      id="delete-session-confirmation"
      phx-hook="ResponsiveSheet"
      role="presentation"
      data-sheet-close-event="cancel_session_delete"
      data-sheet-return-id="command-palette-trigger"
      data-sheet-background-id="workspace-shell"
      class={[
        "fixed inset-0 z-50 flex items-end justify-center bg-[var(--sf-shadow)] p-4 sm:items-center"
      ]}
    >
      <div
        id="delete-session-confirmation-dialog"
        phx-hook="ModalFocus"
        data-modal-focus
        data-cancel-event="cancel_session_delete"
        data-initial-focus="#cancel-session-delete"
        role="dialog"
        aria-modal="true"
        aria-labelledby="delete-session-confirmation-title"
        tabindex="-1"
        class={["sf-chassis w-full max-w-md p-6"]}
      >
        <h2
          id="delete-session-confirmation-title"
          class={["text-lg font-semibold text-[var(--sf-text-primary)]"]}
        >
          Delete session?
        </h2>
        <p class={["mt-2 text-sm text-[var(--sf-text-secondary)]"]}>
          This permanently removes
          <strong class={["text-[var(--sf-text-primary)]"]}>{@pending_session_delete.title}</strong>
          and its history.
        </p>
        <div class={["mt-6 flex justify-end gap-3"]}>
          <button
            id="cancel-session-delete"
            type="button"
            phx-click="cancel_session_delete"
            class={["sf-control min-h-11 px-4 text-sm"]}
          >
            Cancel
          </button>
          <button
            id="delete-session-confirm"
            type="button"
            phx-click="confirm_session_delete"
            class={[
              "sf-control min-h-11 border-[var(--sf-live-mark)] bg-transparent px-4 text-sm text-[var(--sf-live-text)]"
            ]}
          >
            Delete session
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <.command_palette
    show={@show_command_palette}
    query={@command_palette_query}
    search_form={@command_palette_form}
    category={@command_palette_category}
    results={@command_palette_results}
    selected_index={@command_palette_selected_index}
  />
</Layouts.app>
