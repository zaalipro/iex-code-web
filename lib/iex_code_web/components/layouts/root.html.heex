<!DOCTYPE html>
<html
  lang="en"
  {if(assigns[:theme_preference],
    do: %{
      "data-theme" => assigns[:theme_preference],
      "style" => "color-scheme: #{assigns[:theme_preference]};"
    },
    else: %{"style" => "color-scheme: light dark;"}
  )}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= case assigns[:theme_preference] do %>
      <% "dark" -> %>
        <meta name="theme-color" content="#171514" />
      <% "light" -> %>
        <meta name="theme-color" content="#EAE5DC" />
      <% nil -> %>
        <meta
          name="theme-color"
          content="#171514"
          media="(prefers-color-scheme: dark)"
        />
        <meta
          name="theme-color"
          content="#EAE5DC"
          media="(prefers-color-scheme: light)"
        />
    <% end %>
    <meta
      name="description"
      content="IexCode is a durable, self-hosted asynchronous coding harness."
    />
    <.live_title default="IexCode" suffix=" · Async coding harness" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div id="connection-status" role="status" aria-live="polite" hidden>
      Signal paused · reconnecting
    </div>
    {@inner_content}
  </body>
</html>
