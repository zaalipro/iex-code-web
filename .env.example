# Non-secret deployment example. Never commit a populated copy.
PHX_HOST=example.com
PHX_SCHEME=https
PHX_PORT=443
PUBLIC_PORT=443
IEX_CODE_DEFAULT_MODEL_PROVIDER=openai
IEX_CODE_DEFAULT_MODEL=deepseek-v4-pro

# Supply credentials interactively to install.sh or through a root-owned
# --env-file. The installer imports them once and does not retain this variable
# in the application environment.
OPENAI_BASE_URL=https://cli.llmotions.com/v1
OPENAI_API_KEY=replace-me
